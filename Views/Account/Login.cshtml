@model ManholeCatalog.Models.LoginViewModel

@{
    ViewData["Title"] = "تسجيل دخول الإدارة";
}

<div class="public-page admin-login-page">

    <section class="public-section admin-login-section">

        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-5 col-md-7">

                    <div class="admin-login-header">

                        <div class="admin-login-icon">
                            <i class="bi bi-shield-lock"></i>
                        </div>

                        <span class="public-page-label admin-login-label">
                            <i class="bi bi-person-badge"></i>
                            لوحة الإدارة
                        </span>

                        <h1 class="public-page-title admin-login-title">
                            تسجيل دخول الإدارة
                        </h1>

                        <p class="public-page-description admin-login-description">
                            سجّل الدخول للوصول إلى لوحة إدارة سما كتالوج.
                        </p>

                    </div>

                    <div class="public-card admin-login-card">

                        <div class="public-card-header">

                            <div class="public-card-header-content">

                                <div class="public-card-icon">
                                    <i class="bi bi-person-check"></i>
                                </div>

                                <div>
                                    <h2 class="h5 fw-bold mb-1">
                                        مرحبًا بك
                                    </h2>

                                    <p class="text-muted small mb-0">
                                        أدخل بيانات الدخول للمتابعة.
                                    </p>
                                </div>

                            </div>

                        </div>

                        <div class="public-card-body admin-login-card-body">

                            <form asp-controller="Account"
                                  asp-action="Login"
                                  method="post">

                                <input type="hidden"
                                       name="returnUrl"
                                       value="@ViewBag.ReturnUrl" />

                                <div asp-validation-summary="ModelOnly"
                                     class="admin-login-validation"
                                     role="alert">
                                </div>

                                <div class="mb-3">

                                    <label asp-for="Email"
                                           class="form-label public-form-label">
                                        البريد الإلكتروني
                                    </label>

                                    <div class="public-input-wrapper">
                                        <i class="bi bi-envelope public-input-icon"></i>

                                        <input asp-for="Email"
                                               class="form-control public-input"
                                               autocomplete="username"
                                               placeholder="أدخل بريدك الإلكتروني" />
                                    </div>

                                    <span asp-validation-for="Email"
                                          class="text-danger small">
                                    </span>

                                </div>

                                <div class="mb-3">

                                    <label asp-for="Password"
                                           class="form-label public-form-label">
                                        كلمة المرور
                                    </label>

                                    <div class="public-input-wrapper">
                                        <i class="bi bi-lock public-input-icon"></i>

                                        <input asp-for="Password"
                                               class="form-control public-input"
                                               autocomplete="current-password"
                                               placeholder="أدخل كلمة المرور" />
                                    </div>

                                    <span asp-validation-for="Password"
                                          class="text-danger small">
                                    </span>

                                </div>

                                <div class="admin-login-options">

                                    <div class="form-check">
                                        <input asp-for="RememberMe"
                                               class="form-check-input" />

                                        <label asp-for="RememberMe"
                                               class="form-check-label">
                                            تذكرني
                                        </label>
                                    </div>

                                </div>

                                <button type="submit"
                                        class="btn btn-primary public-btn public-btn-primary public-btn-lg admin-login-button">
                                    <i class="bi bi-box-arrow-in-left"></i>
                                    <span>تسجيل الدخول</span>
                                </button>

                            </form>

                        </div>

                    </div>

                    <div class="admin-login-back">

                        <a asp-controller="Catalog"
                           asp-action="Index"
                           class="text-decoration-none">
                            <i class="bi bi-arrow-right"></i>
                            <span>العودة إلى الكتالوج</span>
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </section>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin-login.css"
          asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}