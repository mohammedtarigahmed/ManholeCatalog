@{
    ViewData["Title"] = "غير مصرح بالوصول";
}

<div class="public-page access-denied-page">

    <section class="public-section access-denied-section">

        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-8">

                    <div class="public-card access-denied-card">

                        <div class="public-card-body access-denied-card-body">

                            <div class="access-denied-icon">
                                <i class="bi bi-shield-lock"></i>
                            </div>

                            <span class="public-page-label access-denied-label">
                                <i class="bi bi-exclamation-circle"></i>
                                غير مصرح
                            </span>

                            <h1 class="public-page-title access-denied-title">
                                ليس لديك صلاحية للوصول
                            </h1>

                            <p class="public-page-description access-denied-description">
                                عذرًا، لا تملك الصلاحيات المطلوبة للوصول إلى هذه الصفحة.
                            </p>

                            <div class="access-denied-actions">

                                <a asp-controller="Home"
                                   asp-action="Index"
                                   class="btn btn-primary public-btn public-btn-primary public-btn-lg">
                                    <i class="bi bi-house"></i>
                                    <span>العودة إلى الرئيسية</span>
                                </a>

                                <a asp-controller="Catalog"
                                   asp-action="Index"
                                   class="btn btn-outline-secondary public-btn public-btn-lg">
                                    <i class="bi bi-grid"></i>
                                    <span>عرض الكتالوج</span>
                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/access-denied.css"
          asp-append-version="true" />
}