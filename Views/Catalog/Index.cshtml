@model IEnumerable<ManholeCatalog.Models.Product>

@{
    ViewData["Title"] = "كتالوج المنتجات";

    var search = ViewBag.Search as string;
    var selectedCategoryId = ViewBag.CategoryId as int?;
    var categories = ViewBag.Categories as IEnumerable<ManholeCatalog.Models.Category>;
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var initialCount = Model.Count();
    var hasMore = initialCount < totalCount;
}

<div class="public-page catalog-page">

    <section class="public-page-header">

        <div class="container">

            <div class="public-page-header-content">

                <span class="public-page-label">
                    <i class="bi bi-grid-3x3-gap-fill"></i>
                    كتالوج المنتجات
                </span>

                <h1 class="public-page-title">
                    اعثر على المنتج المناسب
                </h1>

                <p class="public-page-description">
                    استكشف منتجاتنا المتاحة، وراجع المواصفات،
                    واعثر على الحل المناسب لمشروعك.
                </p>

            </div>

        </div>

    </section>

    <section class="public-section catalog-section">

        <div class="container">

            <div class="public-card catalog-filter-card">

                <div class="public-card-header">

                    <div class="public-card-header-content">

                        <div class="public-card-icon">
                            <i class="bi bi-search"></i>
                        </div>

                        <div>

                            <h2 class="h5 fw-bold mb-1">
                                البحث والتصفية
                            </h2>

                            <p class="text-muted small mb-0">
                                ابحث باسم المنتج أو الرقم التعريفي، أو قم بالتصفية حسب الفئة.
                            </p>

                        </div>

                    </div>

                </div>

                <div class="public-card-body">

                    <form asp-controller="Catalog"
                          asp-action="Index"
                          method="get">

                        <div class="row g-3">

                            <div class="col-lg-5">

                                <div class="public-form-group mb-0">

                                    <label for="search"
                                           class="public-form-label">
                                        البحث عن المنتجات
                                    </label>

                                    <div class="public-input-wrapper">

                                        <i class="bi bi-search public-input-icon"></i>

                                        <input type="text"
                                               id="search"
                                               name="search"
                                               value="@search"
                                               class="form-control public-input"
                                               placeholder="اسم المنتج أو الرقم التعريفي" />

                                    </div>

                                </div>

                            </div>

                            <div class="col-lg-4">

                                <div class="public-form-group mb-0">

                                    <label for="categoryId"
                                           class="public-form-label">
                                        الفئة
                                    </label>

                                    <div class="public-input-wrapper">

                                        <i class="bi bi-folder2-open public-input-icon"></i>

                                        <select id="categoryId"
                                                name="categoryId"
                                                class="form-select public-input">

                                            <option value="">
                                                جميع الفئات
                                            </option>

                                            @if (categories != null)
                                            {
                                                foreach (var category in categories)
                                                {
                                                    if (selectedCategoryId == category.Id)
                                                    {
                                                        <option value="@category.Id" selected>
                                                            @category.Name
                                                        </option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@category.Id">
                                                            @category.Name
                                                        </option>
                                                    }
                                                }
                                            }

                                        </select>

                                    </div>

                                </div>

                            </div>

                            <div class="col-lg-3">

                                <div class="public-form-group mb-0">

                                    <label class="public-form-label">
                                        الإجراءات
                                    </label>

                                    <div class="d-flex gap-2">

                                        <button type="submit"
                                                class="btn btn-primary public-btn public-btn-primary flex-grow-1">

                                            <i class="bi bi-search"></i>

                                            <span>
                                                بحث
                                            </span>

                                        </button>

                                        <a asp-controller="Catalog"
                                           asp-action="Index"
                                           class="btn btn-outline-secondary public-btn">

                                            <i class="bi bi-arrow-counterclockwise"></i>

                                            <span>
                                                مسح
                                            </span>

                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

            <div class="catalog-results-header">

                <div class="catalog-results-main">

                    <div class="public-card-icon catalog-results-icon">

                        @if (!string.IsNullOrWhiteSpace(search) || selectedCategoryId.HasValue)
                        {
                            <i class="bi bi-funnel"></i>
                        }
                        else
                        {
                            <i class="bi bi-box-seam"></i>
                        }

                    </div>

                    <div>

                        @if (!string.IsNullOrWhiteSpace(search) || selectedCategoryId.HasValue)
                        {
                            <h2 class="h5 fw-bold mb-1">
                                نتائج البحث
                            </h2>

                            <div class="text-muted small">
                                تم العثور على @totalCount منتج
                            </div>
                        }
                        else
                        {
                            <h2 class="h5 fw-bold mb-1">
                                المنتجات المتاحة
                            </h2>

                            <div class="text-muted small">
                                @totalCount منتج متاح
                            </div>
                        }

                    </div>

                </div>

                @if (!string.IsNullOrWhiteSpace(search) || selectedCategoryId.HasValue)
                {
                    <div class="catalog-active-filters">

                        @if (!string.IsNullOrWhiteSpace(search))
                        {
                            <span class="public-badge">

                                <i class="bi bi-search"></i>

                                <span class="public-badge-label">
                                    البحث:
                                </span>

                                @search

                            </span>
                        }

                        @if (selectedCategoryId.HasValue && categories != null)
                        {
                            var selectedCategory = categories.FirstOrDefault(c => c.Id == selectedCategoryId.Value);

                            if (selectedCategory != null)
                            {
                                <span class="public-badge">

                                    <i class="bi bi-folder"></i>

                                    <span class="public-badge-label">
                                        الفئة:
                                    </span>

                                    @selectedCategory.Name

                                </span>
                            }
                        }

                    </div>
                }

            </div>

            @if (totalCount == 0)
            {
                <div class="public-empty-state">

                    <div class="public-empty-icon">
                        <i class="bi bi-search"></i>
                    </div>

                    <h2 class="h4 fw-bold mb-2">
                        لم يتم العثور على منتجات
                    </h2>

                    <p class="text-muted mb-4">
                        لا توجد منتجات تطابق البحث أو التصفية الحالية.
                    </p>

                    <a asp-controller="Catalog"
                       asp-action="Index"
                       class="btn btn-primary public-btn public-btn-primary">

                        <i class="bi bi-grid"></i>

                        <span>
                            عرض جميع المنتجات
                        </span>

                    </a>

                </div>
            }
            else
            {
                <div class="catalog-products">

                    <div id="catalogProductsGrid"
                         class="row g-4">

                        <partial name="_ProductCards"
                                 model="Model" />

                    </div>

                </div>

                @if (hasMore)
                {
                    <div id="catalogLoadMoreWrapper"
                         class="catalog-load-more">

                        <button type="button"
                                id="catalogLoadMoreButton"
                                class="btn btn-outline-primary public-btn catalog-load-more-button">

                            <i class="bi bi-plus-circle"></i>

                            <span>
                                عرض المزيد
                            </span>

                        </button>

                    </div>
                }
            }

        </div>

    </section>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/catalog.css"
          asp-append-version="true" />
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const button = document.getElementById("catalogLoadMoreButton");
            const wrapper = document.getElementById("catalogLoadMoreWrapper");
            const grid = document.getElementById("catalogProductsGrid");

            if (!button || !wrapper || !grid) {
                return;
            }

            let skip = @initialCount;

            const search = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(search));
            const categoryId = @selectedCategoryId.GetValueOrDefault(0);

            button.addEventListener("click", async function () {

                button.disabled = true;

                const originalHtml = button.innerHTML;

                button.innerHTML = `
                    <span class="spinner-border spinner-border-sm"
                          role="status"
                          aria-hidden="true"></span>
                    <span>جاري التحميل...</span>
                `;

                try {

                    const params = new URLSearchParams();

                    if (search) {
                        params.append("search", search);
                    }

                    if (categoryId > 0) {
                        params.append("categoryId", categoryId);
                    }

                    params.append("skip", skip);

                    const response = await fetch(
                        `/Catalog/LoadMore?${params.toString()}`,
                        {
                            method: "GET",
                            headers: {
                                "X-Requested-With": "XMLHttpRequest"
                            }
                        }
                    );

                    if (!response.ok) {
                        throw new Error("تعذر تحميل المنتجات.");
                    }

                    const html = await response.text();

                    if (!html.trim()) {
                        wrapper.remove();
                        return;
                    }

                    const temporaryContainer = document.createElement("div");

                    temporaryContainer.innerHTML = html;

                    const newProducts = temporaryContainer.children.length;

                    grid.insertAdjacentHTML("beforeend", html);

                    skip += newProducts;

                    if (newProducts < 9) {
                        wrapper.remove();
                        return;
                    }

                    button.disabled = false;
                    button.innerHTML = originalHtml;

                }
                catch (error) {

                    button.disabled = false;
                    button.innerHTML = originalHtml;

                    alert("تعذر تحميل المنتجات. يرجى المحاولة مرة أخرى.");

                }

            });

        });
    </script>
}