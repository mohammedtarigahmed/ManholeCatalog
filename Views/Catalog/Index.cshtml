@model IEnumerable<ManholeCatalog.Models.Product>

@{
    ViewData["Title"] = "كتالوج المنتجات";

    var search = ViewBag.Search as string;
    var selectedCategoryId = ViewBag.CategoryId as int?;
    var categories = ViewBag.Categories as IEnumerable<ManholeCatalog.Models.Category>;
    var productCount = Model.Count();
}

<div class="public-page catalog-page">

    <!-- Page Header -->
    <section class="public-page-header">

        <div class="container">

            <div class="public-page-header-content">

                <span class="public-page-label">
                    <i class="bi bi-grid-3x3-gap-fill"></i>
                    كتالوج المنتجات
                </span>

                <h1 class="public-page-title">
                    اعثر على المنتج المناسب
                </h1>

                <p class="public-page-description">
                    استكشف منتجاتنا المتاحة، وراجع المواصفات،
                    واعثر على الحل المناسب لمشروعك.
                </p>

            </div>

        </div>

    </section>


    <section class="public-section catalog-section">

        <div class="container">

            <!-- Search & Filters -->
            <div class="public-card catalog-filter-card">

                <div class="public-card-header">

                    <div class="public-card-header-content">

                        <div class="public-card-icon">
                            <i class="bi bi-search"></i>
                        </div>

                        <div>

                            <h2 class="h5 fw-bold mb-1">
                                البحث والتصفية
                            </h2>

                            <p class="text-muted small mb-0">
                                ابحث باسم المنتج أو الرقم التعريفي، أو قم بالتصفية حسب الفئة.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="public-card-body">

                    <form asp-controller="Catalog"
                          asp-action="Index"
                          method="get">

                        <div class="row g-3">

                            <div class="col-lg-5">

                                <div class="public-form-group mb-0">

                                    <label for="search"
                                           class="public-form-label">

                                        البحث عن المنتجات

                                    </label>

                                    <div class="public-input-wrapper">

                                        <i class="bi bi-search public-input-icon"></i>

                                        <input type="text"
                                               id="search"
                                               name="search"
                                               value="@search"
                                               class="form-control public-input"
                                               placeholder="اسم المنتج أو الرقم التعريفي" />

                                    </div>

                                </div>

                            </div>


                            <div class="col-lg-4">

                                <div class="public-form-group mb-0">

                                    <label for="categoryId"
                                           class="public-form-label">

                                        الفئة

                                    </label>

                                    <div class="public-input-wrapper">

                                        <i class="bi bi-folder2-open public-input-icon"></i>

                                        <select id="categoryId"
                                                name="categoryId"
                                                class="form-select public-input">

                                            <option value="">
                                                جميع الفئات
                                            </option>

                                            @if (categories != null)
                                            {
                                                foreach (var category in categories)
                                                {
                                                    if (selectedCategoryId == category.Id)
                                                    {
                                                        <option value="@category.Id" selected>
                                                            @category.Name
                                                        </option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@category.Id">
                                                            @category.Name
                                                        </option>
                                                    }
                                                }
                                            }

                                        </select>

                                    </div>

                                </div>

                            </div>


                            <div class="col-lg-3">

                                <div class="public-form-group mb-0">

                                    <label class="public-form-label">
                                        الإجراءات
                                    </label>

                                    <div class="d-flex gap-2">

                                        <button type="submit"
                                                class="btn btn-primary public-btn public-btn-primary flex-grow-1">

                                            <i class="bi bi-search"></i>
                                            <span>بحث</span>

                                        </button>

                                        <a asp-controller="Catalog"
                                           asp-action="Index"
                                           class="btn btn-outline-secondary public-btn">

                                            <i class="bi bi-arrow-counterclockwise"></i>
                                            <span>مسح</span>

                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </form>

                </div>

            </div>


            <!-- Results Header -->
            <div class="catalog-results-header">

                <div class="catalog-results-main">

                    <div class="public-card-icon catalog-results-icon">

                        @if (!string.IsNullOrWhiteSpace(search) || selectedCategoryId.HasValue)
                        {
                            <i class="bi bi-funnel"></i>
                        }
                        else
                        {
                            <i class="bi bi-box-seam"></i>
                        }

                    </div>

                    <div>

                        @if (!string.IsNullOrWhiteSpace(search) || selectedCategoryId.HasValue)
                        {
                            <h2 class="h5 fw-bold mb-1">
                                نتائج البحث
                            </h2>

                            <div class="text-muted small">
                                تم العثور على @productCount منتج
                            </div>
                        }
                        else
                        {
                            <h2 class="h5 fw-bold mb-1">
                                المنتجات المتاحة
                            </h2>

                            <div class="text-muted small">
                                @productCount منتج متاح
                            </div>
                        }

                    </div>

                </div>


                @if (!string.IsNullOrWhiteSpace(search) || selectedCategoryId.HasValue)
                {
                    <div class="catalog-active-filters">

                        @if (!string.IsNullOrWhiteSpace(search))
                        {
                            <span class="public-badge">

                                <i class="bi bi-search"></i>

                                <span class="public-badge-label">
                                    البحث:
                                </span>

                                @search

                            </span>
                        }


                        @if (selectedCategoryId.HasValue && categories != null)
                        {
                            var selectedCategory = categories.FirstOrDefault(c => c.Id == selectedCategoryId.Value);

                            if (selectedCategory != null)
                            {
                                <span class="public-badge">

                                    <i class="bi bi-folder"></i>

                                    <span class="public-badge-label">
                                        الفئة:
                                    </span>

                                    @selectedCategory.Name

                                </span>
                            }
                        }

                    </div>
                }

            </div>


            @if (!Model.Any())
            {
                <!-- Empty State -->
                <div class="public-empty-state">

                    <div class="public-empty-icon">
                        <i class="bi bi-search"></i>
                    </div>

                    <h2 class="h4 fw-bold mb-2">
                        لم يتم العثور على منتجات
                    </h2>

                    <p class="text-muted mb-4">
                        لا توجد منتجات تطابق البحث أو التصفية الحالية.
                    </p>

                    <a asp-controller="Catalog"
                       asp-action="Index"
                       class="btn btn-primary public-btn public-btn-primary">

                        <i class="bi bi-grid"></i>
                        <span>عرض جميع المنتجات</span>

                    </a>

                </div>
            }
            else
            {
                <!-- Product Grid -->
                <div class="catalog-products">

                    <div class="row g-4">

                        @foreach (var product in Model)
                        {
                            var primaryImage = product.Images.FirstOrDefault(i => i.IsPrimary) ?? product.Images.OrderBy(i => i.DisplayOrder).FirstOrDefault();

                            <div class="col-sm-6 col-lg-4">

                                <article class="public-card catalog-product-card">

                                    <!-- Product Image -->
                                    <div class="catalog-product-image-wrapper">

                                        @if (primaryImage != null)
                                        {
                                            <img src="@primaryImage.ImagePath"
                                                 alt="@primaryImage.AltText"
                                                 class="catalog-product-image" />
                                        }
                                        else
                                        {
                                            <div class="catalog-no-image">

                                                <div class="catalog-no-image-icon">
                                                    <i class="bi bi-image"></i>
                                                </div>

                                                <span>
                                                    لا توجد صورة متاحة
                                                </span>

                                            </div>
                                        }

                                    </div>


                                    <!-- Product Information -->
                                    <div class="public-card-body catalog-product-body">

                                        <div class="catalog-product-heading">

                                            @if (product.Category != null)
                                            {
                                                <div class="catalog-product-category">

                                                    <i class="bi bi-folder2"></i>

                                                    <span>
                                                        @product.Category.Name
                                                    </span>

                                                </div>
                                            }


                                            <h3 class="catalog-product-title">
                                                @product.Name
                                            </h3>


                                            @if (!string.IsNullOrWhiteSpace(product.SKU))
                                            {
                                                <span class="catalog-product-sku">

                                                    <i class="bi bi-upc-scan"></i>

                                                    <span>
                                                        SKU: @product.SKU
                                                    </span>

                                                </span>
                                            }

                                        </div>


                                        <!-- Specifications -->
                                        @if (!string.IsNullOrWhiteSpace(product.Material) ||
                                             !string.IsNullOrWhiteSpace(product.LoadClass) ||
                                             !string.IsNullOrWhiteSpace(product.Diameter) ||
                                             !string.IsNullOrWhiteSpace(product.Shape))
                                        {
                                            <div class="public-specifications catalog-specifications">

                                                @if (!string.IsNullOrWhiteSpace(product.Material))
                                                {
                                                    <div class="public-spec-item">

                                                        <span class="public-spec-label">

                                                            <i class="bi bi-layers"></i>
                                                            <span>المادة</span>

                                                        </span>

                                                        <span class="public-spec-value">
                                                            @product.Material
                                                        </span>

                                                    </div>
                                                }


                                                @if (!string.IsNullOrWhiteSpace(product.LoadClass))
                                                {
                                                    <div class="public-spec-item">

                                                        <span class="public-spec-label">

                                                            <i class="bi bi-shield-check"></i>
                                                            <span>فئة التحميل</span>

                                                        </span>

                                                        <span class="public-spec-value">
                                                            @product.LoadClass
                                                        </span>

                                                    </div>
                                                }


                                                @if (!string.IsNullOrWhiteSpace(product.Diameter))
                                                {
                                                    <div class="public-spec-item">

                                                        <span class="public-spec-label">

                                                            <i class="bi bi-arrows-expand"></i>
                                                            <span>القطر</span>

                                                        </span>

                                                        <span class="public-spec-value">
                                                            @product.Diameter
                                                        </span>

                                                    </div>
                                                }


                                                @if (!string.IsNullOrWhiteSpace(product.Shape))
                                                {
                                                    <div class="public-spec-item">

                                                        <span class="public-spec-label">

                                                            <i class="bi bi-circle-square"></i>
                                                            <span>الشكل</span>

                                                        </span>

                                                        <span class="public-spec-value">
                                                            @product.Shape
                                                        </span>

                                                    </div>
                                                }

                                            </div>
                                        }


                                        <!-- Price & Actions -->
                                        <div class="catalog-product-footer">

                                            @if (product.Price.HasValue)
                                            {
                                                <div class="catalog-product-price">

                                                    <span class="catalog-price-label">
                                                        السعر
                                                    </span>

                                                    <div class="catalog-price-value">

                                                        @product.Price.Value.ToString("N2")

                                                        <span>
                                                            ر.س
                                                        </span>

                                                    </div>

                                                </div>
                                            }
                                            else
                                            {
                                                <div class="catalog-price-placeholder">
                                                    السعر عند الطلب
                                                </div>
                                            }


                                            <div class="catalog-product-actions">

                                                <a asp-controller="Catalog"
                                                   asp-action="Details"
                                                   asp-route-id="@product.Id"
                                                   class="btn btn-outline-primary public-btn">

                                                    <i class="bi bi-eye"></i>
                                                    <span>عرض التفاصيل</span>

                                                </a>


                                                <a asp-controller="Quotation"
                                                   asp-action="Create"
                                                   asp-route-productId="@product.Id"
                                                   class="btn btn-primary public-btn public-btn-primary">

                                                    <i class="bi bi-chat-square-text"></i>
                                                    <span>طلب عرض سعر</span>

                                                </a>

                                            </div>

                                        </div>

                                    </div>

                                </article>

                            </div>
                        }

                    </div>

                </div>
            }

        </div>

    </section>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/catalog.css"
          asp-append-version="true" />
}