@model IEnumerable<ManholeCatalog.Models.Product>

@{
    ViewData["Title"] = "Product Catalog";

    var search = ViewBag.Search as string;
    var selectedCategoryId = ViewBag.CategoryId as int?;
    var categories = ViewBag.Categories as IEnumerable<ManholeCatalog.Models.Category>;
    var productCount = Model.Count();
}

<div class="container py-5">

    <!-- Page Header -->
    <section class="text-center mb-5">

        <span class="badge text-bg-primary px-3 py-2 mb-3">
            Product Catalog
        </span>

        <h1 class="display-5 fw-bold mb-3">
            Find the Right Product
        </h1>

        <p class="lead text-muted mb-0">
            Explore our available products, review specifications,
            and find the right solution for your project.
        </p>

    </section>

    <!-- Search & Filters -->
    <section class="card border-0 shadow-sm mb-5">

        <div class="card-body p-4 p-lg-5">

            <div class="mb-4">

                <h2 class="h5 fw-bold mb-1">
                    Find a Product
                </h2>

                <p class="text-muted small mb-0">
                    Search by product name or SKU, or filter by category.
                </p>

            </div>

            <form asp-controller="Catalog"
                  asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-lg-5">

                        <label for="search"
                               class="form-label fw-semibold">
                            Search Products
                        </label>

                        <input type="text"
                               id="search"
                               name="search"
                               value="@search"
                               class="form-control"
                               placeholder="Search by product name or SKU" />

                    </div>

                    <div class="col-lg-4">

                        <label for="categoryId"
                               class="form-label fw-semibold">
                            Category
                        </label>

                        <select id="categoryId"
                                name="categoryId"
                                class="form-select">

                            <option value="">
                                All Categories
                            </option>

                            @if (categories != null)
                            {
                                foreach (var category in categories)
                                {
                                    if (selectedCategoryId == category.Id)
                                    {
                                        <option value="@category.Id" selected>
                                            @category.Name
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@category.Id">
                                            @category.Name
                                        </option>
                                    }
                                }
                            }

                        </select>

                    </div>

                    <div class="col-lg-3">

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary flex-grow-1">
                                Search
                            </button>

                            <a asp-controller="Catalog"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Clear
                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </section>

    <!-- Results Header -->
    <section class="mb-4">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">

            <div>

                @if (!string.IsNullOrWhiteSpace(search) || selectedCategoryId.HasValue)
                {
                    <h2 class="h5 fw-bold mb-1">
                        Search Results
                    </h2>

                    <div class="text-muted small">
                        @productCount product(s) found
                    </div>
                }
                else
                {
                    <h2 class="h5 fw-bold mb-1">
                        Available Products
                    </h2>

                    <div class="text-muted small">
                        @productCount product(s) available
                    </div>
                }

            </div>

            @if (!string.IsNullOrWhiteSpace(search) || selectedCategoryId.HasValue)
            {
                <div class="d-flex flex-wrap gap-2">

                    @if (!string.IsNullOrWhiteSpace(search))
                    {
                        <span class="badge text-bg-light border">
                            Search: @search
                        </span>
                    }

                    @if (selectedCategoryId.HasValue && categories != null)
                    {
                        var selectedCategory = categories.FirstOrDefault(c => c.Id == selectedCategoryId.Value);

                        if (selectedCategory != null)
                        {
                            <span class="badge text-bg-light border">
                                Category: @selectedCategory.Name
                            </span>
                        }
                    }

                </div>
            }

        </div>

    </section>

    @if (!Model.Any())
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light border mb-4"
                     style="width: 72px; height: 72px;">

                    <span class="fs-3">
                        🔍
                    </span>

                </div>

                <h2 class="h4 fw-bold mb-2">
                    No Products Found
                </h2>

                <p class="text-muted mb-4">
                    No products match your current search or filter.
                </p>

                <a asp-controller="Catalog"
                   asp-action="Index"
                   class="btn btn-primary">
                    View All Products
                </a>

            </div>

        </div>
    }
    else
    {
        <!-- Product Grid -->
        <div class="row g-4">

            @foreach (var product in Model)
            {
                var primaryImage = product.Images.FirstOrDefault(i => i.IsPrimary) ?? product.Images.OrderBy(i => i.DisplayOrder).FirstOrDefault();

                <div class="col-sm-6 col-lg-4">

                    <article class="card h-100 border-0 shadow-sm">

                        <!-- Product Image -->
                        <div class="position-relative border-bottom">

                            @if (primaryImage != null)
                            {
                                <img src="@primaryImage.ImagePath"
                                     alt="@product.Name"
                                     class="card-img-top"
                                     style="height: 260px; object-fit: contain; background-color: #f8f9fa;" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center text-muted"
                                     style="height: 260px; background-color: #f8f9fa;">

                                    <div class="text-center">

                                        <div class="fs-1 mb-2">
                                            —
                                        </div>

                                        <div class="small">
                                            No Image Available
                                        </div>

                                    </div>

                                </div>
                            }

                        </div>

                        <!-- Product Information -->
                        <div class="card-body d-flex flex-column p-4">

                            <div class="mb-3">

                                @if (product.Category != null)
                                {
                                    <div class="small text-primary fw-semibold mb-2">
                                        @product.Category.Name
                                    </div>
                                }

                                <h3 class="h5 fw-bold mb-2">
                                    @product.Name
                                </h3>

                                @if (!string.IsNullOrWhiteSpace(product.SKU))
                                {
                                    <span class="badge text-bg-light border">
                                        SKU: @product.SKU
                                    </span>
                                }

                            </div>

                            <!-- Specifications -->
                            @if (!string.IsNullOrWhiteSpace(product.Material) ||
                                 !string.IsNullOrWhiteSpace(product.LoadClass) ||
                                 !string.IsNullOrWhiteSpace(product.Diameter) ||
                                 !string.IsNullOrWhiteSpace(product.Shape))
                            {
                                <div class="border-top border-bottom mb-4">

                                    @if (!string.IsNullOrWhiteSpace(product.Material))
                                    {
                                        <div class="d-flex justify-content-between align-items-start gap-3 py-2 border-bottom">

                                            <span class="text-muted small">
                                                Material
                                            </span>

                                            <span class="fw-semibold small text-end">
                                                @product.Material
                                            </span>

                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(product.LoadClass))
                                    {
                                        <div class="d-flex justify-content-between align-items-start gap-3 py-2 border-bottom">

                                            <span class="text-muted small">
                                                Load Class
                                            </span>

                                            <span class="fw-semibold small text-end">
                                                @product.LoadClass
                                            </span>

                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(product.Diameter))
                                    {
                                        <div class="d-flex justify-content-between align-items-start gap-3 py-2 border-bottom">

                                            <span class="text-muted small">
                                                Diameter
                                            </span>

                                            <span class="fw-semibold small text-end">
                                                @product.Diameter
                                            </span>

                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(product.Shape))
                                    {
                                        <div class="d-flex justify-content-between align-items-start gap-3 py-2">

                                            <span class="text-muted small">
                                                Shape
                                            </span>

                                            <span class="fw-semibold small text-end">
                                                @product.Shape
                                            </span>

                                        </div>
                                    }

                                </div>
                            }

                            <!-- Price & Actions -->
                            <div class="mt-auto">

                                @if (product.Price.HasValue)
                                {
                                    <div class="mb-3">

                                        <div class="small text-muted mb-1">
                                            Price
                                        </div>

                                        <div class="fs-4 fw-bold">
                                            @product.Price.Value.ToString("N2") SAR
                                        </div>

                                    </div>
                                }

                                <div class="d-grid gap-2">

                                    <a asp-controller="Catalog"
                                       asp-action="Details"
                                       asp-route-id="@product.Id"
                                       class="btn btn-outline-primary">
                                        View Details
                                    </a>

                                    <a asp-controller="Quotation"
                                       asp-action="Create"
                                       asp-route-productId="@product.Id"
                                       class="btn btn-primary">
                                        Request a Quote
                                    </a>

                                </div>

                            </div>

                        </div>

                    </article>

                </div>
            }

        </div>
    }

</div>