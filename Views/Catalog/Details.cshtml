@model ManholeCatalog.Models.Product

@{
    ViewData["Title"] = Model.Name;

    var primaryImage = Model.Images.FirstOrDefault(i => i.IsPrimary) ?? Model.Images.OrderBy(i => i.DisplayOrder).FirstOrDefault();

    var orderedImages = Model.Images
        .OrderBy(i => i.DisplayOrder)
        .ThenBy(i => i.Id)
        .ToList();

    var whatsappNumber = ViewContext.HttpContext.RequestServices.GetRequiredService<IConfiguration>()["WhatsApp:PhoneNumber"];

    var productUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";

    var whatsappMessage = $"مرحباً، أرغب في الاستفسار عن هذا المنتج.%0A%0Aالمنتج: {Model.Name}";

    if (!string.IsNullOrWhiteSpace(Model.SKU))
    {
        whatsappMessage += $"%0Aالرقم التعريفي: {Model.SKU}";
    }

    whatsappMessage += $"%0A%0Aصفحة المنتج: {productUrl}";

    var whatsappUrl = $"https://wa.me/{whatsappNumber}?text={Uri.EscapeDataString(Uri.UnescapeDataString(whatsappMessage))}";
}

<div class="public-page product-details-page">

    <!-- Product Header -->
    <section class="public-page-header product-details-header">

        <div class="container">

            <div class="product-details-header-content">

                <div class="product-details-heading">

                    @if (Model.Category != null)
                    {
                        <span class="public-page-label">
                            <i class="bi bi-folder2"></i>
                            @Model.Category.Name
                        </span>
                    }

                    <h1 class="public-page-title">
                        @Model.Name
                    </h1>

                </div>

                <a asp-controller="Catalog"
                   asp-action="Index"
                   class="btn btn-outline-secondary public-btn">

                    <i class="bi bi-arrow-right"></i>
                    <span>العودة إلى الكتالوج</span>

                </a>

            </div>

        </div>

    </section>


    <section class="public-section product-details-section">

        <div class="container">

            <div class="row g-4 g-xl-5">

                <!-- Product Gallery -->
                <div class="col-lg-7">

                    <div class="public-card product-gallery-card">

                        <div class="product-main-image-wrapper">

                            @if (primaryImage != null)
                            {
                                <img id="mainProductImage"
                                     src="@primaryImage.ImagePath"
                                     alt="@(primaryImage.AltText ?? Model.Name)"
                                     class="product-main-image" />
                            }
                            else
                            {
                                <div class="product-main-no-image">

                                    <div class="product-no-image-icon">
                                        <i class="bi bi-image"></i>
                                    </div>

                                    <span>
                                        لا توجد صورة متاحة
                                    </span>

                                </div>
                            }

                        </div>


                        @if (orderedImages.Any())
                        {
                            <div class="product-thumbnails">

                                @foreach (var image in orderedImages)
                                {
                                    var isSelected = primaryImage != null && image.Id == primaryImage.Id;

                                    <button type="button"
                                            class="product-thumbnail-button @(isSelected ? "selected" : "")"
                                            onclick="changeProductImage('@image.ImagePath', this)"
                                            aria-label="عرض صورة المنتج">

                                        <img src="@image.ImagePath"
                                             alt="@(image.AltText ?? Model.Name)"
                                             class="product-thumbnail-image" />

                                    </button>
                                }

                            </div>
                        }

                    </div>


                    @if (orderedImages.Count > 1)
                    {
                        <div class="product-gallery-note">

                            <i class="bi bi-images"></i>

                            <span>
                                يحتوي هذا المنتج على @orderedImages.Count صور. اختر صورة من الأعلى لعرضها.
                            </span>

                        </div>
                    }

                </div>


                <!-- Product Information -->
                <div class="col-lg-5">

                    <div class="public-card product-info-card">

                        <div class="public-card-header">

                            <div class="product-info-header">

                                @if (!string.IsNullOrWhiteSpace(Model.SKU))
                                {
                                    <span class="public-badge">

                                        <i class="bi bi-upc-scan"></i>

                                        <span class="public-badge-label">
                                            الرقم التعريفي:
                                        </span>

                                        @Model.SKU

                                    </span>
                                }

                                <h2 class="h4 fw-bold mb-0">
                                    @Model.Name
                                </h2>

                            </div>

                        </div>


                        <div class="public-card-body">

                            @if (!string.IsNullOrWhiteSpace(Model.Description))
                            {
                                <section class="product-info-section">

                                    <div class="public-card-header-content product-info-section-heading">

                                        <div class="public-card-icon">
                                            <i class="bi bi-file-text"></i>
                                        </div>

                                        <div>
                                            <h3 class="h6 fw-bold mb-0">
                                                الوصف
                                            </h3>
                                        </div>

                                    </div>

                                    <p class="product-description mb-0">
                                        @Model.Description
                                    </p>

                                </section>
                            }


                            <!-- Specifications -->
                            @if (!string.IsNullOrWhiteSpace(Model.Material) ||
                                 !string.IsNullOrWhiteSpace(Model.LoadClass) ||
                                 !string.IsNullOrWhiteSpace(Model.Diameter) ||
                                 !string.IsNullOrWhiteSpace(Model.Shape))
                            {
                                <section class="product-info-section">

                                    <div class="public-card-header-content product-info-section-heading">

                                        <div class="public-card-icon">
                                            <i class="bi bi-sliders"></i>
                                        </div>

                                        <div>
                                            <h3 class="h6 fw-bold mb-0">
                                                مواصفات المنتج
                                            </h3>
                                        </div>

                                    </div>


                                    <div class="product-spec-grid">

                                        @if (!string.IsNullOrWhiteSpace(Model.Material))
                                        {
                                            <div class="product-spec-card">

                                                <div class="product-spec-icon">
                                                    <i class="bi bi-layers"></i>
                                                </div>

                                                <div>

                                                    <div class="product-spec-label">
                                                        المادة
                                                    </div>

                                                    <div class="product-spec-value">
                                                        @Model.Material
                                                    </div>

                                                </div>

                                            </div>
                                        }


                                        @if (!string.IsNullOrWhiteSpace(Model.LoadClass))
                                        {
                                            <div class="product-spec-card">

                                                <div class="product-spec-icon">
                                                    <i class="bi bi-shield-check"></i>
                                                </div>

                                                <div>

                                                    <div class="product-spec-label">
                                                        فئة التحميل
                                                    </div>

                                                    <div class="product-spec-value">
                                                        @Model.LoadClass
                                                    </div>

                                                </div>

                                            </div>
                                        }


                                        @if (!string.IsNullOrWhiteSpace(Model.Diameter))
                                        {
                                            <div class="product-spec-card">

                                                <div class="product-spec-icon">
                                                    <i class="bi bi-arrows-expand"></i>
                                                </div>

                                                <div>

                                                    <div class="product-spec-label">
                                                        القطر
                                                    </div>

                                                    <div class="product-spec-value">
                                                        @Model.Diameter
                                                    </div>

                                                </div>

                                            </div>
                                        }


                                        @if (!string.IsNullOrWhiteSpace(Model.Shape))
                                        {
                                            <div class="product-spec-card">

                                                <div class="product-spec-icon">
                                                    <i class="bi bi-circle-square"></i>
                                                </div>

                                                <div>

                                                    <div class="product-spec-label">
                                                        الشكل
                                                    </div>

                                                    <div class="product-spec-value">
                                                        @Model.Shape
                                                    </div>

                                                </div>

                                            </div>
                                        }

                                    </div>

                                </section>
                            }


                            <!-- Price -->
                            @if (Model.Price.HasValue)
                            {
                                <section class="product-info-section product-price-section">

                                    <span class="product-price-label">
                                        السعر
                                    </span>

                                    <div class="product-price">

                                        @Model.Price.Value.ToString("N2")

                                        <span>
                                            ر.س
                                        </span>

                                    </div>

                                </section>
                            }


                            <!-- Actions -->
                            <section class="product-info-section product-action-section">

                                <div class="public-card-header-content product-info-section-heading">

                                    <div class="public-card-icon">
                                        <i class="bi bi-chat-square-text"></i>
                                    </div>

                                    <div>
                                        <h3 class="h6 fw-bold mb-0">
                                            هل أنت مهتم بهذا المنتج؟
                                        </h3>
                                    </div>

                                </div>

                                <p class="product-action-description">
                                    اطلب عرض سعر أو تواصل معنا مباشرة للحصول على مزيد من المعلومات.
                                </p>


                                <div class="product-action-buttons">

                                    <a asp-controller="Quotation"
                                       asp-action="Create"
                                       asp-route-productId="@Model.Id"
                                       class="btn btn-primary public-btn public-btn-primary public-btn-lg">

                                        <i class="bi bi-file-earmark-text"></i>
                                        <span>طلب عرض سعر</span>

                                    </a>


                                    @if (!string.IsNullOrWhiteSpace(whatsappNumber))
                                    {
                                        <a href="@whatsappUrl"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="btn btn-success public-btn public-btn-lg product-whatsapp-btn">

                                            <i class="bi bi-whatsapp"></i>
                                            <span>تواصل معنا عبر واتساب</span>

                                        </a>
                                    }

                                </div>

                            </section>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/details.css"
          asp-append-version="true" />
}

@section Scripts {

    <script>

        function changeProductImage(imagePath, selectedButton) {

            const mainImage = document.getElementById("mainProductImage");

            if (mainImage) {
                mainImage.src = imagePath;
            }

            const buttons = document.querySelectorAll(".product-thumbnail-button");

            buttons.forEach(function (button) {
                button.classList.remove("selected");
            });

            if (selectedButton) {
                selectedButton.classList.add("selected");
            }
        }

    </script>

}