@model ManholeCatalog.Models.QuotationRequest

@{
    ViewData["Title"] = "طلب عرض سعر";

    var productImages = Model.Product?.Images
        .OrderBy(i => i.DisplayOrder)
        .ThenBy(i => i.Id)
        .ToList() ?? new List<ManholeCatalog.Models.ProductImage>();

    var primaryImage = productImages.FirstOrDefault(i => i.IsPrimary) ?? productImages.FirstOrDefault();
}

<div class="container py-5">

    <!-- Back to Product -->
    <div class="mb-4">

        <a asp-controller="Catalog"
           asp-action="Details"
           asp-route-id="@Model.ProductId"
           class="btn btn-outline-secondary">
            ← العودة إلى المنتج
        </a>

    </div>

    <div class="mb-5">

        <span class="badge text-bg-primary px-3 py-2 mb-3">
            طلب عرض سعر
        </span>

        <h1 class="display-6 fw-bold mb-2">
            طلب عرض سعر
        </h1>

        <p class="lead text-muted mb-0">
            أخبرنا بما تحتاجه وأدخل بيانات التواصل الخاصة بك.
            سيقوم فريقنا بمراجعة طلبك والتواصل معك بخصوص عرض السعر.
        </p>

    </div>

    <div class="row g-4 g-lg-5">

        <!-- Product Summary -->
        <div class="col-lg-5">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white py-3">

                    <h2 class="h5 fw-bold mb-1">
                        المنتج
                    </h2>

                    <p class="text-muted small mb-0">
                        المنتج المطلوب ضمن طلب عرض السعر.
                    </p>

                </div>

                <div class="card-body p-4">

                    <!-- Product Image -->
                    <div class="rounded overflow-hidden mb-4"
                         style="background-color: #f8f9fa;">

                        @if (primaryImage != null)
                        {
                            <img src="@primaryImage.ImagePath"
                                 alt="@Model.Product?.Name"
                                 class="w-100"
                                 style="height: 300px; object-fit: contain;" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center text-muted"
                                 style="height: 300px;">

                                <div class="text-center">

                                    <div class="display-5 mb-2">
                                        —
                                    </div>

                                    <div class="small">
                                        لا توجد صورة متاحة
                                    </div>

                                </div>

                            </div>
                        }

                    </div>

                    <!-- Product Name -->
                    <div class="mb-4">

                        <div class="small text-muted mb-1">
                            المنتج
                        </div>

                        <div class="fw-bold fs-5">
                            @Model.Product?.Name
                        </div>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Product?.SKU))
                    {
                        <div class="mb-3">

                            <div class="small text-muted mb-1">
                                الرقم التعريفي
                            </div>

                            <span class="badge text-bg-light border">
                                @Model.Product.SKU
                            </span>

                        </div>
                    }

                    @if (Model.Product?.Category != null)
                    {
                        <div class="mb-3">

                            <div class="small text-muted mb-1">
                                الفئة
                            </div>

                            <div class="fw-semibold">
                                @Model.Product.Category.Name
                            </div>

                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Product?.Material))
                    {
                        <div class="mb-3">

                            <div class="small text-muted mb-1">
                                المادة
                            </div>

                            <div class="fw-semibold">
                                @Model.Product.Material
                            </div>

                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Product?.LoadClass))
                    {
                        <div class="mb-3">

                            <div class="small text-muted mb-1">
                                فئة التحميل
                            </div>

                            <div class="fw-semibold">
                                @Model.Product.LoadClass
                            </div>

                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Product?.Diameter))
                    {
                        <div class="mb-3">

                            <div class="small text-muted mb-1">
                                القطر
                            </div>

                            <div class="fw-semibold">
                                @Model.Product.Diameter
                            </div>

                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Product?.Shape))
                    {
                        <div>

                            <div class="small text-muted mb-1">
                                الشكل
                            </div>

                            <div class="fw-semibold">
                                @Model.Product.Shape
                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>

        <!-- Quotation Form -->
        <div class="col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">

                    <h2 class="h5 fw-bold mb-1">
                        بياناتك
                    </h2>

                    <p class="text-muted small mb-0">
                        يرجى إدخال بيانات التواصل بشكل صحيح حتى نتمكن من التواصل معك.
                    </p>

                </div>

                <div class="card-body p-4 p-lg-5">

                    <form asp-action="Create"
                          method="post">

                        <input type="hidden"
                               asp-for="ProductId" />

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="All"
                                 class="alert alert-danger"
                                 role="alert">
                            </div>
                        }

                        <!-- Contact Information -->
                        <div class="mb-4">

                            <h3 class="h6 fw-bold mb-3">
                                بيانات التواصل
                            </h3>

                            <div class="row g-3">

                                <div class="col-md-6">

                                    <label asp-for="FullName"
                                           class="form-label fw-semibold">
                                        الاسم الكامل
                                    </label>

                                    <input asp-for="FullName"
                                           class="form-control"
                                           placeholder="أدخل اسمك الكامل" />

                                    <span asp-validation-for="FullName"
                                          class="text-danger small">
                                    </span>

                                </div>

                                <div class="col-md-6">

                                    <label asp-for="CompanyName"
                                           class="form-label fw-semibold">
                                        اسم الشركة
                                    </label>

                                    <input asp-for="CompanyName"
                                           class="form-control"
                                           placeholder="اسم الشركة (اختياري)" />

                                    <span asp-validation-for="CompanyName"
                                          class="text-danger small">
                                    </span>

                                </div>

                                <div class="col-md-6">

                                    <label asp-for="Email"
                                           class="form-label fw-semibold">
                                        البريد الإلكتروني
                                    </label>

                                    <input asp-for="Email"
                                           class="form-control"
                                           type="email"
                                           placeholder="name@example.com" />

                                    <span asp-validation-for="Email"
                                          class="text-danger small">
                                    </span>

                                </div>

                                <div class="col-md-6">

                                    <label asp-for="PhoneNumber"
                                           class="form-label fw-semibold">
                                        رقم الهاتف
                                    </label>

                                    <input asp-for="PhoneNumber"
                                           class="form-control"
                                           type="tel"
                                           placeholder="أدخل رقم هاتفك" />

                                    <span asp-validation-for="PhoneNumber"
                                          class="text-danger small">
                                    </span>

                                </div>

                            </div>

                        </div>

                        <!-- Request Details -->
                        <div class="mb-4">

                            <h3 class="h6 fw-bold mb-3">
                                تفاصيل الطلب
                            </h3>

                            <div class="row g-3">

                                <div class="col-md-6">

                                    <label asp-for="Quantity"
                                           class="form-label fw-semibold">
                                        الكمية
                                    </label>

                                    <input asp-for="Quantity"
                                           class="form-control"
                                           type="number"
                                           min="1" />

                                    <span asp-validation-for="Quantity"
                                          class="text-danger small">
                                    </span>

                                </div>

                                <div class="col-12">

                                    <label asp-for="Message"
                                           class="form-label fw-semibold">
                                        الرسالة
                                    </label>

                                    <textarea asp-for="Message"
                                              class="form-control"
                                              rows="6"
                                              placeholder="أخبرنا عن متطلباتك، والمواصفات، واحتياجات التوصيل، أو أي تفاصيل أخرى."></textarea>

                                    <span asp-validation-for="Message"
                                          class="text-danger small">
                                    </span>

                                </div>

                            </div>

                        </div>

                        <!-- Actions -->
                        <div class="border-top pt-4">

                            <div class="d-flex flex-column flex-sm-row gap-2">

                                <button type="submit"
                                        class="btn btn-primary btn-lg">
                                    إرسال الطلب
                                </button>

                                <a asp-controller="Catalog"
                                   asp-action="Details"
                                   asp-route-id="@Model.ProductId"
                                   class="btn btn-outline-secondary btn-lg">
                                    إلغاء
                                </a>

                            </div>

                            <p class="text-muted small mt-3 mb-0">
                                بإرسال هذا الطلب، فإنك تقدم بيانات التواصل الخاصة بك حتى يتمكن فريقنا من
                                متابعتك بخصوص عرض السعر.
                            </p>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}