@model ManholeCatalog.Models.QuotationRequest

@{
    ViewData["Title"] = "طلب عرض سعر";

    var productImages = Model.Product?.Images
        .OrderBy(i => i.DisplayOrder)
        .ThenBy(i => i.Id)
        .ToList() ?? new List<ManholeCatalog.Models.ProductImage>();

    var primaryImage = productImages.FirstOrDefault(i => i.IsPrimary) ?? productImages.FirstOrDefault();
}

<div class="public-page quotation-page">

    <!-- Page Header -->
    <section class="public-page-header quotation-header">

        <div class="container">

            <div class="public-page-header-content quotation-header-content">

                <span class="public-page-label quotation-header-badge">
                    <span>
                        <i class="bi bi-file-earmark-text"></i>
                    </span>
                    طلب عرض سعر
                </span>

                <h1 class="public-page-title quotation-title">
                    طلب عرض سعر
                </h1>

                <p class="public-page-description quotation-description">
                    أخبرنا بما تحتاجه وأدخل بيانات التواصل الخاصة بك.
                    سيقوم فريقنا بمراجعة طلبك والتواصل معك بخصوص عرض السعر.
                </p>

                <a asp-controller="Catalog"
                   asp-action="Details"
                   asp-route-id="@Model.ProductId"
                   class="btn btn-outline-secondary public-btn quotation-back-link">

                    <i class="bi bi-arrow-right"></i>

                    <span>
                        العودة إلى المنتج
                    </span>

                </a>

            </div>

        </div>

    </section>


    <section class="public-section quotation-content">

        <div class="container">

            <div class="row g-4 g-xl-5">

                <!-- Product Summary -->
                <div class="col-lg-5">

                    <div class="public-card quotation-product-card">

                        <div class="public-card-header quotation-card-header">

                            <div class="public-card-header-content">

                                <div class="public-card-icon quotation-card-icon">
                                    <i class="bi bi-box-seam"></i>
                                </div>

                                <div>

                                    <h2 class="h5 fw-bold mb-1">
                                        المنتج
                                    </h2>

                                    <p class="text-muted small mb-0">
                                        المنتج المطلوب ضمن طلب عرض السعر.
                                    </p>

                                </div>

                            </div>

                        </div>


                        <div class="public-card-body quotation-product-body">

                            <!-- Product Image -->
                            <div class="quotation-product-image-wrapper">

                                @if (primaryImage != null)
                                {
                                    <img src="@primaryImage.ImagePath"
                                         alt="@Model.Product?.Name"
                                         class="quotation-product-image" />
                                }
                                else
                                {
                                    <div class="quotation-product-no-image">

                                        <div class="quotation-no-image-icon">
                                            <i class="bi bi-image"></i>
                                        </div>

                                        <span>
                                            لا توجد صورة متاحة
                                        </span>

                                    </div>
                                }

                            </div>


                            <!-- Product Name -->
                            <div class="quotation-product-title-section">

                                <div class="quotation-product-label">
                                    المنتج
                                </div>

                                <h3 class="quotation-product-name">
                                    @Model.Product?.Name
                                </h3>

                            </div>


                            <!-- Product Information -->
                            <div class="quotation-product-details">

                                @if (!string.IsNullOrWhiteSpace(Model.Product?.SKU))
                                {
                                    <div class="quotation-product-detail">

                                        <div class="quotation-detail-icon">
                                            <i class="bi bi-upc-scan"></i>
                                        </div>

                                        <div>

                                            <div class="quotation-detail-label">
                                                الرقم التعريفي
                                            </div>

                                            <div class="quotation-detail-value">
                                                @Model.Product.SKU
                                            </div>

                                        </div>

                                    </div>
                                }


                                @if (Model.Product?.Category != null)
                                {
                                    <div class="quotation-product-detail">

                                        <div class="quotation-detail-icon">
                                            <i class="bi bi-folder2"></i>
                                        </div>

                                        <div>

                                            <div class="quotation-detail-label">
                                                الفئة
                                            </div>

                                            <div class="quotation-detail-value">
                                                @Model.Product.Category.Name
                                            </div>

                                        </div>

                                    </div>
                                }


                                @if (!string.IsNullOrWhiteSpace(Model.Product?.Material))
                                {
                                    <div class="quotation-product-detail">

                                        <div class="quotation-detail-icon">
                                            <i class="bi bi-layers"></i>
                                        </div>

                                        <div>

                                            <div class="quotation-detail-label">
                                                المادة
                                            </div>

                                            <div class="quotation-detail-value">
                                                @Model.Product.Material
                                            </div>

                                        </div>

                                    </div>
                                }


                                @if (!string.IsNullOrWhiteSpace(Model.Product?.LoadClass))
                                {
                                    <div class="quotation-product-detail">

                                        <div class="quotation-detail-icon">
                                            <i class="bi bi-shield-check"></i>
                                        </div>

                                        <div>

                                            <div class="quotation-detail-label">
                                                فئة التحميل
                                            </div>

                                            <div class="quotation-detail-value">
                                                @Model.Product.LoadClass
                                            </div>

                                        </div>

                                    </div>
                                }


                                @if (!string.IsNullOrWhiteSpace(Model.Product?.Diameter))
                                {
                                    <div class="quotation-product-detail">

                                        <div class="quotation-detail-icon">
                                            <i class="bi bi-arrows-expand"></i>
                                        </div>

                                        <div>

                                            <div class="quotation-detail-label">
                                                القطر
                                            </div>

                                            <div class="quotation-detail-value">
                                                @Model.Product.Diameter
                                            </div>

                                        </div>

                                    </div>
                                }


                                @if (!string.IsNullOrWhiteSpace(Model.Product?.Shape))
                                {
                                    <div class="quotation-product-detail">

                                        <div class="quotation-detail-icon">
                                            <i class="bi bi-circle-square"></i>
                                        </div>

                                        <div>

                                            <div class="quotation-detail-label">
                                                الشكل
                                            </div>

                                            <div class="quotation-detail-value">
                                                @Model.Product.Shape
                                            </div>

                                        </div>

                                    </div>
                                }

                            </div>

                        </div>

                    </div>


                    <!-- Process Note -->
                    <div class="quotation-info-note">

                        <div class="quotation-info-note-icon">
                            <i class="bi bi-info-circle"></i>
                        </div>

                        <div>

                            <div class="quotation-info-note-title">
                                ماذا يحدث بعد إرسال الطلب؟
                            </div>

                            <p class="mb-0">
                                سيقوم فريقنا بمراجعة بياناتك والتواصل معك لمناقشة احتياجاتك وتفاصيل عرض السعر.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- Quotation Form -->
                <div class="col-lg-7">

                    <div class="public-card quotation-form-card">

                        <div class="public-card-header quotation-card-header">

                            <div class="public-card-header-content">

                                <div class="public-card-icon quotation-card-icon">
                                    <i class="bi bi-person-lines-fill"></i>
                                </div>

                                <div>

                                    <h2 class="h5 fw-bold mb-1">
                                        بياناتك
                                    </h2>

                                    <p class="text-muted small mb-0">
                                        يرجى إدخال بيانات التواصل بشكل صحيح حتى نتمكن من التواصل معك.
                                    </p>

                                </div>

                            </div>

                        </div>


                        <div class="public-card-body quotation-form-body">

                            <form asp-action="Create" method="post">

                                <input type="hidden" asp-for="ProductId" />

                                @if (!ViewData.ModelState.IsValid)
                                {
                                    <div asp-validation-summary="All"
                                         class="alert alert-danger quotation-validation-summary"
                                         role="alert">
                                    </div>
                                }


                                <!-- Contact Information -->
                                <section class="quotation-form-section">

                                    <div class="quotation-form-section-header">

                                        <div class="quotation-form-section-number">
                                            01
                                        </div>

                                        <div>

                                            <h3 class="quotation-form-section-title">
                                                بيانات التواصل
                                            </h3>

                                            <p class="quotation-form-section-description">
                                                أدخل بياناتك الأساسية للتواصل معك.
                                            </p>

                                        </div>

                                    </div>


                                    <div class="row g-3">

                                        <div class="col-md-6">

                                            <label asp-for="FullName"
                                                   class="form-label public-form-label">
                                                الاسم الكامل
                                            </label>

                                            <div class="public-input-wrapper quotation-input-wrapper">

                                                <i class="bi bi-person public-input-icon quotation-input-icon"></i>

                                                <input asp-for="FullName"
                                                       class="form-control public-input quotation-input"
                                                       placeholder="أدخل اسمك الكامل" />

                                            </div>

                                            <span asp-validation-for="FullName"
                                                  class="text-danger small">
                                            </span>

                                        </div>


                                        <div class="col-md-6">

                                            <label asp-for="CompanyName"
                                                   class="form-label public-form-label">
                                                اسم الشركة
                                            </label>

                                            <div class="public-input-wrapper quotation-input-wrapper">

                                                <i class="bi bi-building public-input-icon quotation-input-icon"></i>

                                                <input asp-for="CompanyName"
                                                       class="form-control public-input quotation-input"
                                                       placeholder="اسم الشركة (اختياري)" />

                                            </div>

                                            <span asp-validation-for="CompanyName"
                                                  class="text-danger small">
                                            </span>

                                        </div>


                                        <div class="col-md-6">

                                            <label asp-for="Email"
                                                   class="form-label public-form-label">
                                                البريد الإلكتروني
                                            </label>

                                            <div class="public-input-wrapper quotation-input-wrapper">

                                                <i class="bi bi-envelope public-input-icon quotation-input-icon"></i>

                                                <input asp-for="Email"
                                                       class="form-control public-input quotation-input"
                                                       type="email"
                                                       placeholder="name@example.com" />

                                            </div>

                                            <span asp-validation-for="Email"
                                                  class="text-danger small">
                                            </span>

                                        </div>


                                        <div class="col-md-6">

                                            <label asp-for="PhoneNumber"
                                                   class="form-label public-form-label">
                                                رقم الهاتف
                                            </label>

                                            <div class="public-input-wrapper quotation-input-wrapper">

                                                <i class="bi bi-telephone public-input-icon quotation-input-icon"></i>

                                                <input asp-for="PhoneNumber"
                                                       class="form-control public-input quotation-input"
                                                       type="tel"
                                                       placeholder="أدخل رقم هاتفك" />

                                            </div>

                                            <span asp-validation-for="PhoneNumber"
                                                  class="text-danger small">
                                            </span>

                                        </div>

                                    </div>

                                </section>


                                <!-- Request Details -->
                                <section class="quotation-form-section">

                                    <div class="quotation-form-section-header">

                                        <div class="quotation-form-section-number">
                                            02
                                        </div>

                                        <div>

                                            <h3 class="quotation-form-section-title">
                                                تفاصيل الطلب
                                            </h3>

                                            <p class="quotation-form-section-description">
                                                حدد الكمية وأضف أي معلومات تساعدنا على فهم احتياجاتك.
                                            </p>

                                        </div>

                                    </div>


                                    <div class="row g-3">

                                        <div class="col-md-6">

                                            <label asp-for="Quantity"
                                                   class="form-label public-form-label">
                                                الكمية
                                            </label>

                                            <div class="public-input-wrapper quotation-input-wrapper">

                                                <i class="bi bi-boxes public-input-icon quotation-input-icon"></i>

                                                <input asp-for="Quantity"
                                                       class="form-control public-input quotation-input"
                                                       type="number"
                                                       min="1" />

                                            </div>

                                            <span asp-validation-for="Quantity"
                                                  class="text-danger small">
                                            </span>

                                        </div>


                                        <div class="col-12">

                                            <label asp-for="Message"
                                                   class="form-label public-form-label">
                                                الرسالة
                                            </label>

                                            <div class="public-input-wrapper quotation-textarea-wrapper">

                                                <i class="bi bi-chat-left-text public-input-icon quotation-textarea-icon"></i>

                                                <textarea asp-for="Message"
                                                          class="form-control public-input quotation-textarea"
                                                          rows="6"
                                                          placeholder="أخبرنا عن متطلباتك، والمواصفات، واحتياجات التوصيل، أو أي تفاصيل أخرى."></textarea>

                                            </div>

                                            <span asp-validation-for="Message"
                                                  class="text-danger small">
                                            </span>

                                        </div>

                                    </div>

                                </section>


                                <!-- Actions -->
                                <section class="quotation-submit-section">

                                    <div class="quotation-submit-actions">

                                        <button type="submit"
                                                class="btn btn-primary public-btn public-btn-primary public-btn-lg quotation-submit-btn">

                                            <i class="bi bi-send"></i>

                                            <span>
                                                إرسال الطلب
                                            </span>

                                        </button>


                                        <a asp-controller="Catalog"
                                           asp-action="Details"
                                           asp-route-id="@Model.ProductId"
                                           class="btn btn-outline-secondary public-btn public-btn-lg quotation-cancel-btn">

                                            <span>
                                                إلغاء
                                            </span>

                                        </a>

                                    </div>


                                    <div class="quotation-submit-note">

                                        <i class="bi bi-shield-check"></i>

                                        <span>
                                            بإرسال هذا الطلب، فإنك تقدم بيانات التواصل الخاصة بك حتى يتمكن فريقنا من متابعتك بخصوص عرض السعر.
                                        </span>

                                    </div>

                                </section>

                            </form>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/quotation.css"
          asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}