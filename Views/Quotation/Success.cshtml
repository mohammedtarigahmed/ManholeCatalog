@model ManholeCatalog.Models.QuotationRequest

@{
    ViewData["Title"] = "تم إرسال الطلب";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <!-- Success Header -->
            <div class="text-center mb-4">

                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success-subtle text-success mb-3"
                     style="width: 72px; height: 72px;">

                    <span class="fs-2 fw-bold">
                        ✓
                    </span>

                </div>

                <h1 class="display-6 fw-bold mb-3">
                    تم إرسال طلبك بنجاح
                </h1>

                <p class="lead text-muted mb-0">
                    شكرًا لك على طلب عرض السعر.
                    لقد استلمنا طلبك وسنتواصل معك قريبًا.
                </p>

            </div>

            <!-- Request Number -->
            <div class="card border-0 shadow-sm mb-4">

                <div class="card-body text-center p-4">

                    <div class="small text-muted mb-1">
                        رقم الطلب
                    </div>

                    <div class="fs-2 fw-bold text-success">
                        #@Model.Id
                    </div>

                    <div class="small text-muted mt-2">
                        يرجى الاحتفاظ بهذا الرقم للرجوع إليه مستقبلًا.
                    </div>

                </div>

            </div>

            <!-- Request Details -->
            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white py-3">

                    <h2 class="h5 fw-bold mb-1">
                        تفاصيل الطلب
                    </h2>

                    <p class="text-muted small mb-0">
                        ملخص المنتج وطلب عرض السعر.
                    </p>

                </div>

                <div class="card-body p-4">

                    <div class="row g-4">

                        <div class="col-md-6">

                            <div class="text-muted small mb-1">
                                المنتج
                            </div>

                            <div class="fw-semibold">
                                @Model.Product?.Name
                            </div>

                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Product?.SKU))
                        {
                            <div class="col-md-6">

                                <div class="text-muted small mb-1">
                                    الرقم التعريفي
                                </div>

                                <div class="fw-semibold">
                                    @Model.Product.SKU
                                </div>

                            </div>
                        }

                        <div class="col-md-6">

                            <div class="text-muted small mb-1">
                                الكمية
                            </div>

                            <div class="fw-semibold">
                                @Model.Quantity
                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="text-muted small mb-1">
                                الحالة
                            </div>

                            <span class="badge text-bg-warning">
                                قيد المراجعة
                            </span>

                        </div>

                        <div class="col-md-6">

                            <div class="text-muted small mb-1">
                                تاريخ الإرسال
                            </div>

                            <div>
                                @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Contact Information -->
            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white py-3">

                    <h2 class="h5 fw-bold mb-1">
                        بيانات التواصل
                    </h2>

                    <p class="text-muted small mb-0">
                        بيانات التواصل التي تم إدخالها مع الطلب.
                    </p>

                </div>

                <div class="card-body p-4">

                    <div class="row g-4">

                        <div class="col-md-6">

                            <div class="text-muted small mb-1">
                                الاسم الكامل
                            </div>

                            <div class="fw-semibold">
                                @Model.FullName
                            </div>

                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.CompanyName))
                        {
                            <div class="col-md-6">

                                <div class="text-muted small mb-1">
                                    الشركة
                                </div>

                                <div class="fw-semibold">
                                    @Model.CompanyName
                                </div>

                            </div>
                        }

                        <div class="col-md-6">

                            <div class="text-muted small mb-1">
                                البريد الإلكتروني
                            </div>

                            <div>
                                @Model.Email
                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="text-muted small mb-1">
                                رقم الهاتف
                            </div>

                            <div>
                                @Model.PhoneNumber
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Customer Message -->
            @if (!string.IsNullOrWhiteSpace(Model.Message))
            {
                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white py-3">

                        <h2 class="h5 fw-bold mb-1">
                            رسالتك
                        </h2>

                        <p class="text-muted small mb-0">
                            المتطلبات الإضافية التي أرسلتها مع الطلب.
                        </p>

                    </div>

                    <div class="card-body p-4">

                        <div style="white-space: pre-line;">
                            @Model.Message
                        </div>

                    </div>

                </div>
            }

            <!-- Next Steps -->
            <div class="card border-0 shadow-sm mb-4">

                <div class="card-body p-4">

                    <h2 class="h5 fw-bold mb-3">
                        ماذا سيحدث بعد ذلك؟
                    </h2>

                    <div class="d-flex gap-3 mb-3">

                        <div class="d-flex align-items-center justify-content-center rounded-circle bg-light flex-shrink-0"
                             style="width: 40px; height: 40px;">

                            <span class="fw-bold text-primary">
                                1
                            </span>

                        </div>

                        <div>

                            <div class="fw-semibold">
                                مراجعة الطلب
                            </div>

                            <div class="text-muted small">
                                سيقوم فريقنا بمراجعة طلب عرض السعر.
                            </div>

                        </div>

                    </div>

                    <div class="d-flex gap-3 mb-3">

                        <div class="d-flex align-items-center justify-content-center rounded-circle bg-light flex-shrink-0"
                             style="width: 40px; height: 40px;">

                            <span class="fw-bold text-primary">
                                2
                            </span>

                        </div>

                        <div>

                            <div class="fw-semibold">
                                التواصل معك
                            </div>

                            <div class="text-muted small">
                                سنتواصل معك باستخدام بيانات التواصل التي قدمتها.
                            </div>

                        </div>

                    </div>

                    <div class="d-flex gap-3">

                        <div class="d-flex align-items-center justify-content-center rounded-circle bg-light flex-shrink-0"
                             style="width: 40px; height: 40px;">

                            <span class="fw-bold text-primary">
                                3
                            </span>

                        </div>

                        <div>

                            <div class="fw-semibold">
                                عرض السعر
                            </div>

                            <div class="text-muted small">
                                سيناقش فريقنا معك تفاصيل عرض السعر.
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Navigation -->
            <div class="text-center">

                <div class="d-flex justify-content-center gap-2 flex-wrap">

                    <a asp-controller="Catalog"
                       asp-action="Details"
                       asp-route-id="@Model.ProductId"
                       class="btn btn-primary">
                        العودة إلى المنتج
                    </a>

                    <a asp-controller="Catalog"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        تصفح الكتالوج
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>