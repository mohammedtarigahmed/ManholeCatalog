@{
    ViewData["Title"] = "الشروط والأحكام";
}

<div class="public-page terms-page">

    <section class="public-page-header terms-header">

        <div class="container">

            <div class="public-page-header-content">

                <span class="public-page-label">
                    <i class="bi bi-file-earmark-text"></i>
                    الشروط والأحكام
                </span>

                <h1 class="public-page-title">
                    الشروط والأحكام
                </h1>

                <p class="public-page-description">
                    توضح هذه الشروط والأحكام القواعد العامة لاستخدام الموقع
                    والخدمات المتاحة من خلاله.
                </p>

            </div>

        </div>

    </section>

    <section class="public-section terms-section">

        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-9">

                    <div class="public-card terms-card">

                        <div class="public-card-header">

                            <div class="public-card-header-content">

                                <div class="public-card-icon">
                                    <i class="bi bi-file-earmark-check"></i>
                                </div>

                                <div>
                                    <h2 class="h5 fw-bold mb-1">
                                        الشروط والأحكام
                                    </h2>

                                    <p class="text-muted small mb-0">
                                        القواعد العامة لاستخدام الموقع والخدمات.
                                    </p>
                                </div>

                            </div>

                        </div>

                        <div class="public-card-body terms-content">

                            <section class="terms-item">

                                <h2 class="terms-item-title">
                                    1. مقدمة
                                </h2>

                                <p>
                                    باستخدامك لهذا الموقع، فإنك تقر بقراءة هذه الشروط
                                    وفهمها والموافقة على الالتزام بها. إذا كنت لا توافق
                                    على أي من هذه الشروط، يرجى عدم استخدام الموقع أو
                                    الخدمات المتاحة من خلاله.
                                </p>

                            </section>

                            <section class="terms-item">

                                <h2 class="terms-item-title">
                                    2. استخدام الموقع
                                </h2>

                                <p>
                                    يهدف الموقع إلى عرض المنتجات وتقديم معلومات عنها
                                    وتمكين المستخدمين من التواصل معنا وطلب عروض أسعار.
                                </p>

                                <p>
                                    يلتزم المستخدم باستخدام الموقع بطريقة مشروعة وعدم
                                    استخدامه لأي غرض غير قانوني أو بطريقة قد تؤثر على
                                    تشغيل الموقع أو أمنه أو حقوق الآخرين.
                                </p>

                            </section>

                            <section class="terms-item">

                                <h2 class="terms-item-title">
                                    3. معلومات المنتجات
                                </h2>

                                <p>
                                    يتم عرض معلومات المنتجات في الموقع لأغراض التعريف
                                    والمساعدة في اختيار المنتجات المناسبة. قد تختلف
                                    بعض المواصفات أو التوافر أو الأسعار حسب المنتج
                                    والمشروع والوقت، ويتم تأكيد التفاصيل عند التواصل
                                    معنا أو عند إعداد عرض السعر.
                                </p>

                            </section>

                            <section class="terms-item">

                                <h2 class="terms-item-title">
                                    4. طلبات عروض الأسعار
                                </h2>

                                <p>
                                    إرسال طلب عرض سعر من خلال الموقع لا يعني إتمام عملية
                                    شراء أو وجود التزام تعاقدي من أي طرف.
                                </p>

                                <p>
                                    تخضع الأسعار والكميات والمواصفات والتوافر وأي شروط
                                    تجارية أخرى للتأكيد من جانبنا قبل إتمام أي عملية
                                    بيع أو توريد.
                                </p>

                            </section>

                            <section class="terms-item">

                                <h2 class="terms-item-title">
                                    5. دقة المعلومات المقدمة من المستخدم
                                </h2>

                                <p>
                                    يلتزم المستخدم بتقديم معلومات صحيحة ودقيقة عند
                                    إرسال طلبات عروض الأسعار أو رسائل التواصل، ويتحمل
                                    مسؤولية صحة المعلومات التي يقدمها من خلال الموقع.
                                </p>

                            </section>

                            <section class="terms-item">

                                <h2 class="terms-item-title">
                                    6. الملكية الفكرية
                                </h2>

                                <p>
                                    جميع المحتويات الموجودة في الموقع، بما في ذلك النصوص
                                    والصور والتصاميم والشعارات والمحتوى البرمجي، تكون
                                    مملوكة لنا أو مستخدمة بموجب حقوق أو تراخيص مناسبة،
                                    ولا يجوز نسخها أو إعادة استخدامها أو توزيعها دون
                                    الحصول على إذن مسبق، ما لم يسمح النظام بذلك.
                                </p>

                            </section>

                            <section class="terms-item">

                                <h2 class="terms-item-title">
                                    7. الروابط والخدمات الخارجية
                                </h2>

                                <p>
                                    قد يحتوي الموقع على روابط أو وسائل للتواصل مع
                                    خدمات خارجية مثل WhatsApp وGoogle Maps ومنصات
                                    التواصل الاجتماعي. استخدام هذه الخدمات يخضع
                                    للشروط والسياسات الخاصة بمقدمي تلك الخدمات.
                                </p>

                            </section>

                            <section class="terms-item">

                                <h2 class="terms-item-title">
                                    8. توفر الموقع
                                </h2>

                                <p>
                                    نسعى إلى الحفاظ على توفر الموقع وعمله بصورة مستقرة،
                                    إلا أنه قد يتوقف مؤقتًا بسبب الصيانة أو التحديثات
                                    أو الأعطال التقنية أو ظروف خارجة عن نطاق سيطرتنا.
                                </p>

                            </section>

                            <section class="terms-item">

                                <h2 class="terms-item-title">
                                    9. حدود المسؤولية
                                </h2>

                                <p>
                                    يتم تقديم المعلومات والخدمات المتاحة عبر الموقع
                                    وفقًا لما هو متاح في وقت الاستخدام. يجب التحقق من
                                    المواصفات والأسعار والتفاصيل النهائية قبل اتخاذ أي
                                    قرار شراء أو تنفيذ مشروع.
                                </p>

                            </section>

                            <section class="terms-item">

                                <h2 class="terms-item-title">
                                    10. التعديلات على الشروط
                                </h2>

                                <p>
                                    نحتفظ بالحق في تحديث أو تعديل هذه الشروط والأحكام
                                    عند الحاجة. تصبح التعديلات نافذة عند نشر النسخة
                                    المحدثة على هذه الصفحة.
                                </p>

                            </section>

                            <section class="terms-item terms-item-last">

                                <h2 class="terms-item-title">
                                    11. التواصل معنا
                                </h2>

                                <p>
                                    إذا كان لديك أي استفسار يتعلق بهذه الشروط أو
                                    باستخدام الموقع، يمكنك التواصل معنا من خلال
                                    صفحة "تواصل معنا".
                                </p>

                            </section>

                        </div>

                    </div>

                    <div class="terms-updated">
                        <i class="bi bi-clock-history"></i>
                        <span>
                            آخر تحديث: @DateTime.Now.ToString("dd/MM/yyyy")
                        </span>
                    </div>

                </div>

            </div>

        </div>

    </section>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/terms.css"
          asp-append-version="true" />
}