@{
    ViewData["Title"] = "من نحن";
}

<div class="public-page about-page">

    <section class="public-page-header about-header">

        <div class="container">

            <div class="public-page-header-content about-header-content">

                <span class="public-page-label">
                    <i class="bi bi-building"></i>
                    من نحن
                </span>

                <h1 class="public-page-title about-title">
                    منصة واضحة لعرض المنتجات
                    <span>وإدارة احتياجات العملاء</span>
                </h1>

                <p class="public-page-description about-description">
                    نوفر تجربة منظمة لعرض المنتجات ومواصفاتها،
                    مع التركيز على سهولة الوصول إلى المعلومات والتواصل وطلب عروض الأسعار.
                </p>

                <div class="about-header-actions">

                    <a asp-controller="Catalog"
                       asp-action="Index"
                       class="btn btn-primary public-btn public-btn-primary public-btn-lg">

                        <i class="bi bi-grid-3x3-gap"></i>

                        <span>
                            استعرض المنتجات
                        </span>

                    </a>

                    <a asp-controller="Contact"
                       asp-action="Index"
                       class="btn btn-primary public-btn public-btn-primary public-btn-lg">
                        <i class="bi bi-chat-dots"></i>
                        <span>تواصل معنا</span>
                    </a>

                </div>

            </div>

        </div>

    </section>


    <section class="public-section about-intro-section">

        <div class="container">

            <div class="about-intro-grid">

                <div class="about-intro-heading">

                    <span class="public-page-label">
                        <i class="bi bi-info-circle"></i>
                        نبذة عنا
                    </span>

                    <h2 class="about-section-title">
                        نركز على المنتج،
                        <span>المواصفات، وسهولة الوصول</span>
                    </h2>

                </div>

                <div class="about-intro-text">

                    <p>
                        نعمل على توفير تجربة واضحة ومنظمة لعرض المنتجات
                        ومواصفاتها، بحيث يستطيع العميل الوصول إلى المنتج المناسب
                        ومعرفة تفاصيله والتواصل معنا بسهولة.
                    </p>

                    <p>
                        تم تصميم المنصة لتخدم الأفراد والشركات والمشاريع المختلفة،
                        مع إمكانية طلب عرض سعر مباشرة من خلال الموقع.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <section class="public-section about-features-section">

        <div class="container">

            <div class="about-section-heading">

                <span class="public-page-label">
                    <i class="bi bi-box-seam"></i>
                    ما نقدمه
                </span>

                <h2 class="about-section-title">
                    كل ما تحتاجه للوصول إلى المنتج المناسب
                </h2>

                <p class="about-section-description">
                    نركز على تقديم معلومات واضحة وخطوات بسيطة من استعراض المنتج
                    وحتى التواصل وطلب عرض السعر.
                </p>

            </div>


            <div class="row g-4">

                <div class="col-md-6 col-lg-3">

                    <div class="public-card about-feature-card">

                        <div class="public-card-body">

                            <div class="about-feature-icon">
                                <i class="bi bi-grid-3x3-gap"></i>
                            </div>

                            <h3>
                                كتالوج منظم
                            </h3>

                            <p>
                                استعرض المنتجات والفئات بطريقة واضحة وسهلة
                                للوصول إلى المنتج المطلوب.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="col-md-6 col-lg-3">

                    <div class="public-card about-feature-card">

                        <div class="public-card-body">

                            <div class="about-feature-icon">
                                <i class="bi bi-card-checklist"></i>
                            </div>

                            <h3>
                                مواصفات واضحة
                            </h3>

                            <p>
                                عرض أهم تفاصيل المنتج لمساعدتك على فهم
                                خصائصه ومتطلباته.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="col-md-6 col-lg-3">

                    <div class="public-card about-feature-card">

                        <div class="public-card-body">

                            <div class="about-feature-icon">
                                <i class="bi bi-file-earmark-text"></i>
                            </div>

                            <h3>
                                طلب عرض سعر
                            </h3>

                            <p>
                                يمكنك إرسال طلب عرض سعر للمنتج مع الكمية
                                والبيانات المطلوبة بسهولة.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="col-md-6 col-lg-3">

                    <div class="public-card about-feature-card">

                        <div class="public-card-body">

                            <div class="about-feature-icon about-whatsapp-icon">
                                <i class="bi bi-whatsapp"></i>
                            </div>

                            <h3>
                                تواصل مباشر
                            </h3>

                            <p>
                                خيارات متعددة للتواصل والاستفسار ومتابعة
                                احتياجاتك بشكل مباشر.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <section class="public-section about-values-section">

        <div class="container">

            <div class="public-card about-values-card">

                <div class="public-card-body about-values-content">

                    <span class="public-page-label">
                        <i class="bi bi-check2-circle"></i>
                        لماذا نحن؟
                    </span>

                    <h2 class="about-section-title">
                        تجربة بسيطة وواضحة
                    </h2>

                    <p>
                        نؤمن بأن الوصول إلى المنتج المناسب يجب أن يكون واضحًا
                        وسهلًا، لذلك نركز على تنظيم المعلومات وتبسيط خطوات
                        الاستعراض والتواصل وطلب عروض الأسعار.
                    </p>

                </div>


                <div class="public-card-body about-values-list">

                    <div class="about-value-item">

                        <div class="about-value-icon">
                            <i class="bi bi-check-lg"></i>
                        </div>

                        <div>
                            <strong>وضوح المعلومات</strong>
                            <span>معلومات المنتجات منظمة وسهلة القراءة.</span>
                        </div>

                    </div>


                    <div class="about-value-item">

                        <div class="about-value-icon">
                            <i class="bi bi-check-lg"></i>
                        </div>

                        <div>
                            <strong>سهولة الوصول</strong>
                            <span>الوصول إلى المنتجات والفئات بطريقة مباشرة.</span>
                        </div>

                    </div>


                    <div class="about-value-item">

                        <div class="about-value-icon">
                            <i class="bi bi-check-lg"></i>
                        </div>

                        <div>
                            <strong>تواصل مرن</strong>
                            <span>إمكانية التواصل والاستفسار بالطريقة المناسبة.</span>
                        </div>

                    </div>


                    <div class="about-value-item">

                        <div class="about-value-icon">
                            <i class="bi bi-check-lg"></i>
                        </div>

                        <div>
                            <strong>مناسب للمشاريع</strong>
                            <span>مناسب للأفراد والشركات والمشاريع المختلفة.</span>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <section class="public-section about-process-section">

        <div class="container">

            <div class="about-section-heading">

                <span class="public-page-label">
                    <i class="bi bi-diagram-3"></i>
                    كيف تعمل؟
                </span>

                <h2 class="about-section-title">
                    من المنتج إلى طلب عرض السعر
                </h2>

            </div>


            <div class="about-process-grid">

                <div class="public-card about-process-card">

                    <div class="public-card-body">

                        <div class="about-process-number">
                            01
                        </div>

                        <div class="about-process-icon">
                            <i class="bi bi-search"></i>
                        </div>

                        <h3>
                            استعرض المنتجات
                        </h3>

                        <p>
                            تصفح الكتالوج وابحث عن المنتج المناسب لاحتياجك.
                        </p>

                    </div>

                </div>


                <div class="public-card about-process-card">

                    <div class="public-card-body">

                        <div class="about-process-number">
                            02
                        </div>

                        <div class="about-process-icon">
                            <i class="bi bi-card-text"></i>
                        </div>

                        <h3>
                            راجع التفاصيل
                        </h3>

                        <p>
                            اطلع على المواصفات والتفاصيل والصور المتوفرة للمنتج.
                        </p>

                    </div>

                </div>


                <div class="public-card about-process-card">

                    <div class="public-card-body">

                        <div class="about-process-number">
                            03
                        </div>

                        <div class="about-process-icon">
                            <i class="bi bi-file-earmark-plus"></i>
                        </div>

                        <h3>
                            أرسل طلبك
                        </h3>

                        <p>
                            أدخل الكمية والبيانات المطلوبة وأرسل طلب عرض السعر.
                        </p>

                    </div>

                </div>


                <div class="public-card about-process-card">

                    <div class="public-card-body">

                        <div class="about-process-number">
                            04
                        </div>

                        <div class="about-process-icon">
                            <i class="bi bi-headset"></i>
                        </div>

                        <h3>
                            نتواصل معك
                        </h3>

                        <p>
                            يتم التواصل معك لمتابعة طلبك والرد على استفساراتك.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <section class="public-section about-cta-section">

        <div class="container">

            <div class="about-cta-card">

                <div class="about-cta-content">

                    <span class="public-page-label">
                        <i class="bi bi-chat-square-text"></i>
                        هل لديك استفسار؟
                    </span>

                    <h2>
                        نحن هنا لمساعدتك
                    </h2>

                    <p>
                        استعرض منتجاتنا أو تواصل معنا لمعرفة المزيد
                        وطلب عرض سعر.
                    </p>

                </div>


                <div class="about-cta-actions">

                    <a asp-controller="Catalog"
                       asp-action="Index"
                       class="btn btn-light public-btn public-btn-lg">

                        <span>
                            استعرض المنتجات
                        </span>

                        <i class="bi bi-arrow-left"></i>

                    </a>

                    <a asp-controller="Contact"
                       asp-action="Index"
                       class="btn btn-outline-light public-btn public-btn-lg">

                        <span>
                            تواصل معنا
                        </span>

                    </a>

                </div>

            </div>

        </div>

    </section>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/about.css"
          asp-append-version="true" />
}