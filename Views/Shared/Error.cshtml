@model ErrorViewModel

@{
    ViewData["Title"] = "حدث خطأ";
}

<div class="public-page error-page">

    <section class="public-section error-section">

        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-8">

                    <div class="public-card error-card">

                        <div class="public-card-body error-card-body">

                            <div class="error-icon">
                                <i class="bi bi-exclamation-lg"></i>
                            </div>

                            <span class="public-page-label error-label">
                                <i class="bi bi-info-circle"></i>
                                تعذر إكمال العملية
                            </span>

                            <h1 class="public-page-title error-title">
                                حدث خطأ
                            </h1>

                            <p class="public-page-description error-description">
                                تعذر إكمال طلبك.
                                يرجى المحاولة مرة أخرى أو العودة إلى الكتالوج.
                            </p>

                            @if (Model.ShowRequestId)
                            {
                                <div class="error-request-card">

                                    <div class="error-request-icon">
                                        <i class="bi bi-fingerprint"></i>
                                    </div>

                                    <div class="error-request-content">
                                        <span>رقم الطلب</span>

                                        <code>@Model.RequestId</code>

                                        <small>
                                            يمكنك استخدام هذا الرقم عند التواصل مع الدعم.
                                        </small>
                                    </div>

                                </div>
                            }

                            <div class="error-actions">

                                <a asp-controller="Home"
                                   asp-action="Index"
                                   class="btn btn-primary public-btn public-btn-primary public-btn-lg">
                                    <i class="bi bi-house"></i>
                                    <span>العودة إلى الرئيسية</span>
                                </a>

                                <a asp-controller="Catalog"
                                   asp-action="Index"
                                   class="btn btn-outline-secondary public-btn public-btn-lg">
                                    <i class="bi bi-grid"></i>
                                    <span>تصفح الكتالوج</span>
                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/error.css"
          asp-append-version="true" />
}