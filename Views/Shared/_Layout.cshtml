@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - سما كتالوج</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ManholeCatalog.styles.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="d-flex flex-column min-vh-100">

    <header>

        <nav class="navbar navbar-expand-lg public-navbar">

            <div class="container">

                <!-- Brand -->
                <a class="navbar-brand public-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="public-brand-icon">
                        <i class="bi bi-grid-3x3-gap-fill"></i>
                    </span>

                    <span class="public-brand-text">
                        سما كتالوج
                    </span>

                </a>


                <!-- Mobile Toggle -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#publicNavbar"
                        aria-controls="publicNavbar"
                        aria-expanded="false"
                        aria-label="فتح القائمة">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- Navigation -->
                <div class="collapse navbar-collapse" id="publicNavbar">

                    <ul class="navbar-nav mx-auto mb-3 mb-lg-0">

                        <li class="nav-item">

                            <a class="nav-link @(currentController == "Home" ? "active" : "")"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">

                                <span>الرئيسية</span>

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link @(currentController == "Catalog" ? "active" : "")"
                               asp-area=""
                               asp-controller="Catalog"
                               asp-action="Index">

                                <span>الكتالوج</span>

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link @(currentController == "About" ? "active" : "")"
                               asp-area=""
                               asp-controller="About"
                               asp-action="Index">

                                <span>من نحن</span>

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link @(currentController == "Contact" ? "active" : "")"
                               asp-area=""
                               asp-controller="Contact"
                               asp-action="Index">

                                <span>تواصل معنا</span>

                            </a>

                        </li>

                    </ul>


                    <!-- Primary CTA -->
                    <div class="public-navbar-action">

                        <a class="btn public-btn public-btn-primary public-navbar-cta"
                           asp-area=""
                           asp-controller="Catalog"
                           asp-action="Index">

                            <span>استكشف الكتالوج</span>

                            <i class="bi bi-arrow-left"></i>

                        </a>

                    </div>

                </div>

            </div>

        </nav>

    </header>


    <main class="flex-grow-1 public-main">

        @RenderBody()

    </main>


    <footer class="public-footer">

        <div class="container public-footer-main">

            <div class="row g-4 g-lg-5">

                <div class="col-lg-6">

                    <div class="public-footer-brand">

                        <span class="public-footer-brand-icon">
                            <i class="bi bi-grid-3x3-gap-fill"></i>
                        </span>

                        <h5 class="public-footer-title">
                            سما كتالوج
                        </h5>

                    </div>

                    <p class="public-footer-text mb-0">
                        منصة كتالوج منتجات تساعد الشركات على عرض منتجاتها
                        ومواصفاتها وتنظيم طلبات عروض الأسعار بسهولة.
                    </p>

                </div>


                <div class="col-sm-6 col-lg-3">

                    <h6 class="public-footer-heading">
                        روابط سريعة
                    </h6>

                    <nav class="public-footer-links">

                        <a asp-area=""
                           asp-controller="Home"
                           asp-action="Index">

                            <span>الرئيسية</span>

                        </a>

                        <a asp-area=""
                           asp-controller="Catalog"
                           asp-action="Index">

                            <span>الكتالوج</span>

                        </a>

                        <a asp-area=""
                           asp-controller="About"
                           asp-action="Index">

                            <span>من نحن</span>

                        </a>

                        <a asp-area=""
                           asp-controller="Contact"
                           asp-action="Index">

                            <span>تواصل معنا</span>

                        </a>

                        <a asp-area=""
                           asp-controller="Privacy"
                           asp-action="Index">

                            <span>سياسة الخصوصية</span>

                        </a>

                        <a asp-area=""
                           asp-controller="Terms"
                           asp-action="Index">

                            <span>الشروط والأحكام</span>

                        </a>

                    </nav>

                </div>


                <div class="col-sm-6 col-lg-3">

                    <h6 class="public-footer-heading">
                        المنصة
                    </h6>

                    <div class="public-footer-service">

                        <i class="bi bi-check2-circle public-footer-service-icon"></i>

                        <span>
                            عرض المنتجات والمواصفات.
                        </span>

                    </div>

                    <div class="public-footer-service">

                        <i class="bi bi-check2-circle public-footer-service-icon"></i>

                        <span>
                            تنظيم طلبات عروض الأسعار.
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <div class="public-footer-bottom">

            <div class="container py-3">

                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">

                    <div>
                        &copy; @DateTime.Now.Year - سما كتالوج
                    </div>

                    <div>
                        منصة كتالوج المنتجات
                    </div>

                </div>

            </div>

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>