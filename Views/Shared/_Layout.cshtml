<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - كتالوج المناهل
    </title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ManholeCatalog.styles.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100">

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">

                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    كتالوج المناهل
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNavbar" aria-controls="publicNavbar" aria-expanded="false" aria-label="فتح القائمة">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="publicNavbar">

                    <ul class="navbar-nav mb-3 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                الرئيسية
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Catalog" asp-action="Index">
                                الكتالوج
                            </a>
                        </li>

                    </ul>

                    <div class="d-flex align-items-center gap-2 me-auto">

                        <a class="btn btn-outline-light btn-sm" asp-area="Admin" asp-controller="Home" asp-action="Index">
                            الإدارة
                        </a>

                    </div>

                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="border-top bg-light text-muted mt-5">

        <div class="container py-5">

            <div class="row g-4">

                <div class="col-md-6">

                    <h5 class="fw-bold text-dark mb-3">
                        كتالوج المناهل
                    </h5>

                    <p class="mb-0">
                        استكشف كتالوج المنتجات، وراجع المواصفات،
                        واطلب عروض الأسعار لمشروعك.
                    </p>

                </div>

                <div class="col-sm-6 col-md-3">

                    <h6 class="fw-bold text-dark mb-3">
                        روابط سريعة
                    </h6>

                    <ul class="list-unstyled mb-0">

                        <li class="mb-2">
                            <a class="text-decoration-none text-muted" asp-area="" asp-controller="Home" asp-action="Index">
                                الرئيسية
                            </a>
                        </li>

                        <li>
                            <a class="text-decoration-none text-muted" asp-area="" asp-controller="Catalog" asp-action="Index">
                                الكتالوج
                            </a>
                        </li>

                    </ul>

                </div>

                <div class="col-sm-6 col-md-3">

                    <h6 class="fw-bold text-dark mb-3">
                        المنتجات والخدمات
                    </h6>

                    <p class="mb-0">
                        تصفح المنتجات، وراجع المواصفات،
                        وأرسل طلبات عروض الأسعار.
                    </p>

                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">

                <div class="small">
                    &copy; @DateTime.Now.Year - كتالوج المناهل
                </div>

                <div class="small">
                    كتالوج المنتجات ونظام طلبات عروض الأسعار
                </div>

            </div>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>