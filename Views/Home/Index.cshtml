@{
    ViewData["Title"] = "Home";
}

<div class="container">

    <!-- Hero Section -->
    <section class="py-5">

        <div class="row align-items-center g-5 py-lg-5">

            <div class="col-lg-7">

                <div class="mb-3">
                    <span class="badge text-bg-primary px-3 py-2">
                        Manhole Covers &amp; Related Products
                    </span>
                </div>

                <h1 class="display-4 fw-bold lh-sm mb-4">
                    Find the Right
                    <span class="text-primary">Manhole Products</span>
                    for Your Project.
                </h1>

                <p class="lead text-muted mb-4">
                    Explore our product catalog, compare specifications,
                    and request a quotation for the products you need.
                </p>

                <div class="d-flex flex-wrap gap-2">

                    <a asp-controller="Catalog"
                       asp-action="Index"
                       class="btn btn-primary btn-lg px-4">
                        Browse Catalog
                    </a>

                    <a asp-controller="Catalog"
                       asp-action="Index"
                       class="btn btn-outline-secondary btn-lg px-4">
                        View Products
                    </a>

                </div>

            </div>

            <div class="col-lg-5">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body p-5 text-center">

                        <div class="display-1 mb-4">
                            🕳️
                        </div>

                        <h2 class="h3 fw-bold mb-3">
                            Product Catalog
                        </h2>

                        <p class="text-muted mb-4">
                            Find products by category, review
                            specifications, and submit your quotation
                            request directly from the catalog.
                        </p>

                        <div class="d-flex justify-content-center gap-4">

                            <div>
                                <div class="fs-3 fw-bold text-primary">
                                    01
                                </div>
                                <div class="small text-muted">
                                    Browse
                                </div>
                            </div>

                            <div>
                                <div class="fs-3 fw-bold text-primary">
                                    02
                                </div>
                                <div class="small text-muted">
                                    Choose
                                </div>
                            </div>

                            <div>
                                <div class="fs-3 fw-bold text-primary">
                                    03
                                </div>
                                <div class="small text-muted">
                                    Request
                                </div>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- Main Features -->
    <section class="py-5">

        <div class="text-center mb-5">

            <h2 class="fw-bold mb-3">
                Everything You Need in One Place
            </h2>

            <p class="text-muted mb-0">
                A simple way to explore products and request quotations.
            </p>

        </div>

        <div class="row g-4">

            <div class="col-md-4">

                <div class="card h-100 border-0 shadow-sm">

                    <div class="card-body p-4">

                        <div class="fs-1 mb-3">
                            📋
                        </div>

                        <h3 class="h5 fw-bold mb-3">
                            Product Catalog
                        </h3>

                        <p class="text-muted mb-0">
                            Browse available products and quickly find
                            what you need using search and category filters.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card h-100 border-0 shadow-sm">

                    <div class="card-body p-4">

                        <div class="fs-1 mb-3">
                            ⚙️
                        </div>

                        <h3 class="h5 fw-bold mb-3">
                            Product Specifications
                        </h3>

                        <p class="text-muted mb-0">
                            Review important details such as material,
                            load class, diameter, shape, and other
                            available specifications.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card h-100 border-0 shadow-sm">

                    <div class="card-body p-4">

                        <div class="fs-1 mb-3">
                            💬
                        </div>

                        <h3 class="h5 fw-bold mb-3">
                            Request a Quote
                        </h3>

                        <p class="text-muted mb-0">
                            Send your requirements through a simple
                            quotation request and our team can follow up
                            with you.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- How It Works -->
    <section class="py-5">

        <div class="card border-0 shadow-sm">

            <div class="card-body p-4 p-lg-5">

                <div class="text-center mb-5">

                    <h2 class="fw-bold mb-3">
                        How It Works
                    </h2>

                    <p class="text-muted mb-0">
                        Get from product discovery to quotation in a few simple steps.
                    </p>

                </div>

                <div class="row g-4 text-center">

                    <div class="col-md-4">

                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3"
                             style="width: 64px; height: 64px;">

                            <span class="fs-4 fw-bold text-primary">
                                1
                            </span>

                        </div>

                        <h3 class="h5 fw-bold">
                            Browse
                        </h3>

                        <p class="text-muted mb-0">
                            Explore the catalog and find a product
                            that matches your requirements.
                        </p>

                    </div>

                    <div class="col-md-4">

                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3"
                             style="width: 64px; height: 64px;">

                            <span class="fs-4 fw-bold text-primary">
                                2
                            </span>

                        </div>

                        <h3 class="h5 fw-bold">
                            Review
                        </h3>

                        <p class="text-muted mb-0">
                            Check product specifications and available
                            information before making your request.
                        </p>

                    </div>

                    <div class="col-md-4">

                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3"
                             style="width: 64px; height: 64px;">

                            <span class="fs-4 fw-bold text-primary">
                                3
                            </span>

                        </div>

                        <h3 class="h5 fw-bold">
                            Request
                        </h3>

                        <p class="text-muted mb-0">
                            Submit your quotation request with your
                            contact details and required quantity.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- Call to Action -->
    <section class="py-5 mb-4">

        <div class="card border-0 shadow-sm bg-light">

            <div class="card-body text-center p-5">

                <h2 class="fw-bold mb-3">
                    Ready to Find Your Product?
                </h2>

                <p class="text-muted mb-4">
                    Explore the catalog and request a quotation
                    for the products you need.
                </p>

                <a asp-controller="Catalog"
                   asp-action="Index"
                   class="btn btn-primary btn-lg px-4">
                    Explore Catalog
                </a>

            </div>

        </div>

    </section>

</div>