@model ManholeCatalog.Models.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "الرئيسية";

    var heroProduct = Model.FeaturedProducts.FirstOrDefault();

    var heroImage = heroProduct?.Images.FirstOrDefault(i => i.IsPrimary)
        ?? heroProduct?.Images.OrderBy(i => i.DisplayOrder).FirstOrDefault();
}

<div class="public-page home-page">

    <!-- Hero -->
    <section class="home-hero">
        <div class="container">
            <div class="row align-items-center g-5">

                <div class="col-lg-6">

                    <div class="home-hero-content">

                        <span class="public-page-label">
                            <i class="bi bi-grid"></i>
                            منصة كتالوج المنتجات
                        </span>

                        <h1 class="home-hero-title">
                            اعرض منتجاتك
                            <span>بشكل احترافي</span>
                        </h1>

                        <p class="home-hero-description">
                            منصة تساعد الشركات على عرض منتجاتها ومواصفاتها
                            وتنظيم طلبات عروض الأسعار من مكان واحد.
                        </p>

                        <div class="home-hero-actions">

                            <a class="btn btn-primary public-btn public-btn-primary public-btn-lg"
                               asp-controller="Catalog"
                               asp-action="Index">

                                <span>استكشف الكتالوج</span>
                                <i class="bi bi-arrow-left"></i>

                            </a>

                            <a class="btn btn-outline-secondary public-btn public-btn-lg"
                               asp-controller="About"
                               asp-action="Index">

                                <span>تعرف علينا</span>

                            </a>

                        </div>

                    </div>

                </div>


                <div class="col-lg-6">

                    @if (heroProduct != null)
                    {
                        <div class="home-hero-product public-card">

                            <div class="home-hero-product-image">

                                @if (heroImage != null)
                                {
                                    <img src="@heroImage.ImagePath"
                                         alt="@heroImage.AltText"
                                         class="home-hero-product-image-content" />
                                }
                                else
                                {
                                    <div class="home-hero-product-placeholder">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }

                            </div>

                            <div class="public-card-body">

                                <div class="home-product-meta">

                                    @if (heroProduct.Category != null)
                                    {
                                        <span class="public-badge">
                                            <i class="bi bi-grid"></i>
                                            <span>@heroProduct.Category.Name</span>
                                        </span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(heroProduct.SKU))
                                    {
                                        <span class="home-product-sku">
                                            @heroProduct.SKU
                                        </span>
                                    }

                                </div>

                                <h2 class="home-hero-product-title">
                                    @heroProduct.Name
                                </h2>

                                @if (!string.IsNullOrWhiteSpace(heroProduct.Description))
                                {
                                    <p class="home-hero-product-description">
                                        @heroProduct.Description
                                    </p>
                                }

                                <a class="home-product-link"
                                   asp-controller="Catalog"
                                   asp-action="Details"
                                   asp-route-id="@heroProduct.Id">

                                    <span>عرض المنتج</span>
                                    <i class="bi bi-arrow-left"></i>

                                </a>

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="public-empty-state">

                            <div class="public-empty-icon">
                                <i class="bi bi-box-seam"></i>
                            </div>

                            <h2 class="h4 fw-bold mb-2">
                                المنتجات قيد الإعداد
                            </h2>

                            <p class="text-muted mb-0">
                                سيتم عرض المنتجات هنا عند إضافتها إلى الكتالوج.
                            </p>

                        </div>
                    }

                </div>

            </div>
        </div>
    </section>


    <!-- Featured Products -->
    @if (Model.FeaturedProducts.Any())
    {
        <section class="public-section home-featured-section">

            <div class="container">

                <div class="home-section-heading">

                    <div>

                        <span class="public-page-label mb-2">
                            <i class="bi bi-stars"></i>
                            منتجات مختارة
                        </span>

                        <h2 class="home-section-title">
                            استكشف منتجاتنا
                        </h2>

                        <p class="home-section-description">
                            مجموعة من المنتجات المتاحة حاليًا في الكتالوج.
                        </p>

                    </div>

                    <a class="btn btn-outline-secondary public-btn"
                       asp-controller="Catalog"
                       asp-action="Index">

                        <span>عرض الكل</span>
                        <i class="bi bi-arrow-left"></i>

                    </a>

                </div>


                <div class="row g-4">

                    @foreach (var product in Model.FeaturedProducts)
                    {
                        var productImage = product.Images.FirstOrDefault(i => i.IsPrimary)
                            ?? product.Images.OrderBy(i => i.DisplayOrder).FirstOrDefault();

                        <div class="col-md-6 col-lg-4">

                            <article class="home-product-card public-card">

                                <a class="home-product-image-wrapper"
                                   asp-controller="Catalog"
                                   asp-action="Details"
                                   asp-route-id="@product.Id">

                                    @if (productImage != null)
                                    {
                                        <img src="@productImage.ImagePath"
                                             alt="@productImage.AltText"
                                             class="home-product-image" />
                                    }
                                    else
                                    {
                                        <div class="home-product-no-image">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    }

                                </a>


                                <div class="public-card-body">

                                    <div class="home-product-meta">

                                        @if (product.Category != null)
                                        {
                                            <span class="home-product-category">
                                                @product.Category.Name
                                            </span>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(product.SKU))
                                        {
                                            <span class="home-product-sku">
                                                @product.SKU
                                            </span>
                                        }

                                    </div>


                                    <h3 class="home-product-title">
                                        @product.Name
                                    </h3>


                                    @if (!string.IsNullOrWhiteSpace(product.Description))
                                    {
                                        <p class="home-product-description">
                                            @product.Description
                                        </p>
                                    }


                                    <div class="home-product-footer">

                                        @if (product.Price.HasValue)
                                        {
                                            <div class="home-product-price">

                                                <span class="home-product-price-label">
                                                    السعر
                                                </span>

                                                <span class="home-product-price-value">
                                                    @product.Price.Value.ToString("N2")
                                                </span>

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="home-product-price-placeholder">
                                                اطلب عرض سعر
                                            </span>
                                        }


                                        <a class="btn btn-primary public-btn public-btn-primary"
                                           asp-controller="Catalog"
                                           asp-action="Details"
                                           asp-route-id="@product.Id">

                                            <span>التفاصيل</span>
                                            <i class="bi bi-arrow-left"></i>

                                        </a>

                                    </div>

                                </div>

                            </article>

                        </div>
                    }

                </div>

            </div>

        </section>
    }


    <!-- Value Section -->
    <section class="public-section home-value-section">

        <div class="container">

            <div class="row align-items-center g-5">

                <div class="col-lg-5">

                    <span class="public-page-label">
                        <i class="bi bi-layout-text-window-reverse"></i>
                        لماذا المنصة؟
                    </span>

                    <h2 class="home-section-title">
                        كل ما تحتاجه لعرض منتجاتك
                    </h2>

                    <p class="home-section-description">
                        واجهة واضحة تساعد العملاء على الوصول إلى المنتجات
                        والمواصفات وإرسال طلبات عروض الأسعار بسهولة.
                    </p>

                </div>


                <div class="col-lg-7">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <div class="public-card home-value-card">

                                <div class="public-card-body">

                                    <div class="public-card-icon">
                                        <i class="bi bi-grid-3x3-gap"></i>
                                    </div>

                                    <h3 class="h5 fw-bold mt-3 mb-2">
                                        كتالوج منظم
                                    </h3>

                                    <p class="text-muted mb-0">
                                        عرض المنتجات بطريقة واضحة وسهلة التصفح.
                                    </p>

                                </div>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="public-card home-value-card">

                                <div class="public-card-body">

                                    <div class="public-card-icon">
                                        <i class="bi bi-card-checklist"></i>
                                    </div>

                                    <h3 class="h5 fw-bold mt-3 mb-2">
                                        مواصفات واضحة
                                    </h3>

                                    <p class="text-muted mb-0">
                                        عرض تفاصيل ومواصفات كل منتج في مكان واحد.
                                    </p>

                                </div>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="public-card home-value-card">

                                <div class="public-card-body">

                                    <div class="public-card-icon">
                                        <i class="bi bi-file-earmark-text"></i>
                                    </div>

                                    <h3 class="h5 fw-bold mt-3 mb-2">
                                        طلبات عروض الأسعار
                                    </h3>

                                    <p class="text-muted mb-0">
                                        استقبال طلبات الأسعار بطريقة منظمة.
                                    </p>

                                </div>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="public-card home-value-card">

                                <div class="public-card-body">

                                    <div class="public-card-icon">
                                        <i class="bi bi-phone"></i>
                                    </div>

                                    <h3 class="h5 fw-bold mt-3 mb-2">
                                        تجربة متجاوبة
                                    </h3>

                                    <p class="text-muted mb-0">
                                        تجربة مناسبة للكمبيوتر والهاتف والأجهزة اللوحية.
                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- How It Works -->
    <section class="public-section home-process-section">

        <div class="container">

            <div class="home-section-heading home-section-heading-centered">

                <div>

                    <span class="public-page-label mb-2">
                        <i class="bi bi-arrow-repeat"></i>
                        كيف تعمل؟
                    </span>

                    <h2 class="home-section-title">
                        من المنتج إلى طلب السعر
                    </h2>

                    <p class="home-section-description">
                        خطوات بسيطة للوصول إلى المنتج وإرسال طلب عرض سعر.
                    </p>

                </div>

            </div>


            <div class="row g-4">

                <div class="col-md-4">

                    <div class="public-card home-process-card">

                        <div class="public-card-body">

                            <span class="home-process-number">
                                01
                            </span>

                            <div class="public-card-icon mt-3">
                                <i class="bi bi-search"></i>
                            </div>

                            <h3 class="h5 fw-bold mt-3 mb-2">
                                استعرض المنتجات
                            </h3>

                            <p class="text-muted mb-0">
                                تصفح الكتالوج وابحث عن المنتج المناسب.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="public-card home-process-card">

                        <div class="public-card-body">

                            <span class="home-process-number">
                                02
                            </span>

                            <div class="public-card-icon mt-3">
                                <i class="bi bi-info-circle"></i>
                            </div>

                            <h3 class="h5 fw-bold mt-3 mb-2">
                                راجع المواصفات
                            </h3>

                            <p class="text-muted mb-0">
                                اطلع على تفاصيل المنتج والمواصفات المتاحة.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="public-card home-process-card">

                        <div class="public-card-body">

                            <span class="home-process-number">
                                03
                            </span>

                            <div class="public-card-icon mt-3">
                                <i class="bi bi-send"></i>
                            </div>

                            <h3 class="h5 fw-bold mt-3 mb-2">
                                اطلب عرض سعر
                            </h3>

                            <p class="text-muted mb-0">
                                أرسل طلبك وسيتم التواصل معك بخصوص السعر.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- CTA -->
    <section class="public-section home-cta-section">

        <div class="container">

            <div class="public-card home-cta-card">

                <div class="public-card-body">

                    <div class="row align-items-center g-4">

                        <div class="col-lg-8">

                            <span class="public-page-label">
                                <i class="bi bi-chat-square-text"></i>
                                ابدأ الآن
                            </span>

                            <h2 class="home-cta-title">
                                تبحث عن منتج معين؟
                            </h2>

                            <p class="home-cta-description mb-0">
                                استعرض الكتالوج أو أرسل طلب عرض سعر وسنتواصل معك.
                            </p>

                        </div>


                        <div class="col-lg-4">

                            <div class="home-cta-actions">

                                <a class="btn btn-primary public-btn public-btn-primary public-btn-lg"
                                   asp-controller="Catalog"
                                   asp-action="Index">

                                    <span>استكشف الكتالوج</span>
                                    <i class="bi bi-arrow-left"></i>

                                </a>

                                <a class="btn btn-outline-secondary public-btn public-btn-lg"
                                   asp-controller="Contact"
                                   asp-action="Index">

                                    <span>تواصل معنا</span>

                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/home.css"
          asp-append-version="true" />
}