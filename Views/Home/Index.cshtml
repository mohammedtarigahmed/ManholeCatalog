@{
    ViewData["Title"] = "الرئيسية";
}

<div class="container">

    <!-- Hero Section -->
    <section class="py-5">

        <div class="row align-items-center g-5 py-lg-5">

            <div class="col-lg-7">

                <div class="mb-3">
                    <span class="badge text-bg-primary px-3 py-2">
                        أغطية المناهل والمنتجات ذات الصلة
                    </span>
                </div>

                <h1 class="display-4 fw-bold lh-sm mb-4">
                    اعثر على
                    <span class="text-primary">منتجات المناهل</span>
                    المناسبة لمشروعك.
                </h1>

                <p class="lead text-muted mb-4">
                    استكشف كتالوج منتجاتنا، وقارن المواصفات،
                    واطلب عرض سعر للمنتجات التي تحتاجها.
                </p>

                <div class="d-flex flex-wrap gap-2">

                    <a asp-controller="Catalog"
                       asp-action="Index"
                       class="btn btn-primary btn-lg px-4">
                        تصفح الكتالوج
                    </a>

                    <a asp-controller="Catalog"
                       asp-action="Index"
                       class="btn btn-outline-secondary btn-lg px-4">
                        عرض المنتجات
                    </a>

                </div>

            </div>

            <div class="col-lg-5">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body p-5 text-center">

                        <div class="display-1 mb-4">
                            🕳️
                        </div>

                        <h2 class="h3 fw-bold mb-3">
                            كتالوج المنتجات
                        </h2>

                        <p class="text-muted mb-4">
                            ابحث عن المنتجات حسب الفئة، وراجع
                            المواصفات، وأرسل طلب عرض السعر
                            مباشرة من الكتالوج.
                        </p>

                        <div class="d-flex justify-content-center gap-4">

                            <div>
                                <div class="fs-3 fw-bold text-primary">
                                    01
                                </div>
                                <div class="small text-muted">
                                    تصفح
                                </div>
                            </div>

                            <div>
                                <div class="fs-3 fw-bold text-primary">
                                    02
                                </div>
                                <div class="small text-muted">
                                    اختر
                                </div>
                            </div>

                            <div>
                                <div class="fs-3 fw-bold text-primary">
                                    03
                                </div>
                                <div class="small text-muted">
                                    اطلب
                                </div>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- Main Features -->
    <section class="py-5">

        <div class="text-center mb-5">

            <h2 class="fw-bold mb-3">
                كل ما تحتاجه في مكان واحد
            </h2>

            <p class="text-muted mb-0">
                طريقة بسيطة لاستكشاف المنتجات وطلب عروض الأسعار.
            </p>

        </div>

        <div class="row g-4">

            <div class="col-md-4">

                <div class="card h-100 border-0 shadow-sm">

                    <div class="card-body p-4">

                        <div class="fs-1 mb-3">
                            📋
                        </div>

                        <h3 class="h5 fw-bold mb-3">
                            كتالوج المنتجات
                        </h3>

                        <p class="text-muted mb-0">
                            تصفح المنتجات المتاحة واعثر بسرعة
                            على ما تحتاجه باستخدام البحث وتصنيف الفئات.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card h-100 border-0 shadow-sm">

                    <div class="card-body p-4">

                        <div class="fs-1 mb-3">
                            ⚙️
                        </div>

                        <h3 class="h5 fw-bold mb-3">
                            مواصفات المنتجات
                        </h3>

                        <p class="text-muted mb-0">
                            راجع التفاصيل المهمة مثل المادة،
                            وفئة التحميل، والقطر، والشكل،
                            وغيرها من المواصفات المتاحة.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card h-100 border-0 shadow-sm">

                    <div class="card-body p-4">

                        <div class="fs-1 mb-3">
                            💬
                        </div>

                        <h3 class="h5 fw-bold mb-3">
                            طلب عرض سعر
                        </h3>

                        <p class="text-muted mb-0">
                            أرسل متطلباتك من خلال طلب عرض سعر بسيط،
                            وسيتابع فريقنا معك.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- How It Works -->
    <section class="py-5">

        <div class="card border-0 shadow-sm">

            <div class="card-body p-4 p-lg-5">

                <div class="text-center mb-5">

                    <h2 class="fw-bold mb-3">
                        كيف يعمل الموقع؟
                    </h2>

                    <p class="text-muted mb-0">
                        انتقل من اكتشاف المنتج إلى طلب عرض السعر في خطوات بسيطة.
                    </p>

                </div>

                <div class="row g-4 text-center">

                    <div class="col-md-4">

                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3"
                             style="width: 64px; height: 64px;">

                            <span class="fs-4 fw-bold text-primary">
                                1
                            </span>

                        </div>

                        <h3 class="h5 fw-bold">
                            تصفح
                        </h3>

                        <p class="text-muted mb-0">
                            استكشف الكتالوج واعثر على المنتج
                            الذي يناسب متطلباتك.
                        </p>

                    </div>

                    <div class="col-md-4">

                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3"
                             style="width: 64px; height: 64px;">

                            <span class="fs-4 fw-bold text-primary">
                                2
                            </span>

                        </div>

                        <h3 class="h5 fw-bold">
                            راجع
                        </h3>

                        <p class="text-muted mb-0">
                            راجع مواصفات المنتج والمعلومات المتاحة
                            قبل إرسال طلبك.
                        </p>

                    </div>

                    <div class="col-md-4">

                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3"
                             style="width: 64px; height: 64px;">

                            <span class="fs-4 fw-bold text-primary">
                                3
                            </span>

                        </div>

                        <h3 class="h5 fw-bold">
                            اطلب
                        </h3>

                        <p class="text-muted mb-0">
                            أرسل طلب عرض السعر مع بيانات التواصل
                            والكمية المطلوبة.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- Call to Action -->
    <section class="py-5 mb-4">

        <div class="card border-0 shadow-sm bg-light">

            <div class="card-body text-center p-5">

                <h2 class="fw-bold mb-3">
                    هل أنت مستعد للعثور على المنتج المناسب؟
                </h2>

                <p class="text-muted mb-4">
                    استكشف الكتالوج واطلب عرض سعر
                    للمنتجات التي تحتاجها.
                </p>

                <a asp-controller="Catalog"
                   asp-action="Index"
                   class="btn btn-primary btn-lg px-4">
                    استكشف الكتالوج
                </a>

            </div>

        </div>

    </section>

</div>