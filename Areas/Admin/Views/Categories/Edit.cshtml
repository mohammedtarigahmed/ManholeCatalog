@model ManholeCatalog.Models.Category

@{
    ViewData["Title"] = "Edit Category";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">
            Edit Category
        </h1>

        <p class="text-muted mb-0">
            Update the information and status of this category.
        </p>
    </div>

    <a asp-area="Admin"
       asp-controller="Categories"
       asp-action="Index"
       class="btn btn-outline-secondary">
        ← Back to Categories
    </a>
</div>

<form asp-area="Admin"
      asp-controller="Categories"
      asp-action="Edit"
      method="post">

    <input type="hidden"
           asp-for="Id" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All"
             class="alert alert-danger"
             role="alert">
        </div>
    }

    <div class="row g-4">

        <!-- Category Information -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white py-3">
                    <h2 class="h6 fw-bold mb-1">
                        Category Information
                    </h2>

                    <p class="text-muted small mb-0">
                        Update the name and description of this category.
                    </p>
                </div>

                <div class="card-body">

                    <div class="mb-4">
                        <label asp-for="Name"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="e.g. Manhole Covers" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            Use a clear name that customers can easily understand.
                        </div>
                    </div>

                    <div>
                        <label asp-for="Description"
                               class="form-label fw-semibold">
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="6"
                                  placeholder="Describe the products included in this category."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            Optional. This description can help explain the purpose of the category.
                        </div>
                    </div>

                </div>

            </div>
        </div>

        <!-- Category Status -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white py-3">
                    <h2 class="h6 fw-bold mb-1">
                        Category Status
                    </h2>

                    <p class="text-muted small mb-0">
                        Control whether this category is currently active.
                    </p>
                </div>

                <div class="card-body">

                    <div class="form-check form-switch">
                        <input asp-for="IsActive"
                               class="form-check-input"
                               role="switch" />

                        <label asp-for="IsActive"
                               class="form-check-label fw-semibold">
                        </label>
                    </div>

                    <div class="form-text mt-2">
                        Active categories can be used to organize products in the catalog.
                    </div>

                    <div class="alert alert-light border mt-4 mb-0">
                        <div class="small">
                            <strong>Note:</strong>
                            Deactivating a category does not delete the category or its products.
                        </div>
                    </div>

                </div>

            </div>
        </div>

        <!-- Actions -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">

                <div class="card-body">
                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">

                        <a asp-area="Admin"
                           asp-controller="Categories"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button type="submit"
                                class="btn btn-primary">
                            Save Changes
                        </button>

                    </div>
                </div>

            </div>
        </div>

    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}