@model ManholeCatalog.Models.Category

@{
    ViewData["Title"] = "تعديل الفئة";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

    <div>

        <h1 class="h3 fw-bold mb-1">
            تعديل الفئة
        </h1>

        <p class="text-muted mb-0">
            تحديث معلومات هذه الفئة وحالتها.
        </p>

    </div>

    <a asp-area="Admin"
       asp-controller="Categories"
       asp-action="Index"
       class="btn btn-outline-secondary">
        ← العودة إلى الفئات
    </a>

</div>

<form asp-area="Admin"
      asp-controller="Categories"
      asp-action="Edit"
      method="post">

    <input type="hidden"
           asp-for="Id" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All"
             class="alert alert-danger"
             role="alert">
        </div>
    }

    <div class="row g-4">

        <!-- معلومات الفئة -->
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white py-3">

                    <h2 class="h6 fw-bold mb-1">
                        معلومات الفئة
                    </h2>

                    <p class="text-muted small mb-0">
                        تحديث اسم الفئة ووصفها.
                    </p>

                </div>

                <div class="card-body">

                    <div class="mb-4">

                        <label asp-for="Name"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="مثال: أغطية المناهل" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            استخدم اسمًا واضحًا يسهل على العملاء فهمه.
                        </div>

                    </div>

                    <div>

                        <label asp-for="Description"
                               class="form-label fw-semibold">
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="6"
                                  placeholder="اكتب وصفًا للمنتجات التي تندرج ضمن هذه الفئة."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            اختياري. يمكن أن يساعد هذا الوصف في توضيح الغرض من الفئة.
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- حالة الفئة -->
        <div class="col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white py-3">

                    <h2 class="h6 fw-bold mb-1">
                        حالة الفئة
                    </h2>

                    <p class="text-muted small mb-0">
                        تحديد ما إذا كانت هذه الفئة نشطة حاليًا.
                    </p>

                </div>

                <div class="card-body">

                    <div class="form-check form-switch">

                        <input asp-for="IsActive"
                               class="form-check-input"
                               role="switch" />

                        <label asp-for="IsActive"
                               class="form-check-label fw-semibold">
                        </label>

                    </div>

                    <div class="form-text mt-2">
                        يمكن استخدام الفئات النشطة لتنظيم المنتجات في الكتالوج.
                    </div>

                    <div class="alert alert-light border mt-4 mb-0">

                        <div class="small">

                            <strong>ملاحظة:</strong>

                            تعطيل الفئة لا يؤدي إلى حذفها أو حذف المنتجات المرتبطة بها.

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- الإجراءات -->
        <div class="col-12">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">

                        <a asp-area="Admin"
                           asp-controller="Categories"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            إلغاء
                        </a>

                        <button type="submit"
                                class="btn btn-primary">
                            حفظ التغييرات
                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</form>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}