@model ManholeCatalog.Models.Category

@{
    ViewData["Title"] = "إضافة فئة";
}

<div class="admin-page">

    <!-- Page Header -->
    <div class="admin-page-header">

        <div class="admin-page-header-row">

            <div class="admin-page-header-main">

                <div class="admin-page-header-eyebrow">

                    <i class="bi bi-tags"></i>
                    إدارة الفئات

                    <span class="admin-badge admin-badge-neutral">
                        فئة جديدة
                    </span>

                </div>

                <h1 class="admin-page-header-title">
                    إضافة فئة
                </h1>

                <p class="admin-page-header-description">
                    إنشاء فئة جديدة لتنظيم منتجات الكتالوج.
                </p>

            </div>

            <div class="admin-page-header-actions">

                <a asp-area="Admin"
                   asp-controller="Categories"
                   asp-action="Index"
                   class="admin-btn admin-btn-secondary">

                    <i class="bi bi-arrow-right"></i>
                    <span>العودة إلى الفئات</span>

                </a>

            </div>

        </div>

    </div>


    <form asp-area="Admin"
          asp-controller="Categories"
          asp-action="Create"
          method="post">

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="admin-alert admin-alert-danger mb-4"
                 role="alert">

                <div class="admin-alert-icon">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>

                <div>
                    <div class="fw-semibold mb-1">
                        يرجى مراجعة البيانات المدخلة.
                    </div>

                    <div asp-validation-summary="All"></div>
                </div>

            </div>
        }


        <div class="row g-4">

            <!-- Category Information -->
            <div class="col-lg-8">

                <div class="admin-card h-100">

                    <div class="admin-card-header">

                        <div class="admin-card-header-content">

                            <div class="admin-card-icon">

                                <i class="bi bi-tag"></i>

                            </div>

                            <div>

                                <h2 class="admin-card-title">
                                    معلومات الفئة
                                </h2>

                                <p class="admin-card-description">
                                    أدخل اسم الفئة ووصفها.
                                </p>

                            </div>

                        </div>

                    </div>


                    <div class="admin-card-body">

                        <!-- Name -->
                        <div class="admin-form-group">

                            <label asp-for="Name"
                                   class="admin-form-label admin-form-label-required">
                            </label>

                            <input asp-for="Name"
                                   class="form-control admin-form-control"
                                   placeholder="مثال: أغطية المناهل"
                                   autocomplete="off" />

                            <span asp-validation-for="Name"
                                  class="admin-form-validation">
                            </span>

                            <div class="admin-form-help">
                                <i class="bi bi-info-circle"></i>
                                استخدم اسمًا واضحًا يسهل على العملاء فهمه.
                            </div>

                        </div>


                        <!-- Description -->
                        <div class="admin-form-group mb-0">

                            <label asp-for="Description"
                                   class="admin-form-label">
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control admin-form-control category-description-input"
                                      rows="6"
                                      placeholder="اكتب وصفًا للمنتجات التي تندرج ضمن هذه الفئة.">
                            </textarea>

                            <span asp-validation-for="Description"
                                  class="admin-form-validation">
                            </span>

                            <div class="admin-form-help">
                                <i class="bi bi-info-circle"></i>
                                اختياري. يمكن أن يساعد هذا الوصف في توضيح الغرض من الفئة.
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Category Status -->
            <div class="col-lg-4">

                <div class="admin-card h-100">

                    <div class="admin-card-header">

                        <div class="admin-card-header-content">

                            <div class="admin-card-icon">

                                <i class="bi bi-toggle-on"></i>

                            </div>

                            <div>

                                <h2 class="admin-card-title">
                                    حالة الفئة
                                </h2>

                                <p class="admin-card-description">
                                    تحديد ما إذا كانت الفئة متاحة للاستخدام.
                                </p>

                            </div>

                        </div>

                    </div>


                    <div class="admin-card-body">

                        <div class="category-status-box">

                            <div class="form-check form-switch">

                                <input asp-for="IsActive"
                                       class="form-check-input category-status-switch"
                                       role="switch" />

                                <label asp-for="IsActive"
                                       class="form-check-label fw-semibold">
                                </label>

                            </div>

                            <div class="admin-form-help mt-2">
                                يمكن استخدام الفئات النشطة لتنظيم المنتجات في الكتالوج.
                            </div>

                        </div>


                        <div class="admin-alert admin-alert-info mt-4 mb-0">

                            <div class="admin-alert-icon">
                                <i class="bi bi-lightbulb"></i>
                            </div>

                            <div class="small">

                                <div class="fw-semibold mb-1">
                                    نصيحة
                                </div>

                                <div>
                                    يمكنك تعطيل هذه الفئة لاحقًا دون حذفها.
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Actions -->
            <div class="col-12">

                <div class="admin-card">

                    <div class="admin-card-body">

                        <div class="admin-form-actions">

                            <div class="admin-form-help">

                                <i class="bi bi-shield-check"></i>
                                يمكنك تعديل بيانات الفئة لاحقًا.

                            </div>


                            <div class="d-flex flex-column flex-sm-row gap-2">

                                <a asp-area="Admin"
                                   asp-controller="Categories"
                                   asp-action="Index"
                                   class="admin-btn admin-btn-secondary category-action-button">

                                    <span>إلغاء</span>

                                </a>

                                <button type="submit"
                                        class="admin-btn admin-btn-primary category-action-button">

                                    <i class="bi bi-check-lg"></i>
                                    <span>إنشاء الفئة</span>

                                </button>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/categories-create.css"
          asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}