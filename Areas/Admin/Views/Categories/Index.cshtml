@model IEnumerable<ManholeCatalog.Models.Category>

@{
    ViewData["Title"] = "الفئات";

    var categories = Model.ToList();

    var totalCategories = categories.Count;
    var activeCategories = categories.Count(c => c.IsActive);
    var inactiveCategories = categories.Count(c => !c.IsActive);
    var totalProducts = categories.Sum(c => c.Products.Count);
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

    <div>

        <h1 class="h3 fw-bold mb-1">
            الفئات
        </h1>

        <p class="text-muted mb-0">
            إدارة فئات المنتجات وتنظيمها.
        </p>

    </div>

    <a asp-area="Admin"
       asp-controller="Categories"
       asp-action="Create"
       class="btn btn-primary">
        + إضافة فئة
    </a>

</div>

<!-- الإحصائيات -->
<div class="row g-4 mb-4">

    <div class="col-sm-6 col-xl-3">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <div class="small text-muted mb-1">
                    إجمالي الفئات
                </div>

                <div class="h3 fw-bold mb-0">
                    @totalCategories
                </div>

                <div class="small text-muted mt-2">
                    جميع الفئات
                </div>

            </div>

        </div>

    </div>

    <div class="col-sm-6 col-xl-3">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <div class="small text-muted mb-1">
                    نشطة
                </div>

                <div class="h3 fw-bold text-success mb-0">
                    @activeCategories
                </div>

                <div class="small text-muted mt-2">
                    متاحة حاليًا
                </div>

            </div>

        </div>

    </div>

    <div class="col-sm-6 col-xl-3">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <div class="small text-muted mb-1">
                    غير نشطة
                </div>

                <div class="h3 fw-bold text-secondary mb-0">
                    @inactiveCategories
                </div>

                <div class="small text-muted mt-2">
                    معطلة حاليًا
                </div>

            </div>

        </div>

    </div>

    <div class="col-sm-6 col-xl-3">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <div class="small text-muted mb-1">
                    المنتجات
                </div>

                <div class="h3 fw-bold mb-0">
                    @totalProducts
                </div>

                <div class="small text-muted mt-2">
                    إجمالي المنتجات المرتبطة
                </div>

            </div>

        </div>

    </div>

</div>

@if (!categories.Any())
{
    <!-- حالة عدم وجود فئات -->
    <div class="card border-0 shadow-sm">

        <div class="card-body text-center py-5">

            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light border mb-3"
                 style="width: 64px; height: 64px;">

                <span class="text-muted fw-bold fs-5">
                    C
                </span>

            </div>

            <h2 class="h5 fw-bold mb-2">
                لا توجد فئات
            </h2>

            <p class="text-muted mb-4">
                أضف أول فئة لتنظيم كتالوج المنتجات.
            </p>

            <a asp-area="Admin"
               asp-controller="Categories"
               asp-action="Create"
               class="btn btn-primary">
                إضافة فئة
            </a>

        </div>

    </div>
}
else
{
    <!-- قائمة الفئات -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">

            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">

                <div>

                    <h2 class="h6 fw-bold mb-1">
                        قائمة الفئات
                    </h2>

                    <p class="text-muted small mb-0">
                        عرض وإدارة فئات المنتجات.
                    </p>

                </div>

                <div class="d-flex flex-wrap gap-2">

                    <span class="badge text-bg-light border">
                        @totalCategories فئة
                    </span>

                    @if (inactiveCategories > 0)
                    {
                        <span class="badge text-bg-secondary">
                            @inactiveCategories غير نشطة
                        </span>
                    }

                </div>

            </div>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-4">
                                الفئة
                            </th>

                            <th>
                                الوصف
                            </th>

                            <th>
                                المنتجات
                            </th>

                            <th>
                                الحالة
                            </th>

                            <th>
                                تاريخ الإنشاء
                            </th>

                            <th class="text-end pe-4">
                                الإجراءات
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var category in categories)
                        {
                            <tr>

                                <!-- الفئة -->
                                <td class="ps-4">

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="d-flex align-items-center justify-content-center rounded border bg-light flex-shrink-0"
                                             style="width: 44px; height: 44px;">

                                            <span class="fw-bold text-primary">
                                                @(string.IsNullOrWhiteSpace(category.Name) ? "C" : category.Name.Substring(0, 1).ToUpper())
                                            </span>

                                        </div>

                                        <div>

                                            <div class="fw-semibold">
                                                @category.Name
                                            </div>

                                            <div class="small text-muted">
                                                المعرّف: @category.Id
                                            </div>

                                        </div>

                                    </div>

                                </td>

                                <!-- الوصف -->
                                <td style="min-width: 260px; max-width: 400px;">

                                    @if (!string.IsNullOrWhiteSpace(category.Description))
                                    {
                                        <div class="text-muted text-truncate"
                                             style="max-width: 380px;"
                                             title="@category.Description">
                                            @category.Description
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>

                                <!-- المنتجات -->
                                <td>

                                    @if (category.Products.Count > 0)
                                    {
                                        <span class="badge text-bg-light border">
                                            @category.Products.Count
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            0
                                        </span>
                                    }

                                </td>

                                <!-- الحالة -->
                                <td>

                                    @if (category.IsActive)
                                    {
                                        <span class="badge text-bg-success">
                                            نشطة
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">
                                            غير نشطة
                                        </span>
                                    }

                                </td>

                                <!-- تاريخ الإنشاء -->
                                <td>

                                    <span class="small text-muted text-nowrap">
                                        @category.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </span>

                                </td>

                                <!-- الإجراءات -->
                                <td class="text-end pe-4">

                                    <div class="d-inline-flex align-items-center gap-1 flex-nowrap">

                                        <a asp-area="Admin"
                                           asp-controller="Categories"
                                           asp-action="Edit"
                                           asp-route-id="@category.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            تعديل
                                        </a>

                                        <div class="dropdown">

                                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                    type="button"
                                                    data-bs-toggle="dropdown"
                                                    aria-expanded="false">
                                                المزيد
                                            </button>

                                            <ul class="dropdown-menu dropdown-menu-end">

                                                @if (category.IsActive)
                                                {
                                                    <li>

                                                        <form asp-area="Admin"
                                                              asp-controller="Categories"
                                                              asp-action="Deactivate"
                                                              method="post"
                                                              onsubmit="return confirm('هل أنت متأكد من رغبتك في تعطيل هذه الفئة؟');">

                                                            <input type="hidden"
                                                                   name="id"
                                                                   value="@category.Id" />

                                                            <button type="submit"
                                                                    class="dropdown-item text-danger">
                                                                تعطيل
                                                            </button>

                                                        </form>

                                                    </li>
                                                }
                                                else
                                                {
                                                    <li>

                                                        <form asp-area="Admin"
                                                              asp-controller="Categories"
                                                              asp-action="Reactivate"
                                                              method="post"
                                                              onsubmit="return confirm('هل أنت متأكد من رغبتك في إعادة تفعيل هذه الفئة؟');">

                                                            <input type="hidden"
                                                                   name="id"
                                                                   value="@category.Id" />

                                                            <button type="submit"
                                                                    class="dropdown-item text-success">
                                                                إعادة التفعيل
                                                            </button>

                                                        </form>

                                                    </li>
                                                }

                                            </ul>

                                        </div>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
}