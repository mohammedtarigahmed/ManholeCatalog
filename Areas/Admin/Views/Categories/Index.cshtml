@model IEnumerable<ManholeCatalog.Models.Category>

@{
    ViewData["Title"] = "الفئات";

    var categories = Model.ToList();

    var totalCategories = categories.Count;
    var activeCategories = categories.Count(c => c.IsActive);
    var inactiveCategories = categories.Count(c => !c.IsActive);
    var totalProducts = categories.Sum(c => c.Products.Count);
}

<div class="admin-page">

    <!-- Page Header -->
    <div class="admin-page-header">

        <div class="admin-page-header-row">

            <div class="admin-page-header-main">

                <div class="admin-page-header-eyebrow">

                    <i class="bi bi-tags"></i>
                    إدارة الفئات

                    <span class="admin-badge admin-badge-neutral">
                        @totalCategories فئة
                    </span>

                </div>

                <h1 class="admin-page-header-title">
                    الفئات
                </h1>

                <p class="admin-page-header-description">
                    إدارة فئات المنتجات وتنظيمها داخل الكتالوج.
                </p>

            </div>

            <div class="admin-page-header-actions">

                <a asp-area="Admin"
                   asp-controller="Categories"
                   asp-action="Create"
                   class="admin-btn admin-btn-primary">

                    <i class="bi bi-plus-lg"></i>
                    <span>إضافة فئة</span>

                </a>

            </div>

        </div>

    </div>


    <!-- Statistics -->
    <div class="admin-stats-grid mb-4">

        <!-- Total Categories -->
        <div class="admin-stat-card">

            <div class="admin-stat-card-content">

                <div class="admin-stat-card-top">

                    <div>

                        <div class="admin-stat-label">
                            إجمالي الفئات
                        </div>

                        <div class="admin-stat-value">
                            @totalCategories
                        </div>

                    </div>

                    <div class="admin-stat-icon admin-stat-icon-primary">
                        <i class="bi bi-tags"></i>
                    </div>

                </div>

                <div class="admin-stat-description">

                    <i class="bi bi-collection"></i>
                    <span>جميع الفئات</span>

                </div>

            </div>

        </div>


        <!-- Active Categories -->
        <div class="admin-stat-card">

            <div class="admin-stat-card-content">

                <div class="admin-stat-card-top">

                    <div>

                        <div class="admin-stat-label">
                            الفئات النشطة
                        </div>

                        <div class="admin-stat-value text-success">
                            @activeCategories
                        </div>

                    </div>

                    <div class="admin-stat-icon admin-stat-icon-success">
                        <i class="bi bi-check-circle"></i>
                    </div>

                </div>

                <div class="admin-stat-description">

                    <i class="bi bi-eye"></i>
                    <span>متاحة حاليًا</span>

                </div>

            </div>

        </div>


        <!-- Inactive Categories -->
        <div class="admin-stat-card">

            <div class="admin-stat-card-content">

                <div class="admin-stat-card-top">

                    <div>

                        <div class="admin-stat-label">
                            الفئات غير النشطة
                        </div>

                        <div class="admin-stat-value text-secondary">
                            @inactiveCategories
                        </div>

                    </div>

                    <div class="admin-stat-icon admin-stat-icon-neutral">
                        <i class="bi bi-pause-circle"></i>
                    </div>

                </div>

                <div class="admin-stat-description">

                    <i class="bi bi-eye-slash"></i>
                    <span>معطلة حاليًا</span>

                </div>

            </div>

        </div>


        <!-- Products -->
        <div class="admin-stat-card">

            <div class="admin-stat-card-content">

                <div class="admin-stat-card-top">

                    <div>

                        <div class="admin-stat-label">
                            المنتجات
                        </div>

                        <div class="admin-stat-value">
                            @totalProducts
                        </div>

                    </div>

                    <div class="admin-stat-icon admin-stat-icon-warning">
                        <i class="bi bi-box-seam"></i>
                    </div>

                </div>

                <div class="admin-stat-description">

                    <i class="bi bi-link-45deg"></i>
                    <span>المنتجات المرتبطة بالفئات</span>

                </div>

            </div>

        </div>

    </div>


    @if (!categories.Any())
    {
        <!-- Empty State -->

        <div class="admin-card">

            <div class="admin-card-body">

                <div class="admin-empty-state">

                    <div class="admin-empty-icon">
                        <i class="bi bi-tags"></i>
                    </div>

                    <h2 class="admin-empty-title">
                        لا توجد فئات بعد
                    </h2>

                    <p class="admin-empty-description">
                        أضف أول فئة لتنظيم منتجات الكتالوج.
                    </p>

                    <a asp-area="Admin"
                       asp-controller="Categories"
                       asp-action="Create"
                       class="admin-btn admin-btn-primary">

                        <i class="bi bi-plus-lg"></i>
                        <span>إضافة فئة</span>

                    </a>

                </div>

            </div>

        </div>
    }
    else
    {
        <!-- Categories List -->

        <div class="admin-card">

            <div class="admin-card-header">

                <div class="admin-card-header-row">

                    <div class="admin-card-header-content">

                        <div class="admin-card-icon">

                            <i class="bi bi-list-ul"></i>

                        </div>

                        <div>

                            <h2 class="admin-card-title">
                                قائمة الفئات
                            </h2>

                            <p class="admin-card-description">
                                عرض وإدارة فئات المنتجات وحالتها.
                            </p>

                        </div>

                    </div>


                    <div class="d-flex flex-wrap gap-2">

                        <span class="admin-badge admin-badge-neutral">

                            <i class="bi bi-tags"></i>
                            @totalCategories فئة

                        </span>

                        @if (inactiveCategories > 0)
                        {
                            <span class="admin-badge admin-badge-neutral">

                                <i class="bi bi-pause-circle"></i>
                                @inactiveCategories غير نشطة

                            </span>
                        }

                    </div>

                </div>

            </div>


            <div class="admin-card-body p-0">

                <div class="table-responsive">

                    <table class="table admin-table categories-table align-middle mb-0">

                        <thead>

                            <tr>

                                <th>
                                    الفئة
                                </th>

                                <th>
                                    الوصف
                                </th>

                                <th>
                                    المنتجات
                                </th>

                                <th>
                                    الحالة
                                </th>

                                <th>
                                    تاريخ الإنشاء
                                </th>

                                <th class="text-end">
                                    الإجراءات
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var category in categories)
                            {
                                <tr>

                                    <!-- Category -->

                                    <td>

                                        <div class="d-flex align-items-center gap-3">

                                            <div class="category-avatar">

                                                <i class="bi bi-tag"></i>

                                            </div>

                                            <div>

                                                <div class="fw-semibold">
                                                    @category.Name
                                                </div>

                                                <div class="admin-form-help">
                                                    المعرّف: #@category.Id
                                                </div>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- Description -->

                                    <td class="category-description-cell">

                                        @if (!string.IsNullOrWhiteSpace(category.Description))
                                        {
                                            <div class="category-description"
                                                 title="@category.Description">

                                                @category.Description

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                لا يوجد وصف
                                            </span>
                                        }

                                    </td>


                                    <!-- Products -->

                                    <td>

                                        @if (category.Products.Count > 0)
                                        {
                                            <span class="admin-badge admin-badge-neutral category-product-count">

                                                <i class="bi bi-box-seam"></i>
                                                @category.Products.Count

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="admin-badge admin-badge-neutral category-product-count">

                                                <i class="bi bi-box"></i>
                                                0

                                            </span>
                                        }

                                    </td>


                                    <!-- Status -->

                                    <td>

                                        @if (category.IsActive)
                                        {
                                            <span class="admin-badge admin-badge-success">

                                                <i class="bi bi-check-circle"></i>
                                                نشطة

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="admin-badge admin-badge-neutral">

                                                <i class="bi bi-pause-circle"></i>
                                                غير نشطة

                                            </span>
                                        }

                                    </td>


                                    <!-- Created -->

                                    <td>

                                        <div class="category-date">

                                            <div class="text-nowrap">
                                                @category.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                            </div>

                                            <div class="admin-form-help text-nowrap">
                                                @category.CreatedAt.ToLocalTime().ToString("hh:mm tt")
                                            </div>

                                        </div>

                                    </td>


                                    <!-- Actions -->

                                    <td class="text-end">

                                        <div class="dropdown">

                                            <button class="admin-icon-btn"
                                                    type="button"
                                                    data-bs-toggle="dropdown"
                                                    aria-expanded="false"
                                                    aria-label="إجراءات الفئة">

                                                <i class="bi bi-three-dots-vertical"></i>

                                            </button>


                                            <ul class="dropdown-menu dropdown-menu-end admin-actions-menu">

                                                <li>

                                                    <a asp-area="Admin"
                                                       asp-controller="Categories"
                                                       asp-action="Edit"
                                                       asp-route-id="@category.Id"
                                                       class="dropdown-item">

                                                        <i class="bi bi-pencil text-primary"></i>
                                                        <span>تعديل الفئة</span>

                                                    </a>

                                                </li>


                                                <li>
                                                    <hr class="dropdown-divider" />
                                                </li>


                                                @if (category.IsActive)
                                                {
                                                    <li>

                                                        <form asp-area="Admin"
                                                              asp-controller="Categories"
                                                              asp-action="Deactivate"
                                                              method="post"
                                                              onsubmit="return confirm('هل أنت متأكد من رغبتك في تعطيل هذه الفئة؟');">

                                                            <input type="hidden"
                                                                   name="id"
                                                                   value="@category.Id" />

                                                            <button type="submit"
                                                                    class="dropdown-item text-danger">

                                                                <i class="bi bi-pause-circle"></i>
                                                                <span>تعطيل الفئة</span>

                                                            </button>

                                                        </form>

                                                    </li>
                                                }
                                                else
                                                {
                                                    <li>

                                                        <form asp-area="Admin"
                                                              asp-controller="Categories"
                                                              asp-action="Reactivate"
                                                              method="post"
                                                              onsubmit="return confirm('هل أنت متأكد من رغبتك في إعادة تفعيل هذه الفئة؟');">

                                                            <input type="hidden"
                                                                   name="id"
                                                                   value="@category.Id" />

                                                            <button type="submit"
                                                                    class="dropdown-item text-success">

                                                                <i class="bi bi-check-circle"></i>
                                                                <span>إعادة تفعيل الفئة</span>

                                                            </button>

                                                        </form>

                                                    </li>
                                                }

                                            </ul>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/categories.css"
          asp-append-version="true" />
}