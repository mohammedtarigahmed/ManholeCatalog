@model ManholeCatalog.Models.Product

@{
    ViewData["Title"] = "صور المنتج";

    var orderedImages = Model.Images.OrderBy(i => i.DisplayOrder).ThenBy(i => i.Id).ToList();

    var primaryImage = orderedImages.FirstOrDefault(i => i.IsPrimary);
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

    <div>

        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">

            <span class="badge text-bg-light border">
                المنتج #@Model.Id
            </span>

            @if (Model.IsActive)
            {
                <span class="badge text-bg-success">
                    نشط
                </span>
            }
            else
            {
                <span class="badge text-bg-secondary">
                    غير نشط
                </span>
            }

        </div>

        <h1 class="h3 fw-bold mb-1">
            صور المنتج
        </h1>

        <p class="text-muted mb-0">
            إدارة صور المنتج وترتيب عرضها وتحديد الصورة الرئيسية.
        </p>

    </div>

    <div class="d-flex flex-wrap gap-2">

        <a asp-area="Admin"
           asp-controller="Products"
           asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-outline-primary">
            عرض المنتج
        </a>

        <a asp-area="Admin"
           asp-controller="Products"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← العودة إلى المنتجات
        </a>

    </div>

</div>

<!-- ملخص المنتج -->
<div class="card border-0 shadow-sm mb-4">

    <div class="card-body">

        <div class="row g-4 align-items-center">

            <div class="col-md-8">

                <div class="small text-muted mb-1">
                    المنتج
                </div>

                <h2 class="h5 fw-bold mb-2">
                    @Model.Name
                </h2>

                <div class="d-flex flex-wrap gap-2">

                    @if (!string.IsNullOrWhiteSpace(Model.SKU))
                    {
                        <span class="badge text-bg-light border">
                            الرقم التعريفي: @Model.SKU
                        </span>
                    }

                    @if (Model.Category != null)
                    {
                        <span class="badge text-bg-light border">
                            @Model.Category.Name
                        </span>
                    }

                </div>

            </div>

            <div class="col-md-4">

                <div class="d-flex justify-content-md-end gap-4">

                    <div class="text-center">

                        <div class="h4 fw-bold mb-0">
                            @orderedImages.Count
                        </div>

                        <div class="small text-muted">
                            الصور
                        </div>

                    </div>

                    <div class="vr"></div>

                    <div class="text-center">

                        <div class="h4 fw-bold mb-0">
                            @(primaryImage != null ? "1" : "0")
                        </div>

                        <div class="small text-muted">
                            الرئيسية
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@if (TempData["ImageError"] != null)
{
    <div class="alert alert-danger shadow-sm"
         role="alert">

        <strong>فشل رفع الصورة:</strong>

        @TempData["ImageError"]

    </div>
}

<!-- رفع صورة -->
<div class="card border-0 shadow-sm mb-4">

    <div class="card-header bg-white py-3">

        <h2 class="h6 fw-bold mb-1">
            رفع صورة
        </h2>

        <p class="text-muted small mb-0">
            إضافة صورة جديدة إلى هذا المنتج.
        </p>

    </div>

    <div class="card-body">

        <form asp-area="Admin"
              asp-controller="Products"
              asp-action="UploadImage"
              asp-route-id="@Model.Id"
              method="post"
              enctype="multipart/form-data">

            <div class="row g-3 align-items-end">

                <div class="col-md-9">

                    <label for="image"
                           class="form-label fw-semibold">
                        اختيار الصورة
                    </label>

                    <input type="file"
                           id="image"
                           name="image"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp,image/*" />

                    <div class="form-text">
                        الصيغ المسموح بها: JPG, JPEG, PNG, WebP. الحد الأقصى للحجم: 5 ميجابايت.
                    </div>

                </div>

                <div class="col-md-3">

                    <button type="submit"
                            class="btn btn-primary w-100">
                        رفع الصورة
                    </button>

                </div>

            </div>

        </form>

    </div>

</div>

<!-- صور المنتج -->
<div class="card border-0 shadow-sm">

    <div class="card-header bg-white py-3">

        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">

            <div>

                <h2 class="h6 fw-bold mb-1">
                    صور المنتج
                </h2>

                <p class="text-muted small mb-0">
                    إعادة ترتيب الصور، وتحديد الصورة الرئيسية، أو حذف الصور.
                </p>

            </div>

            <span class="badge text-bg-light border">
                @orderedImages.Count صورة
            </span>

        </div>

    </div>

    <div class="card-body">

        @if (!orderedImages.Any())
        {
            <div class="text-center py-5">

                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light border mb-3"
                     style="width: 64px; height: 64px;">

                    <span class="text-muted fw-bold fs-5">
                        IMG
                    </span>

                </div>

                <h3 class="h6 fw-bold mb-2">
                    لا توجد صور بعد
                </h3>

                <p class="text-muted mb-1">
                    لم يتم رفع أي صور لهذا المنتج.
                </p>

                <p class="small text-muted mb-0">
                    ارفع الصورة الأولى باستخدام النموذج أعلاه.
                </p>

            </div>
        }
        else
        {
            <div class="row g-4">

                @for (var index = 0; index < orderedImages.Count; index++)
                {
                    var image = orderedImages[index];

                    <div class="col-md-6 col-xl-4">

                        <div class="card h-100 border shadow-sm">

                            <!-- الصورة -->
                            <div class="position-relative">

                                <img src="@image.ImagePath"
                                     alt="@image.AltText"
                                     class="card-img-top"
                                     style="height: 240px; object-fit: contain; background-color: #f8f9fa;" />

                                @if (image.IsPrimary)
                                {
                                    <span class="position-absolute top-0 end-0 m-3 badge text-bg-primary">
                                        رئيسية
                                    </span>
                                }

                            </div>

                            <!-- أدوات التحكم بالصورة -->
                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-center mb-3">

                                    <div>

                                        <div class="small text-muted">
                                            ترتيب العرض
                                        </div>

                                        <div class="fw-semibold">
                                            @(index + 1)
                                        </div>

                                    </div>

                                    @if (image.IsPrimary)
                                    {
                                        <span class="badge text-bg-primary">
                                            الصورة الرئيسية
                                        </span>
                                    }

                                </div>

                                <!-- أزرار الترتيب -->
                                <div class="d-flex gap-2 mb-3">

                                    @if (index > 0)
                                    {
                                        <form asp-area="Admin"
                                              asp-controller="Products"
                                              asp-action="MoveImageUp"
                                              asp-route-id="@image.Id"
                                              method="post"
                                              class="flex-fill">

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-secondary w-100">
                                                ↑ نقل لأعلى
                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary w-100"
                                                disabled>
                                            ↑ نقل لأعلى
                                        </button>
                                    }

                                    @if (index < orderedImages.Count - 1)
                                    {
                                        <form asp-area="Admin"
                                              asp-controller="Products"
                                              asp-action="MoveImageDown"
                                              asp-route-id="@image.Id"
                                              method="post"
                                              class="flex-fill">

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-secondary w-100">
                                                ↓ نقل لأسفل
                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary w-100"
                                                disabled>
                                            ↓ نقل لأسفل
                                        </button>
                                    }

                                </div>

                                <!-- الصورة الرئيسية -->
                                @if (!image.IsPrimary)
                                {
                                    <form asp-area="Admin"
                                          asp-controller="Products"
                                          asp-action="SetPrimaryImage"
                                          asp-route-id="@image.Id"
                                          method="post"
                                          class="mb-2">

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-primary w-100">
                                            تعيين كصورة رئيسية
                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <div class="alert alert-primary py-2 small mb-2">

                                        <div class="fw-semibold">
                                            الصورة الرئيسية
                                        </div>

                                        <div>
                                            هذه الصورة مستخدمة حاليًا كصورة المنتج الرئيسية.
                                        </div>

                                    </div>
                                }

                                <!-- حذف الصورة -->
                                <form asp-area="Admin"
                                      asp-controller="Products"
                                      asp-action="DeleteImage"
                                      asp-route-id="@image.Id"
                                      method="post"
                                      onsubmit="return confirm('هل أنت متأكد من رغبتك في حذف هذه الصورة؟');">

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger w-100">
                                        حذف الصورة
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}