@model ManholeCatalog.Models.Product

@{
    ViewData["Title"] = "صور المنتج";

    var orderedImages = Model.Images
        .OrderBy(i => i.DisplayOrder)
        .ThenBy(i => i.Id)
        .ToList();

    var primaryImage = orderedImages.FirstOrDefault(i => i.IsPrimary);
}

<div class="admin-page">

    <!-- Page Header -->
    <div class="admin-page-header">
        <div class="admin-page-header-row">

            <div class="admin-page-header-main">

                <div class="admin-page-header-eyebrow">
                    <i class="bi bi-images"></i>
                    إدارة الصور

                    <span class="admin-badge admin-badge-neutral">
                        #@Model.Id
                    </span>

                    @if (Model.IsActive)
                    {
                        <span class="admin-badge admin-badge-success">
                            <i class="bi bi-check-circle"></i>
                            نشط
                        </span>
                    }
                    else
                    {
                        <span class="admin-badge admin-badge-neutral">
                            <i class="bi bi-pause-circle"></i>
                            غير نشط
                        </span>
                    }
                </div>

                <h1 class="admin-page-header-title">
                    صور المنتج
                </h1>

                <p class="admin-page-header-description">
                    إدارة صور المنتج وترتيب عرضها وتحديد الصورة الرئيسية.
                </p>

            </div>

            <div class="admin-page-header-actions">

                <a asp-area="Admin"
                   asp-controller="Products"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="admin-btn admin-btn-secondary">

                    <i class="bi bi-eye"></i>
                    <span>عرض المنتج</span>

                </a>

                <a asp-area="Admin"
                   asp-controller="Products"
                   asp-action="Index"
                   class="admin-btn admin-btn-secondary">

                    <i class="bi bi-arrow-right"></i>
                    <span>العودة إلى المنتجات</span>

                </a>

            </div>

        </div>
    </div>


    <!-- Product Summary -->
    <div class="admin-card mb-4">

        <div class="admin-card-body">

            <div class="row g-4 align-items-center">

                <div class="col-lg-8">

                    <div class="d-flex align-items-start gap-3">

                        <div class="admin-card-icon">

                            <i class="bi bi-box-seam"></i>

                        </div>

                        <div class="min-w-0">

                            <div class="admin-form-help mb-1">
                                المنتج
                            </div>

                            <h2 class="admin-card-title mb-2">
                                @Model.Name
                            </h2>

                            <div class="d-flex flex-wrap gap-2">

                                @if (!string.IsNullOrWhiteSpace(Model.SKU))
                                {
                                    <span class="admin-badge admin-badge-neutral">
                                        <i class="bi bi-upc-scan"></i>
                                        @Model.SKU
                                    </span>
                                }

                                @if (Model.Category != null)
                                {
                                    <span class="admin-badge admin-badge-neutral">
                                        <i class="bi bi-folder2"></i>
                                        @Model.Category.Name
                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                </div>

                <div class="col-lg-4">

                    <div class="row g-3">

                        <div class="col-6">

                            <div class="admin-stat-card">

                                <div class="admin-stat-card-content">

                                    <div class="admin-stat-card-top">

                                        <div>

                                            <div class="admin-stat-label">
                                                الصور
                                            </div>

                                            <div class="admin-stat-value">
                                                @orderedImages.Count
                                            </div>

                                        </div>

                                        <div class="admin-stat-icon admin-stat-icon-primary">
                                            <i class="bi bi-images"></i>
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="col-6">

                            <div class="admin-stat-card">

                                <div class="admin-stat-card-content">

                                    <div class="admin-stat-card-top">

                                        <div>

                                            <div class="admin-stat-label">
                                                الرئيسية
                                            </div>

                                            <div class="admin-stat-value">
                                                @(primaryImage != null ? "1" : "0")
                                            </div>

                                        </div>

                                        <div class="admin-stat-icon admin-stat-icon-warning">
                                            <i class="bi bi-star-fill"></i>
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Upload Error -->
    @if (TempData["ImageError"] != null)
    {
        <div class="admin-alert admin-alert-danger mb-4"
             role="alert">

            <div class="admin-alert-icon">
                <i class="bi bi-exclamation-triangle"></i>
            </div>

            <div>

                <div class="fw-semibold mb-1">
                    فشل رفع الصورة
                </div>

                <div>
                    @TempData["ImageError"]
                </div>

            </div>

        </div>
    }


    <!-- Upload Image -->
    <div class="admin-card mb-4">

        <div class="admin-card-header">

            <div class="admin-card-header-content">

                <div class="admin-card-icon">
                    <i class="bi bi-cloud-arrow-up"></i>
                </div>

                <div>

                    <h2 class="admin-card-title">
                        رفع صورة جديدة
                    </h2>

                    <p class="admin-card-description">
                        إضافة صورة جديدة إلى هذا المنتج.
                    </p>

                </div>

            </div>

        </div>

        <div class="admin-card-body">

            <form asp-area="Admin"
                  asp-controller="Products"
                  asp-action="UploadImage"
                  asp-route-id="@Model.Id"
                  method="post"
                  enctype="multipart/form-data">

                <div class="row g-4 align-items-end">

                    <div class="col-lg-9">

                        <div class="admin-form-group mb-0">

                            <label for="image"
                                   class="admin-form-label">
                                اختيار الصورة
                            </label>

                            <input type="file"
                                   id="image"
                                   name="image"
                                   class="form-control admin-form-control product-image-file-input"
                                   accept=".jpg,.jpeg,.png,.webp,image/*" />

                            <div class="admin-form-help">
                                <i class="bi bi-info-circle"></i>
                                الصيغ المسموح بها: JPG, JPEG, PNG, WebP.
                                الحد الأقصى للحجم: 5 ميجابايت.
                            </div>

                        </div>

                    </div>

                    <div class="col-lg-3">

                        <button type="submit"
                                class="admin-btn admin-btn-primary w-100 product-upload-button">

                            <i class="bi bi-cloud-arrow-up"></i>
                            <span>رفع الصورة</span>

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- Product Images -->
    <div class="admin-card">

        <div class="admin-card-header">

            <div class="admin-card-header-row">

                <div class="admin-card-header-content">

                    <div class="admin-card-icon">
                        <i class="bi bi-grid"></i>
                    </div>

                    <div>

                        <h2 class="admin-card-title">
                            صور المنتج
                        </h2>

                        <p class="admin-card-description">
                            إعادة ترتيب الصور، وتحديد الصورة الرئيسية، أو حذف الصور.
                        </p>

                    </div>

                </div>

                <span class="admin-badge admin-badge-neutral">
                    <i class="bi bi-images"></i>
                    @orderedImages.Count صورة
                </span>

            </div>

        </div>

        <div class="admin-card-body">

            @if (!orderedImages.Any())
            {
                <div class="admin-empty-state">

                    <div class="admin-empty-icon">
                        <i class="bi bi-images"></i>
                    </div>

                    <h3 class="admin-empty-title">
                        لا توجد صور بعد
                    </h3>

                    <p class="admin-empty-description">
                        لم يتم رفع أي صور لهذا المنتج.
                    </p>

                    <p class="small text-muted mb-0">
                        ارفع الصورة الأولى باستخدام النموذج أعلاه.
                    </p>

                </div>
            }
            else
            {
                <div class="row g-4">

                    @for (var index = 0; index < orderedImages.Count; index++)
                    {
                        var image = orderedImages[index];

                        <div class="col-md-6 col-xl-4">

                            <div class="admin-image-card h-100">

                                <!-- Image -->
                                <div class="admin-image-preview">

                                    <img src="@image.ImagePath"
                                         alt="@image.AltText"
                                         class="admin-image-preview-img" />

                                    @if (image.IsPrimary)
                                    {
                                        <span class="admin-badge admin-badge-primary admin-image-primary-badge">
                                            <i class="bi bi-star-fill"></i>
                                            رئيسية
                                        </span>
                                    }

                                    <div class="admin-image-order-badge">

                                        <span>
                                            الترتيب
                                        </span>

                                        <strong>
                                            @(index + 1)
                                        </strong>

                                    </div>

                                </div>


                                <!-- Controls -->
                                <div class="admin-image-card-body">

                                    <div class="d-flex justify-content-between align-items-center mb-3">

                                        <div>

                                            <div class="admin-form-help mb-1">
                                                ترتيب العرض
                                            </div>

                                            <div class="fw-bold fs-5">
                                                @(index + 1)
                                            </div>

                                        </div>

                                        @if (image.IsPrimary)
                                        {
                                            <span class="admin-badge admin-badge-primary">
                                                الصورة الرئيسية
                                            </span>
                                        }

                                    </div>


                                    <!-- Move Controls -->
                                    <div class="d-flex gap-2 mb-3">

                                        @if (index > 0)
                                        {
                                            <form asp-area="Admin"
                                                  asp-controller="Products"
                                                  asp-action="MoveImageUp"
                                                  asp-route-id="@image.Id"
                                                  method="post"
                                                  class="flex-fill">

                                                <button type="submit"
                                                        class="admin-btn admin-btn-secondary admin-btn-sm w-100">

                                                    <i class="bi bi-arrow-up"></i>
                                                    <span>نقل لأعلى</span>

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="admin-btn admin-btn-secondary admin-btn-sm w-100"
                                                    disabled>

                                                <i class="bi bi-arrow-up"></i>
                                                <span>نقل لأعلى</span>

                                            </button>
                                        }

                                        @if (index < orderedImages.Count - 1)
                                        {
                                            <form asp-area="Admin"
                                                  asp-controller="Products"
                                                  asp-action="MoveImageDown"
                                                  asp-route-id="@image.Id"
                                                  method="post"
                                                  class="flex-fill">

                                                <button type="submit"
                                                        class="admin-btn admin-btn-secondary admin-btn-sm w-100">

                                                    <i class="bi bi-arrow-down"></i>
                                                    <span>نقل لأسفل</span>

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="admin-btn admin-btn-secondary admin-btn-sm w-100"
                                                    disabled>

                                                <i class="bi bi-arrow-down"></i>
                                                <span>نقل لأسفل</span>

                                            </button>
                                        }

                                    </div>


                                    <!-- Primary Image -->
                                    @if (!image.IsPrimary)
                                    {
                                        <form asp-area="Admin"
                                              asp-controller="Products"
                                              asp-action="SetPrimaryImage"
                                              asp-route-id="@image.Id"
                                              method="post"
                                              class="mb-2">

                                            <button type="submit"
                                                    class="admin-btn admin-btn-primary admin-btn-sm w-100">

                                                <i class="bi bi-star"></i>
                                                <span>تعيين كصورة رئيسية</span>

                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <div class="admin-alert admin-alert-info mb-2">

                                            <div class="admin-alert-icon">
                                                <i class="bi bi-star-fill"></i>
                                            </div>

                                            <div class="small">

                                                <div class="fw-semibold mb-1">
                                                    الصورة الرئيسية
                                                </div>

                                                <div>
                                                    هذه الصورة مستخدمة حاليًا كصورة المنتج الرئيسية.
                                                </div>

                                            </div>

                                        </div>
                                    }


                                    <!-- Delete -->
                                    <form asp-area="Admin"
                                          asp-controller="Products"
                                          asp-action="DeleteImage"
                                          asp-route-id="@image.Id"
                                          method="post"
                                          onsubmit="return confirm('هل أنت متأكد من رغبتك في حذف هذه الصورة؟');">

                                        <button type="submit"
                                                class="admin-btn admin-btn-outline-danger admin-btn-sm w-100">

                                            <i class="bi bi-trash"></i>
                                            <span>حذف الصورة</span>

                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }

        </div>

    </div>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/product-images.css"
          asp-append-version="true" />
}