@model ManholeCatalog.Models.Product

@{
    ViewData["Title"] = "Product Images";

    var orderedImages = Model.Images
        .OrderBy(i => i.DisplayOrder)
        .ThenBy(i => i.Id)
        .ToList();

    var primaryImage = orderedImages.FirstOrDefault(i => i.IsPrimary);
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

    <div>

        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">

            <span class="badge text-bg-light border">
                Product #@Model.Id
            </span>

            @if (Model.IsActive)
            {
                <span class="badge text-bg-success">
                    Active
                </span>
            }
            else
            {
                <span class="badge text-bg-secondary">
                    Inactive
                </span>
            }

        </div>

        <h1 class="h3 fw-bold mb-1">
            Product Images
        </h1>

        <p class="text-muted mb-0">
            Manage images, display order, and the primary product image.
        </p>

    </div>

    <div class="d-flex flex-wrap gap-2">

        <a asp-area="Admin"
           asp-controller="Products"
           asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-outline-primary">
            View Product
        </a>

        <a asp-area="Admin"
           asp-controller="Products"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Back to Products
        </a>

    </div>

</div>

<!-- Product Summary -->
<div class="card border-0 shadow-sm mb-4">

    <div class="card-body">

        <div class="row g-4 align-items-center">

            <div class="col-md-8">

                <div class="small text-muted mb-1">
                    Product
                </div>

                <h2 class="h5 fw-bold mb-2">
                    @Model.Name
                </h2>

                <div class="d-flex flex-wrap gap-2">

                    @if (!string.IsNullOrWhiteSpace(Model.SKU))
                    {
                        <span class="badge text-bg-light border">
                            SKU: @Model.SKU
                        </span>
                    }

                    @if (Model.Category != null)
                    {
                        <span class="badge text-bg-light border">
                            @Model.Category.Name
                        </span>
                    }

                </div>

            </div>

            <div class="col-md-4">

                <div class="d-flex justify-content-md-end gap-4">

                    <div class="text-center">

                        <div class="h4 fw-bold mb-0">
                            @orderedImages.Count
                        </div>

                        <div class="small text-muted">
                            Images
                        </div>

                    </div>

                    <div class="vr"></div>

                    <div class="text-center">

                        <div class="h4 fw-bold mb-0">
                            @(primaryImage != null ? "1" : "0")
                        </div>

                        <div class="small text-muted">
                            Primary
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@if (TempData["ImageError"] != null)
{
    <div class="alert alert-danger shadow-sm"
         role="alert">

        <strong>Upload failed:</strong>
        @TempData["ImageError"]

    </div>
}

<!-- Upload Image -->
<div class="card border-0 shadow-sm mb-4">

    <div class="card-header bg-white py-3">

        <h2 class="h6 fw-bold mb-1">
            Upload Image
        </h2>

        <p class="text-muted small mb-0">
            Add a new image to this product.
        </p>

    </div>

    <div class="card-body">

        <form asp-area="Admin"
              asp-controller="Products"
              asp-action="UploadImage"
              asp-route-id="@Model.Id"
              method="post"
              enctype="multipart/form-data">

            <div class="row g-3 align-items-end">

                <div class="col-md-9">

                    <label for="image"
                           class="form-label fw-semibold">
                        Select Image
                    </label>

                    <input type="file"
                           id="image"
                           name="image"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp,image/*" />

                    <div class="form-text">
                        Allowed formats: JPG, JPEG, PNG, WebP. Maximum size: 5 MB.
                    </div>

                </div>

                <div class="col-md-3">

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Upload Image
                    </button>

                </div>

            </div>

        </form>

    </div>

</div>

<!-- Product Images -->
<div class="card border-0 shadow-sm">

    <div class="card-header bg-white py-3">

        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">

            <div>

                <h2 class="h6 fw-bold mb-1">
                    Product Images
                </h2>

                <p class="text-muted small mb-0">
                    Reorder images, select the primary image, or remove images.
                </p>

            </div>

            <span class="badge text-bg-light border">
                @orderedImages.Count image(s)
            </span>

        </div>

    </div>

    <div class="card-body">

        @if (!orderedImages.Any())
        {
            <div class="text-center py-5">

                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light border mb-3"
                     style="width: 64px; height: 64px;">

                    <span class="text-muted fw-bold fs-5">
                        IMG
                    </span>

                </div>

                <h3 class="h6 fw-bold mb-2">
                    No Images Yet
                </h3>

                <p class="text-muted mb-1">
                    No images have been uploaded for this product.
                </p>

                <p class="small text-muted mb-0">
                    Upload the first image using the form above.
                </p>

            </div>
        }
        else
        {
            <div class="row g-4">

                @for (var index = 0; index < orderedImages.Count; index++)
                {
                    var image = orderedImages[index];

                    <div class="col-md-6 col-xl-4">

                        <div class="card h-100 border shadow-sm">

                            <!-- Image -->
                            <div class="position-relative">

                                <img src="@image.ImagePath"
                                     alt="@image.AltText"
                                     class="card-img-top"
                                     style="height: 240px; object-fit: contain; background-color: #f8f9fa;" />

                                @if (image.IsPrimary)
                                {
                                    <span class="position-absolute top-0 end-0 m-3 badge text-bg-primary">
                                        Primary
                                    </span>
                                }

                            </div>

                            <!-- Image Controls -->
                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-center mb-3">

                                    <div>

                                        <div class="small text-muted">
                                            Display Order
                                        </div>

                                        <div class="fw-semibold">
                                            @(index + 1)
                                        </div>

                                    </div>

                                    @if (image.IsPrimary)
                                    {
                                        <span class="badge text-bg-primary">
                                            Primary Image
                                        </span>
                                    }

                                </div>

                                <!-- Move Controls -->
                                <div class="d-flex gap-2 mb-3">

                                    @if (index > 0)
                                    {
                                        <form asp-area="Admin"
                                              asp-controller="Products"
                                              asp-action="MoveImageUp"
                                              asp-route-id="@image.Id"
                                              method="post"
                                              class="flex-fill">

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-secondary w-100">
                                                ↑ Move Up
                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary w-100"
                                                disabled>
                                            ↑ Move Up
                                        </button>
                                    }

                                    @if (index < orderedImages.Count - 1)
                                    {
                                        <form asp-area="Admin"
                                              asp-controller="Products"
                                              asp-action="MoveImageDown"
                                              asp-route-id="@image.Id"
                                              method="post"
                                              class="flex-fill">

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-secondary w-100">
                                                ↓ Move Down
                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary w-100"
                                                disabled>
                                            ↓ Move Down
                                        </button>
                                    }

                                </div>

                                <!-- Primary Image -->
                                @if (!image.IsPrimary)
                                {
                                    <form asp-area="Admin"
                                          asp-controller="Products"
                                          asp-action="SetPrimaryImage"
                                          asp-route-id="@image.Id"
                                          method="post"
                                          class="mb-2">

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-primary w-100">
                                            Set as Primary
                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <div class="alert alert-primary py-2 small mb-2">

                                        <div class="fw-semibold">
                                            Primary Image
                                        </div>

                                        <div>
                                            This image is currently used as the main product image.
                                        </div>

                                    </div>
                                }

                                <!-- Delete -->
                                <form asp-area="Admin"
                                      asp-controller="Products"
                                      asp-action="DeleteImage"
                                      asp-route-id="@image.Id"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this image?');">

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger w-100">
                                        Delete Image
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}