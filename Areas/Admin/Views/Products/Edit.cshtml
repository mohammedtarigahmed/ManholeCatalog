@model ManholeCatalog.Models.Product

@{
    ViewData["Title"] = "تعديل المنتج";
}

<!-- Page Header -->
<div class="product-edit-header mb-4">

    <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3">

        <div>

            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">

                <span class="badge rounded-pill text-bg-primary px-3 py-2">
                    <i class="bi bi-pencil-square me-1"></i>
                    إدارة المنتجات
                </span>

                <span class="badge rounded-pill text-bg-light border px-3 py-2">
                    المنتج #@Model.Id
                </span>

                @if (Model.IsActive)
                {
                    <span class="badge rounded-pill text-bg-success px-3 py-2">
                        <i class="bi bi-check-circle me-1"></i>
                        نشط
                    </span>
                }
                else
                {
                    <span class="badge rounded-pill text-bg-secondary px-3 py-2">
                        <i class="bi bi-pause-circle me-1"></i>
                        غير نشط
                    </span>
                }

            </div>

            <h1 class="h3 fw-bold mb-1">
                تعديل المنتج
            </h1>

            <p class="text-muted mb-0">
                تحديث معلومات المنتج ومواصفاته وظهوره في الكتالوج.
            </p>

        </div>


        <!-- Header Actions -->
        <div class="d-flex flex-wrap gap-2">

            <a asp-area="Admin"
               asp-controller="Products"
               asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn btn-outline-primary">

                <i class="bi bi-eye me-1"></i>

                عرض التفاصيل

            </a>

            <a asp-area="Admin"
               asp-controller="Products"
               asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-right me-1"></i>

                العودة إلى المنتجات

            </a>

        </div>

    </div>

</div>


<form asp-area="Admin"
      asp-controller="Products"
      asp-action="Edit"
      method="post">

    <input type="hidden"
           asp-for="Id" />


    <!-- Validation -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All"
             class="alert alert-danger border-0 shadow-sm mb-4"
             role="alert">

            <div class="d-flex align-items-start gap-3">

                <div class="product-edit-alert-icon bg-danger-subtle text-danger">

                    <i class="bi bi-exclamation-triangle"></i>

                </div>

                <div>

                    <div class="fw-semibold mb-1">
                        تعذر حفظ التغييرات
                    </div>

                    <div class="small">
                        يرجى مراجعة الأخطاء التالية ثم المحاولة مرة أخرى.
                    </div>

                </div>

            </div>

        </div>
    }


    <div class="row g-4">


        <!-- Basic Information -->
        <div class="col-12">

            <div class="card border-0 shadow-sm product-edit-card">

                <div class="card-header bg-white border-0 p-4">

                    <div class="d-flex align-items-center gap-3">

                        <div class="product-edit-section-icon bg-primary-subtle text-primary">

                            <i class="bi bi-info-circle"></i>

                        </div>

                        <div>

                            <h2 class="h6 fw-bold mb-1">
                                المعلومات الأساسية
                            </h2>

                            <p class="text-muted small mb-0">
                                تحديث المعلومات الأساسية المستخدمة للتعريف بالمنتج.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="card-body p-4">

                    <div class="row g-4">

                        <div class="col-lg-8">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Name"
                                   class="form-control product-edit-control"
                                   placeholder="مثال: غطاء منهول من حديد الدكتايل" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-lg-4">

                            <label asp-for="SKU"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="SKU"
                                   class="form-control product-edit-control"
                                   placeholder="مثال: MH-001" />

                            <span asp-validation-for="SKU"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-lg-6">

                            <label asp-for="CategoryId"
                                   class="form-label fw-semibold">

                                الفئة

                            </label>

                            <select asp-for="CategoryId"
                                    asp-items="ViewBag.CategoryId"
                                    class="form-select product-edit-control">

                                <option value="">
                                    -- اختر الفئة --
                                </option>

                            </select>

                            <span asp-validation-for="CategoryId"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                اختر الفئة التي تناسب هذا المنتج بشكل أفضل.
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Specifications -->
        <div class="col-12">

            <div class="card border-0 shadow-sm product-edit-card">

                <div class="card-header bg-white border-0 p-4">

                    <div class="d-flex align-items-center gap-3">

                        <div class="product-edit-section-icon bg-info-subtle text-info">

                            <i class="bi bi-rulers"></i>

                        </div>

                        <div>

                            <h2 class="h6 fw-bold mb-1">
                                مواصفات المنتج
                            </h2>

                            <p class="text-muted small mb-0">
                                تحديث المواصفات الفنية المتوفرة لهذا المنتج.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="card-body p-4">

                    <div class="row g-4">

                        <div class="col-lg-6">

                            <label asp-for="Material"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Material"
                                   class="form-control product-edit-control"
                                   placeholder="مثال: حديد الدكتايل" />

                            <span asp-validation-for="Material"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-lg-6">

                            <label asp-for="LoadClass"
                                   class="form-label fw-semibold">

                                فئة التحميل

                            </label>

                            <input asp-for="LoadClass"
                                   class="form-control product-edit-control"
                                   placeholder="مثال: D400" />

                            <span asp-validation-for="LoadClass"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-lg-6">

                            <label asp-for="Diameter"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Diameter"
                                   class="form-control product-edit-control"
                                   placeholder="مثال: 600 مم" />

                            <span asp-validation-for="Diameter"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-lg-6">

                            <label asp-for="Shape"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Shape"
                                   class="form-control product-edit-control"
                                   placeholder="مثال: دائري" />

                            <span asp-validation-for="Shape"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Price and Description -->
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm product-edit-card h-100">

                <div class="card-header bg-white border-0 p-4">

                    <div class="d-flex align-items-center gap-3">

                        <div class="product-edit-section-icon bg-success-subtle text-success">

                            <i class="bi bi-card-text"></i>

                        </div>

                        <div>

                            <h2 class="h6 fw-bold mb-1">
                                السعر والوصف
                            </h2>

                            <p class="text-muted small mb-0">
                                تحديث معلومات السعر والوصف الذي يظهر للعملاء.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="card-body p-4">

                    <div class="mb-4">

                        <label asp-for="Price"
                               class="form-label fw-semibold">
                        </label>

                        <div class="input-group">

                            <input asp-for="Price"
                                   class="form-control product-edit-control"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   placeholder="مثال: 450.00" />

                            <span class="input-group-text product-currency">
                                ر.س
                            </span>

                        </div>

                        <span asp-validation-for="Price"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            اترك الحقل فارغًا إذا كان سعر المنتج يُحدد عند الطلب.
                        </div>

                    </div>


                    <div>

                        <label asp-for="Description"
                               class="form-label fw-semibold">
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control product-edit-control"
                                  rows="7"
                                  placeholder="اكتب وصف المنتج واستخداماته ومميزاته أو أي معلومات مفيدة أخرى."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            اختياري. أضف معلومات مفيدة تساعد العملاء على فهم المنتج.
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Catalog Visibility -->
        <div class="col-lg-4">

            <div class="card border-0 shadow-sm product-edit-card h-100">

                <div class="card-header bg-white border-0 p-4">

                    <div class="d-flex align-items-center gap-3">

                        <div class="product-edit-section-icon bg-warning-subtle text-warning">

                            <i class="bi bi-eye"></i>

                        </div>

                        <div>

                            <h2 class="h6 fw-bold mb-1">
                                ظهور المنتج
                            </h2>

                            <p class="text-muted small mb-0">
                                تحديد حالة ظهور المنتج في الكتالوج.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="card-body p-4">

                    <div class="product-edit-status-box">

                        <div class="d-flex align-items-center justify-content-between gap-3">

                            <div>

                                <div class="fw-semibold mb-1">
                                    المنتج نشط
                                </div>

                                <div class="small text-muted">
                                    يظهر في الكتالوج العام.
                                </div>

                            </div>

                            <div class="form-check form-switch product-edit-switch mb-0">

                                <input asp-for="IsActive"
                                       class="form-check-input"
                                       role="switch" />

                            </div>

                        </div>

                    </div>


                    <div class="form-text mt-3">
                        المنتجات النشطة تظهر في الكتالوج العام ويمكنها استقبال طلبات عروض الأسعار.
                    </div>


                    <div class="alert alert-light border mt-4 mb-0">

                        <div class="d-flex align-items-start gap-2">

                            <i class="bi bi-info-circle text-primary mt-1"></i>

                            <div class="small">

                                <strong>ملاحظة:</strong>

                                تعطيل المنتج لا يؤدي إلى حذفه أو حذف صوره.

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Product Images Shortcut -->
        <div class="col-12">

            <div class="product-edit-images-banner">

                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">

                    <div class="d-flex align-items-start gap-3">

                        <div class="product-edit-section-icon bg-purple-subtle text-purple">

                            <i class="bi bi-images"></i>

                        </div>

                        <div>

                            <div class="fw-semibold mb-1">
                                صور المنتج
                            </div>

                            <div class="small text-muted">
                                لإدارة صور المنتج أو تغيير الصورة الرئيسية، انتقل إلى إدارة الصور.
                            </div>

                        </div>

                    </div>


                    <a asp-area="Admin"
                       asp-controller="Products"
                       asp-action="Images"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-primary flex-shrink-0">

                        <i class="bi bi-images me-1"></i>

                        إدارة الصور

                    </a>

                </div>

            </div>

        </div>


        <!-- Actions -->
        <div class="col-12">

            <div class="card border-0 shadow-sm product-edit-card">

                <div class="card-body p-4">

                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">

                        <a asp-area="Admin"
                           asp-controller="Products"
                           asp-action="Index"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-x-lg me-1"></i>

                            إلغاء

                        </a>

                        <a asp-area="Admin"
                           asp-controller="Products"
                           asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-primary">

                            <i class="bi bi-eye me-1"></i>

                            عرض التفاصيل

                        </a>

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-check2 me-1"></i>

                            حفظ التغييرات

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</form>


<style>

    .product-edit-card {
        border-radius: 16px;
        overflow: hidden;
    }

    .product-edit-header .btn {
        border-radius: 10px;
    }

    .product-edit-section-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 1.05rem;
    }

    .product-edit-alert-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .product-edit-control {
        border-radius: 10px;
        min-height: 44px;
    }

    textarea.product-edit-control {
        min-height: auto;
        line-height: 1.7;
    }

    .product-currency {
        border-radius: 0 10px 10px 0;
        font-weight: 600;
        background: #f8fafc;
    }

    .product-edit-status-box {
        padding: 16px;
        border-radius: 14px;
        background: #f8fafc;
        border: 1px solid #eef0f2;
    }

    .product-edit-switch {
        padding-left: 0;
        min-width: 48px;
    }

    .product-edit-switch .form-check-input {
        float: none;
        margin: 0;
        width: 2.8em;
        height: 1.5em;
        cursor: pointer;
    }

    .product-edit-images-banner {
        padding: 20px;
        border-radius: 16px;
        background: linear-gradient(135deg, #f8fafc, #ffffff);
        border: 1px solid #e5e7eb;
    }

    .bg-purple-subtle {
        background-color: #f3e8ff;
    }

    .text-purple {
        color: #7e22ce;
    }

    .product-edit-card .btn,
    .product-edit-images-banner .btn {
        border-radius: 9px;
    }

    @@media (max-width: 767.98px) {

        .product-edit-header .btn {
            width: 100%;
        }

        .product-edit-images-banner .btn {
            width: 100%;
        }

    }

</style>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}