@model ManholeCatalog.Models.Product

@{
ViewData["Title"] = "تعديل المنتج";
}

<div class="admin-page">

<div class="admin-page-header">

    <div class="admin-page-header-row">

        <div class="admin-page-header-main">

            <div class="admin-page-header-eyebrow">
                <i class="bi bi-pencil-square"></i>
                إدارة المنتجات
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">

                <span class="admin-badge admin-badge-neutral">
                    المنتج #@Model.Id
                </span>

                @if (Model.IsActive)
                {
                    <span class="admin-badge admin-badge-success">
                        <i class="bi bi-check-circle"></i>
                        نشط
                    </span>
                }
                else
                {
                    <span class="admin-badge admin-badge-neutral">
                        <i class="bi bi-pause-circle"></i>
                        غير نشط
                    </span>
                }

            </div>

            <h1 class="admin-page-header-title">
                تعديل المنتج
            </h1>

            <p class="admin-page-header-description">
                تحديث معلومات المنتج ومواصفاته وظهوره في الكتالوج.
            </p>

        </div>

        <div class="admin-page-header-actions">

            <a asp-area="Admin"
               asp-controller="Products"
               asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn admin-btn admin-btn-secondary">

                <i class="bi bi-eye"></i>

                <span>
                    عرض التفاصيل
                </span>

            </a>

            <a asp-area="Admin"
               asp-controller="Products"
               asp-action="Index"
               class="btn admin-btn admin-btn-secondary">

                <i class="bi bi-arrow-right"></i>

                <span>
                    العودة إلى المنتجات
                </span>

            </a>

        </div>

    </div>

</div>


<form asp-area="Admin"
      asp-controller="Products"
      asp-action="Edit"
      method="post">

    <input type="hidden"
           asp-for="Id" />


    @if (!ViewData.ModelState.IsValid)
    {
        <div class="admin-alert admin-alert-danger mb-4"
             role="alert">

            <div class="admin-alert-icon">
                <i class="bi bi-exclamation-triangle"></i>
            </div>

            <div>
                <div class="fw-semibold mb-1">
                    تعذر حفظ التغييرات
                </div>

                <div class="small">
                    يرجى مراجعة الأخطاء التالية ثم المحاولة مرة أخرى.
                </div>

                <div asp-validation-summary="All"
                     class="mt-2">
                </div>
            </div>

        </div>
    }


    <div class="row g-4">


        <!-- Basic Information -->
        <div class="col-12">

            <div class="admin-card">

                <div class="admin-card-header">

                    <div class="admin-card-header-row">

                        <div class="admin-card-header-content">

                            <div class="admin-card-icon">
                                <i class="bi bi-info-circle"></i>
                            </div>

                            <div>

                                <h2 class="admin-card-title">
                                    المعلومات الأساسية
                                </h2>

                                <p class="admin-card-description">
                                    تحديث المعلومات الأساسية المستخدمة للتعريف بالمنتج.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>


                <div class="admin-card-body">

                    <div class="row g-4">

                        <div class="col-lg-8">

                            <div class="admin-form-group">

                                <label asp-for="Name"
                                       class="admin-form-label">
                                </label>

                                <input asp-for="Name"
                                       class="form-control admin-form-control"
                                       placeholder="مثال: غطاء منهول من حديد الدكتايل" />

                                <span asp-validation-for="Name"
                                      class="admin-form-validation">
                                </span>

                            </div>

                        </div>


                        <div class="col-lg-4">

                            <div class="admin-form-group">

                                <label asp-for="SKU"
                                       class="admin-form-label">
                                </label>

                                <input asp-for="SKU"
                                       class="form-control admin-form-control"
                                       placeholder="مثال: MH-001" />

                                <span asp-validation-for="SKU"
                                      class="admin-form-validation">
                                </span>

                            </div>

                        </div>


                        <div class="col-lg-6">

                            <div class="admin-form-group">

                                <label asp-for="CategoryId"
                                       class="admin-form-label admin-form-label-required">
                                    الفئة
                                </label>

                                <select asp-for="CategoryId"
                                        asp-items="ViewBag.CategoryId"
                                        class="form-select admin-form-select">

                                    <option value="">
                                        -- اختر الفئة --
                                    </option>

                                </select>

                                <span asp-validation-for="CategoryId"
                                      class="admin-form-validation">
                                </span>

                                <div class="admin-form-help">
                                    اختر الفئة التي تناسب هذا المنتج بشكل أفضل.
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Specifications -->
        <div class="col-12">

            <div class="admin-card">

                <div class="admin-card-header">

                    <div class="admin-card-header-row">

                        <div class="admin-card-header-content">

                            <div class="admin-card-icon">
                                <i class="bi bi-sliders"></i>
                            </div>

                            <div>

                                <h2 class="admin-card-title">
                                    مواصفات المنتج
                                </h2>

                                <p class="admin-card-description">
                                    تحديث المواصفات الفنية المتوفرة لهذا المنتج.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>


                <div class="admin-card-body">

                    <div class="row g-4">

                        <div class="col-lg-6">

                            <div class="admin-form-group">

                                <label asp-for="Material"
                                       class="admin-form-label">
                                </label>

                                <input asp-for="Material"
                                       class="form-control admin-form-control"
                                       placeholder="مثال: حديد الدكتايل" />

                                <span asp-validation-for="Material"
                                      class="admin-form-validation">
                                </span>

                            </div>

                        </div>


                        <div class="col-lg-6">

                            <div class="admin-form-group">

                                <label asp-for="LoadClass"
                                       class="admin-form-label">
                                    فئة التحميل
                                </label>

                                <input asp-for="LoadClass"
                                       class="form-control admin-form-control"
                                       placeholder="مثال: D400" />

                                <span asp-validation-for="LoadClass"
                                      class="admin-form-validation">
                                </span>

                            </div>

                        </div>


                        <div class="col-lg-6">

                            <div class="admin-form-group">

                                <label asp-for="Diameter"
                                       class="admin-form-label">
                                </label>

                                <input asp-for="Diameter"
                                       class="form-control admin-form-control"
                                       placeholder="مثال: 600 مم" />

                                <span asp-validation-for="Diameter"
                                      class="admin-form-validation">
                                </span>

                            </div>

                        </div>


                        <div class="col-lg-6">

                            <div class="admin-form-group">

                                <label asp-for="Shape"
                                       class="admin-form-label">
                                </label>

                                <input asp-for="Shape"
                                       class="form-control admin-form-control"
                                       placeholder="مثال: دائري" />

                                <span asp-validation-for="Shape"
                                      class="admin-form-validation">
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Price and Description -->
        <div class="col-lg-8">

            <div class="admin-card h-100">

                <div class="admin-card-header">

                    <div class="admin-card-header-row">

                        <div class="admin-card-header-content">

                            <div class="admin-card-icon">
                                <i class="bi bi-card-text"></i>
                            </div>

                            <div>

                                <h2 class="admin-card-title">
                                    السعر والوصف
                                </h2>

                                <p class="admin-card-description">
                                    تحديث معلومات السعر والوصف الذي يظهر للعملاء.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>


                <div class="admin-card-body">

                    <div class="admin-form-group mb-4">

                        <label asp-for="Price"
                               class="admin-form-label">
                        </label>

                        <div class="input-group">

                            <input asp-for="Price"
                                   class="form-control admin-form-control"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   placeholder="مثال: 450.00" />

                            <span class="input-group-text">
                                ر.س
                            </span>

                        </div>

                        <span asp-validation-for="Price"
                              class="admin-form-validation">
                        </span>

                        <div class="admin-form-help">
                            اترك الحقل فارغًا إذا كان سعر المنتج يُحدد عند الطلب.
                        </div>

                    </div>


                    <div class="admin-form-group">

                        <label asp-for="Description"
                               class="admin-form-label">
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control admin-form-control"
                                  rows="7"
                                  placeholder="اكتب وصف المنتج واستخداماته ومميزاته أو أي معلومات مفيدة أخرى."></textarea>

                        <span asp-validation-for="Description"
                              class="admin-form-validation">
                        </span>

                        <div class="admin-form-help">
                            اختياري. أضف معلومات مفيدة تساعد العملاء على فهم المنتج.
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Catalog Visibility -->
        <div class="col-lg-4">

            <div class="admin-card h-100">

                <div class="admin-card-header">

                    <div class="admin-card-header-row">

                        <div class="admin-card-header-content">

                            <div class="admin-card-icon">
                                <i class="bi bi-eye"></i>
                            </div>

                            <div>

                                <h2 class="admin-card-title">
                                    ظهور المنتج
                                </h2>

                                <p class="admin-card-description">
                                    تحديد حالة ظهور المنتج في الكتالوج.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>


                <div class="admin-card-body">

                    <div class="admin-status-box">

                        <div class="d-flex align-items-center justify-content-between gap-3">

                            <div>

                                <div class="fw-semibold mb-1">
                                    المنتج نشط
                                </div>

                                <div class="small text-muted">
                                    يظهر في الكتالوج العام.
                                </div>

                            </div>

                            <div class="form-check form-switch admin-form-switch mb-0">

                                <input asp-for="IsActive"
                                       class="form-check-input"
                                       role="switch" />

                            </div>

                        </div>

                    </div>


                    <div class="admin-form-help mt-3">
                        المنتجات النشطة تظهر في الكتالوج العام ويمكنها استقبال طلبات عروض الأسعار.
                    </div>


                    <div class="admin-alert admin-alert-info mt-4 mb-0">

                        <div class="admin-alert-icon">
                            <i class="bi bi-info-circle"></i>
                        </div>

                        <div class="small">

                            <strong>ملاحظة:</strong>

                            تعطيل المنتج لا يؤدي إلى حذفه أو حذف صوره.

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Product Images -->
        <div class="col-12">

            <div class="admin-card">

                <div class="admin-card-body">

                    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">

                        <div class="admin-card-header-content">

                            <div class="admin-card-icon">
                                <i class="bi bi-images"></i>
                            </div>

                            <div>

                                <h2 class="admin-card-title">
                                    صور المنتج
                                </h2>

                                <p class="admin-card-description">
                                    لإدارة صور المنتج أو تغيير الصورة الرئيسية، انتقل إلى إدارة الصور.
                                </p>

                            </div>

                        </div>


                        <a asp-area="Admin"
                           asp-controller="Products"
                           asp-action="Images"
                           asp-route-id="@Model.Id"
                           class="btn admin-btn admin-btn-secondary flex-shrink-0">

                            <i class="bi bi-images"></i>

                            <span>
                                إدارة الصور
                            </span>

                        </a>

                    </div>

                </div>

            </div>

        </div>


        <!-- Actions -->
        <div class="col-12">

            <div class="admin-card">

                <div class="admin-card-body">

                    <div class="admin-form-actions justify-content-end">

                        <a asp-area="Admin"
                           asp-controller="Products"
                           asp-action="Index"
                           class="btn admin-btn admin-btn-secondary">

                            <i class="bi bi-x-lg"></i>

                            <span>
                                إلغاء
                            </span>

                        </a>


                        <a asp-area="Admin"
                           asp-controller="Products"
                           asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="btn admin-btn admin-btn-secondary">

                            <i class="bi bi-eye"></i>

                            <span>
                                عرض التفاصيل
                            </span>

                        </a>


                        <button type="submit"
                                class="btn admin-btn admin-btn-primary">

                            <i class="bi bi-check2"></i>

                            <span>
                                حفظ التغييرات
                            </span>

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</form>

</div>

@section Scripts {

<partial name="_ValidationScriptsPartial" />

}