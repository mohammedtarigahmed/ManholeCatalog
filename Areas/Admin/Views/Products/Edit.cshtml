@model ManholeCatalog.Models.Product

@{
    ViewData["Title"] = "تعديل المنتج";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

    <div>

        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">

            <span class="badge text-bg-light border">
                المنتج #@Model.Id
            </span>

            @if (Model.IsActive)
            {
                <span class="badge text-bg-success">
                    نشط
                </span>
            }
            else
            {
                <span class="badge text-bg-secondary">
                    غير نشط
                </span>
            }

        </div>

        <h1 class="h3 fw-bold mb-1">
            تعديل المنتج
        </h1>

        <p class="text-muted mb-0">
            تحديث معلومات المنتج وظهوره في الكتالوج.
        </p>

    </div>

    <div class="d-flex flex-wrap gap-2">

        <a asp-area="Admin"
           asp-controller="Products"
           asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-outline-primary">
            عرض التفاصيل
        </a>

        <a asp-area="Admin"
           asp-controller="Products"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← العودة إلى المنتجات
        </a>

    </div>

</div>

<form asp-area="Admin"
      asp-controller="Products"
      asp-action="Edit"
      method="post">

    <input type="hidden"
           asp-for="Id" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All"
             class="alert alert-danger"
             role="alert">
        </div>
    }

    <div class="row g-4">

        <!-- المعلومات الأساسية -->
        <div class="col-12">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">

                    <h2 class="h6 fw-bold mb-1">
                        المعلومات الأساسية
                    </h2>

                    <p class="text-muted small mb-0">
                        تحديث المعلومات الأساسية المستخدمة للتعريف بالمنتج.
                    </p>

                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-8">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="مثال: غطاء منهول من حديد الدكتايل" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-4">

                            <label asp-for="SKU"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="SKU"
                                   class="form-control"
                                   placeholder="مثال: MH-001" />

                            <span asp-validation-for="SKU"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="CategoryId"
                                   class="form-label fw-semibold">
                                الفئة
                            </label>

                            <select asp-for="CategoryId"
                                    asp-items="ViewBag.CategoryId"
                                    class="form-select">

                                <option value="">
                                    -- اختر الفئة --
                                </option>

                            </select>

                            <span asp-validation-for="CategoryId"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                اختر الفئة التي تناسب هذا المنتج بشكل أفضل.
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- مواصفات المنتج -->
        <div class="col-12">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">

                    <h2 class="h6 fw-bold mb-1">
                        مواصفات المنتج
                    </h2>

                    <p class="text-muted small mb-0">
                        تحديث المواصفات الفنية المتوفرة لهذا المنتج.
                    </p>

                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label asp-for="Material"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Material"
                                   class="form-control"
                                   placeholder="مثال: حديد الدكتايل" />

                            <span asp-validation-for="Material"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="LoadClass"
                                   class="form-label fw-semibold">
                                فئة التحميل
                            </label>

                            <input asp-for="LoadClass"
                                   class="form-control"
                                   placeholder="مثال: D400" />

                            <span asp-validation-for="LoadClass"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="Diameter"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Diameter"
                                   class="form-control"
                                   placeholder="مثال: 600 مم" />

                            <span asp-validation-for="Diameter"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="Shape"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Shape"
                                   class="form-control"
                                   placeholder="مثال: دائري" />

                            <span asp-validation-for="Shape"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- السعر والوصف -->
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white py-3">

                    <h2 class="h6 fw-bold mb-1">
                        السعر والوصف
                    </h2>

                    <p class="text-muted small mb-0">
                        تحديث معلومات السعر والوصف الذي يظهر للعملاء.
                    </p>

                </div>

                <div class="card-body">

                    <div class="mb-4">

                        <label asp-for="Price"
                               class="form-label fw-semibold">
                        </label>

                        <div class="input-group">

                            <input asp-for="Price"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   placeholder="مثال: 450.00" />

                            <span class="input-group-text">
                                ر.س
                            </span>

                        </div>

                        <span asp-validation-for="Price"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            اترك الحقل فارغًا إذا كان سعر المنتج يُحدد عند الطلب.
                        </div>

                    </div>

                    <div>

                        <label asp-for="Description"
                               class="form-label fw-semibold">
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="6"
                                  placeholder="اكتب وصف المنتج واستخداماته ومميزاته أو أي معلومات مفيدة أخرى."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            اختياري. أضف معلومات مفيدة تساعد العملاء على فهم المنتج.
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- ظهور المنتج في الكتالوج -->
        <div class="col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white py-3">

                    <h2 class="h6 fw-bold mb-1">
                        ظهور المنتج في الكتالوج
                    </h2>

                    <p class="text-muted small mb-0">
                        تحديد ما إذا كان هذا المنتج سيظهر في الكتالوج العام.
                    </p>

                </div>

                <div class="card-body">

                    <div class="form-check form-switch">

                        <input asp-for="IsActive"
                               class="form-check-input"
                               role="switch" />

                        <label asp-for="IsActive"
                               class="form-check-label fw-semibold">
                            المنتج نشط
                        </label>

                    </div>

                    <div class="form-text mt-2">
                        المنتجات النشطة تظهر في الكتالوج العام ويمكنها استقبال طلبات عروض الأسعار.
                    </div>

                    <div class="alert alert-light border mt-4 mb-0">

                        <div class="small">

                            <strong>ملاحظة:</strong>

                            تعطيل المنتج لا يؤدي إلى حذفه أو حذف صوره.

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- الإجراءات -->
        <div class="col-12">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">

                        <a asp-area="Admin"
                           asp-controller="Products"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            إلغاء
                        </a>

                        <a asp-area="Admin"
                           asp-controller="Products"
                           asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-primary">
                            عرض التفاصيل
                        </a>

                        <button type="submit"
                                class="btn btn-primary">
                            حفظ التغييرات
                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</form>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}