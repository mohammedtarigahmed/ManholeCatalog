@model ManholeCatalog.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">

            <span class="badge text-bg-light border">
                Product #@Model.Id
            </span>

            @if (Model.IsActive)
            {
                <span class="badge text-bg-success">
                    Active
                </span>
            }
            else
            {
                <span class="badge text-bg-secondary">
                    Inactive
                </span>
            }

        </div>

        <h1 class="h3 fw-bold mb-1">
            Edit Product
        </h1>

        <p class="text-muted mb-0">
            Update the product information and catalog visibility.
        </p>
    </div>

    <div class="d-flex flex-wrap gap-2">

        <a asp-area="Admin"
           asp-controller="Products"
           asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-outline-primary">
            View Details
        </a>

        <a asp-area="Admin"
           asp-controller="Products"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Back to Products
        </a>

    </div>
</div>

<form asp-area="Admin"
      asp-controller="Products"
      asp-action="Edit"
      method="post">

    <input type="hidden"
           asp-for="Id" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All"
             class="alert alert-danger"
             role="alert">
        </div>
    }

    <div class="row g-4">

        <!-- Basic Information -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">
                    <h2 class="h6 fw-bold mb-1">
                        Basic Information
                    </h2>

                    <p class="text-muted small mb-0">
                        Update the main information used to identify the product.
                    </p>
                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-8">
                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="e.g. Ductile Iron Manhole Cover" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="SKU"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="SKU"
                                   class="form-control"
                                   placeholder="e.g. MH-001" />

                            <span asp-validation-for="SKU"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CategoryId"
                                   class="form-label fw-semibold">
                                Category
                            </label>

                            <select asp-for="CategoryId"
                                    asp-items="ViewBag.CategoryId"
                                    class="form-select">

                                <option value="">
                                    -- Select Category --
                                </option>

                            </select>

                            <span asp-validation-for="CategoryId"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Select the category that best matches this product.
                            </div>
                        </div>

                    </div>

                </div>

            </div>
        </div>

        <!-- Product Specifications -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">
                    <h2 class="h6 fw-bold mb-1">
                        Product Specifications
                    </h2>

                    <p class="text-muted small mb-0">
                        Update the technical specifications available for this product.
                    </p>
                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="Material"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Material"
                                   class="form-control"
                                   placeholder="e.g. Ductile Iron" />

                            <span asp-validation-for="Material"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LoadClass"
                                   class="form-label fw-semibold">
                                Load Class
                            </label>

                            <input asp-for="LoadClass"
                                   class="form-control"
                                   placeholder="e.g. D400" />

                            <span asp-validation-for="LoadClass"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Diameter"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Diameter"
                                   class="form-control"
                                   placeholder="e.g. 600 mm" />

                            <span asp-validation-for="Diameter"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Shape"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Shape"
                                   class="form-control"
                                   placeholder="e.g. Circular" />

                            <span asp-validation-for="Shape"
                                  class="text-danger">
                            </span>
                        </div>

                    </div>

                </div>

            </div>
        </div>

        <!-- Pricing and Description -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white py-3">
                    <h2 class="h6 fw-bold mb-1">
                        Pricing &amp; Description
                    </h2>

                    <p class="text-muted small mb-0">
                        Update pricing information and the customer-facing description.
                    </p>
                </div>

                <div class="card-body">

                    <div class="mb-4">

                        <label asp-for="Price"
                               class="form-label fw-semibold">
                        </label>

                        <div class="input-group">

                            <input asp-for="Price"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   placeholder="e.g. 450.00" />

                            <span class="input-group-text">
                                SAR
                            </span>

                        </div>

                        <span asp-validation-for="Price"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            Leave empty if the product price is provided on request.
                        </div>

                    </div>

                    <div>

                        <label asp-for="Description"
                               class="form-label fw-semibold">
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="6"
                                  placeholder="Describe the product, its applications, features, or other useful information."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            Optional. Provide useful information that helps customers understand the product.
                        </div>

                    </div>

                </div>

            </div>
        </div>

        <!-- Catalog Visibility -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white py-3">
                    <h2 class="h6 fw-bold mb-1">
                        Catalog Visibility
                    </h2>

                    <p class="text-muted small mb-0">
                        Control whether this product appears in the public catalog.
                    </p>
                </div>

                <div class="card-body">

                    <div class="form-check form-switch">

                        <input asp-for="IsActive"
                               class="form-check-input"
                               role="switch" />

                        <label asp-for="IsActive"
                               class="form-check-label fw-semibold">
                            Active Product
                        </label>

                    </div>

                    <div class="form-text mt-2">
                        Active products are visible in the public catalog and can receive quotation requests.
                    </div>

                    <div class="alert alert-light border mt-4 mb-0">
                        <div class="small">
                            <strong>Note:</strong>
                            Deactivating a product does not delete the product or its images.
                        </div>
                    </div>

                </div>

            </div>
        </div>

        <!-- Actions -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">

                        <a asp-area="Admin"
                           asp-controller="Products"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <a asp-area="Admin"
                           asp-controller="Products"
                           asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-primary">
                            View Details
                        </a>

                        <button type="submit"
                                class="btn btn-primary">
                            Save Changes
                        </button>

                    </div>

                </div>

            </div>
        </div>

    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}