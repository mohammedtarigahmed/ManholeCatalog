@model IEnumerable<ManholeCatalog.Models.Product>

@{
    ViewData["Title"] = "المنتجات";

    var products = Model.ToList();

    var totalProducts = products.Count;
    var activeProducts = products.Count(p => p.IsActive);
    var inactiveProducts = products.Count(p => !p.IsActive);
    var productsWithoutImages = products.Count(p => !p.Images.Any());
}

<div class="admin-page">

    <!-- Page Header -->
    <div class="admin-page-header">

        <div class="admin-page-header-row">

            <div class="admin-page-header-main">

                <div class="admin-page-header-eyebrow">
                    إدارة الكتالوج
                </div>

                <h1 class="admin-page-header-title">
                    المنتجات
                </h1>

                <p class="admin-page-header-description">
                    إدارة منتجات الكتالوج وصور المنتجات وحالاتها.
                </p>

            </div>

            <div class="admin-page-header-actions">

                <a asp-area="Admin"
                   asp-controller="Products"
                   asp-action="Create"
                   class="btn admin-btn admin-btn-primary">

                    <i class="bi bi-plus-lg"></i>

                    <span>
                        إضافة منتج
                    </span>

                </a>

            </div>

        </div>

    </div>


    <!-- Statistics -->
    <div class="admin-stats-grid mb-4">

        <!-- Total Products -->
        <div class="admin-stat-card">

            <div class="admin-stat-card-content">

                <div class="admin-stat-card-top">

                    <div>

                        <div class="admin-stat-label">
                            إجمالي المنتجات
                        </div>

                        <div class="admin-stat-value">
                            @totalProducts
                        </div>

                    </div>

                    <div class="admin-stat-icon admin-stat-icon-primary">

                        <i class="bi bi-box-seam"></i>

                    </div>

                </div>

                <div class="admin-stat-note">

                    <i class="bi bi-box-seam"></i>

                    جميع المنتجات في الكتالوج.

                </div>

            </div>

        </div>


        <!-- Active Products -->
        <div class="admin-stat-card">

            <div class="admin-stat-card-content">

                <div class="admin-stat-card-top">

                    <div>

                        <div class="admin-stat-label">
                            المنتجات النشطة
                        </div>

                        <div class="admin-stat-value admin-stat-value-success">
                            @activeProducts
                        </div>

                    </div>

                    <div class="admin-stat-icon admin-stat-icon-success">

                        <i class="bi bi-check-circle"></i>

                    </div>

                </div>

                <div class="admin-stat-note">

                    <i class="bi bi-eye"></i>

                    متاحة حاليًا للعملاء.

                </div>

            </div>

        </div>


        <!-- Inactive Products -->
        <div class="admin-stat-card">

            <div class="admin-stat-card-content">

                <div class="admin-stat-card-top">

                    <div>

                        <div class="admin-stat-label">
                            المنتجات غير النشطة
                        </div>

                        <div class="admin-stat-value">
                            @inactiveProducts
                        </div>

                    </div>

                    <div class="admin-stat-icon admin-stat-icon-neutral">

                        <i class="bi bi-pause-circle"></i>

                    </div>

                </div>

                <div class="admin-stat-note">

                    <i class="bi bi-eye-slash"></i>

                    غير ظاهرة حاليًا في الكتالوج.

                </div>

            </div>

        </div>


        <!-- Products Without Images -->
        <div class="admin-stat-card">

            <div class="admin-stat-card-content">

                <div class="admin-stat-card-top">

                    <div>

                        <div class="admin-stat-label">
                            بدون صور
                        </div>

                        <div class="admin-stat-value admin-stat-value-warning">
                            @productsWithoutImages
                        </div>

                    </div>

                    <div class="admin-stat-icon admin-stat-icon-warning">

                        <i class="bi bi-images"></i>

                    </div>

                </div>

                <div class="admin-stat-note">

                    <i class="bi bi-image"></i>

                    منتجات قد تحتاج إلى إضافة صور.

                </div>

            </div>

        </div>

    </div>


    @if (!products.Any())
    {
        <!-- Empty State -->

        <div class="admin-card">

            <div class="admin-card-body">

                <div class="admin-empty-state">

                    <div class="admin-empty-icon">

                        <i class="bi bi-box-seam"></i>

                    </div>

                    <h2 class="admin-empty-title">
                        لا توجد منتجات بعد
                    </h2>

                    <p class="admin-empty-description">
                        ابدأ ببناء الكتالوج من خلال إضافة أول منتج.
                    </p>

                    <a asp-area="Admin"
                       asp-controller="Products"
                       asp-action="Create"
                       class="btn admin-btn admin-btn-primary">

                        <i class="bi bi-plus-lg"></i>

                        <span>
                            إضافة أول منتج
                        </span>

                    </a>

                </div>

            </div>

        </div>
    }
    else
    {
        <!-- Product List -->

        <div class="admin-card">

            <!-- Card Header -->
            <div class="admin-card-header">

                <div class="admin-card-header-row">

                    <div class="admin-card-header-content">

                        <div class="admin-card-icon">

                            <i class="bi bi-list-ul"></i>

                        </div>

                        <div>

                            <h2 class="admin-card-title">
                                قائمة المنتجات
                            </h2>

                            <p class="admin-card-description">
                                عرض وإدارة جميع منتجات الكتالوج.
                            </p>

                        </div>

                    </div>

                    <div class="d-flex flex-wrap gap-2">

                        <span class="admin-badge admin-badge-neutral">
                            @totalProducts منتج
                        </span>

                        @if (activeProducts > 0)
                        {
                            <span class="admin-badge admin-badge-success">
                                @activeProducts نشط
                            </span>
                        }

                        @if (productsWithoutImages > 0)
                        {
                            <span class="admin-badge admin-badge-warning">
                                @productsWithoutImages بدون صور
                            </span>
                        }

                    </div>

                </div>

            </div>


            <!-- Table -->
            <div class="admin-card-body p-0">

                <div class="admin-table-wrapper">

                    <table class="table admin-table admin-products-table align-middle mb-0">

                        <thead>

                            <tr>

                                <th>
                                    المنتج
                                </th>

                                <th>
                                    الرقم التعريفي
                                </th>

                                <th>
                                    الفئة
                                </th>

                                <th>
                                    الصور
                                </th>

                                <th>
                                    الحالة
                                </th>

                                <th>
                                    الإجراءات
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var product in products)
                            {
                                var primaryImage = product.Images.FirstOrDefault(i => i.IsPrimary)
                                    ?? product.Images.OrderBy(i => i.DisplayOrder).FirstOrDefault();

                                <tr>

                                    <!-- Product -->
                                    <td>

                                        <div class="admin-product-cell">

                                            <div class="admin-product-image">

                                                @if (primaryImage != null)
                                                {
                                                    <img src="@primaryImage.ImagePath"
                                                         alt="@(primaryImage.AltText ?? product.Name)" />
                                                }
                                                else
                                                {
                                                    <i class="bi bi-box-seam"></i>
                                                }

                                            </div>

                                            <div class="admin-product-content">

                                                <div class="admin-product-name">
                                                    @product.Name
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(product.Material) ||
                                                     !string.IsNullOrWhiteSpace(product.LoadClass))
                                                {
                                                    <div class="admin-product-meta">

                                                        @if (!string.IsNullOrWhiteSpace(product.Material))
                                                        {
                                                            @product.Material
                                                        }

                                                        @if (!string.IsNullOrWhiteSpace(product.Material) &&
                                                             !string.IsNullOrWhiteSpace(product.LoadClass))
                                                        {
                                                            <span> · </span>
                                                        }

                                                        @if (!string.IsNullOrWhiteSpace(product.LoadClass))
                                                        {
                                                            @product.LoadClass
                                                        }

                                                    </div>
                                                }

                                            </div>

                                        </div>

                                    </td>


                                    <!-- SKU -->
                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(product.SKU))
                                        {
                                            <span class="admin-product-sku">
                                                @product.SKU
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <!-- Category -->
                                    <td>

                                        @if (product.Category != null)
                                        {
                                            <span class="admin-badge admin-badge-neutral">
                                                @product.Category.Name
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <!-- Images -->
                                    <td>

                                        @if (product.Images.Any())
                                        {
                                            <span class="admin-badge admin-badge-neutral">

                                                <i class="bi bi-image"></i>

                                                <span>
                                                    @product.Images.Count
                                                </span>

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="admin-badge admin-badge-warning">

                                                <i class="bi bi-image"></i>

                                                <span>
                                                    لا توجد
                                                </span>

                                            </span>
                                        }

                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (product.IsActive)
                                        {
                                            <span class="admin-badge admin-badge-success">

                                                <i class="bi bi-check-circle"></i>

                                                <span>
                                                    نشط
                                                </span>

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="admin-badge admin-badge-neutral">

                                                <i class="bi bi-pause-circle"></i>

                                                <span>
                                                    غير نشط
                                                </span>

                                            </span>
                                        }

                                    </td>


                                    <!-- Actions -->
                                    <td>

                                        <div class="admin-table-actions">

                                            <div class="dropdown">

                                                <button type="button"
                                                        class="btn admin-btn admin-btn-secondary admin-btn-sm"
                                                        data-bs-toggle="dropdown"
                                                        aria-expanded="false">

                                                    <i class="bi bi-three-dots"></i>

                                                    <span>
                                                        إجراءات
                                                    </span>

                                                </button>

                                                <ul class="dropdown-menu dropdown-menu-end admin-products-dropdown">

                                                    <li>

                                                        <a asp-area="Admin"
                                                           asp-controller="Products"
                                                           asp-action="Details"
                                                           asp-route-id="@product.Id"
                                                           class="dropdown-item">

                                                            <i class="bi bi-eye"></i>

                                                            <span>
                                                                عرض المنتج
                                                            </span>

                                                        </a>

                                                    </li>

                                                    <li>

                                                        <a asp-area="Admin"
                                                           asp-controller="Products"
                                                           asp-action="Images"
                                                           asp-route-id="@product.Id"
                                                           class="dropdown-item">

                                                            <i class="bi bi-images"></i>

                                                            <span>
                                                                إدارة الصور
                                                            </span>

                                                        </a>

                                                    </li>

                                                    <li>

                                                        <a asp-area="Admin"
                                                           asp-controller="Products"
                                                           asp-action="Edit"
                                                           asp-route-id="@product.Id"
                                                           class="dropdown-item">

                                                            <i class="bi bi-pencil"></i>

                                                            <span>
                                                                تعديل المنتج
                                                            </span>

                                                        </a>

                                                    </li>

                                                    <li>
                                                        <hr class="dropdown-divider" />
                                                    </li>

                                                    @if (product.IsActive)
                                                    {
                                                        <li>

                                                            <form asp-area="Admin"
                                                                  asp-controller="Products"
                                                                  asp-action="Deactivate"
                                                                  asp-route-id="@product.Id"
                                                                  method="post"
                                                                  onsubmit="return confirm('هل أنت متأكد من رغبتك في تعطيل هذا المنتج؟');">

                                                                <button type="submit"
                                                                        class="dropdown-item text-danger">

                                                                    <i class="bi bi-pause-circle"></i>

                                                                    <span>
                                                                        تعطيل المنتج
                                                                    </span>

                                                                </button>

                                                            </form>

                                                        </li>
                                                    }
                                                    else
                                                    {
                                                        <li>

                                                            <form asp-area="Admin"
                                                                  asp-controller="Products"
                                                                  asp-action="Reactivate"
                                                                  asp-route-id="@product.Id"
                                                                  method="post">

                                                                <button type="submit"
                                                                        class="dropdown-item text-success">

                                                                    <i class="bi bi-play-circle"></i>

                                                                    <span>
                                                                        إعادة تفعيل المنتج
                                                                    </span>

                                                                </button>

                                                            </form>

                                                        </li>
                                                    }

                                                </ul>

                                            </div>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin-products.css"
          asp-append-version="true" />
}