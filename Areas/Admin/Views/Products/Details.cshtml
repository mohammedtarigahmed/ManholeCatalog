@model ManholeCatalog.Models.Product

@{
    ViewData["Title"] = "تفاصيل المنتج";

    var orderedImages = Model.Images
        .OrderBy(i => i.DisplayOrder)
        .ThenBy(i => i.Id)
        .ToList();

    var primaryImage = orderedImages.FirstOrDefault(i => i.IsPrimary)
        ?? orderedImages.FirstOrDefault();
}

<div class="admin-page">

    <!-- Page Header -->
    <div class="admin-page-header">

        <div class="admin-page-header-row">

            <div class="admin-page-header-main">

                <div class="admin-page-header-eyebrow">

                    <i class="bi bi-box-seam"></i>
                    تفاصيل المنتج

                    <span class="admin-badge admin-badge-neutral">
                        #@Model.Id
                    </span>

                    @if (Model.IsActive)
                    {
                        <span class="admin-badge admin-badge-success">
                            <i class="bi bi-check-circle"></i>
                            نشط
                        </span>
                    }
                    else
                    {
                        <span class="admin-badge admin-badge-neutral">
                            <i class="bi bi-pause-circle"></i>
                            غير نشط
                        </span>
                    }

                </div>

                <h1 class="admin-page-header-title">
                    @Model.Name
                </h1>

                <p class="admin-page-header-description">
                    عرض معلومات المنتج ومواصفاته وصوره.
                </p>

            </div>


            <div class="admin-page-header-actions">

                <a asp-area="Admin"
                   asp-controller="Products"
                   asp-action="Index"
                   class="admin-btn admin-btn-secondary">

                    <i class="bi bi-arrow-right"></i>
                    <span>العودة إلى المنتجات</span>

                </a>

                <a asp-area="Admin"
                   asp-controller="Products"
                   asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="admin-btn admin-btn-primary">

                    <i class="bi bi-pencil"></i>
                    <span>تعديل المنتج</span>

                </a>

                @if (Model.IsActive)
                {
                    <form asp-area="Admin"
                          asp-controller="Products"
                          asp-action="Deactivate"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="admin-inline-form"
                          onsubmit="return confirm('هل أنت متأكد من رغبتك في تعطيل هذا المنتج؟');">

                        <button type="submit"
                                class="admin-btn admin-btn-outline-danger">

                            <i class="bi bi-pause-circle"></i>
                            <span>تعطيل</span>

                        </button>

                    </form>
                }
                else
                {
                    <form asp-area="Admin"
                          asp-controller="Products"
                          asp-action="Reactivate"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="admin-inline-form"
                          onsubmit="return confirm('هل أنت متأكد من رغبتك في إعادة تفعيل هذا المنتج؟');">

                        <button type="submit"
                                class="admin-btn admin-btn-primary">

                            <i class="bi bi-play-circle"></i>
                            <span>إعادة التفعيل</span>

                        </button>

                    </form>
                }

            </div>

        </div>

    </div>


    <div class="row g-4">

        <!-- Product Overview -->
        <div class="col-12">

            <div class="admin-card">

                <div class="admin-card-body">

                    <div class="row g-4 align-items-center">

                        <div class="col-lg-8">

                            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">

                                @if (Model.IsActive)
                                {
                                    <span class="admin-badge admin-badge-success">
                                        <i class="bi bi-check-circle"></i>
                                        نشط
                                    </span>
                                }
                                else
                                {
                                    <span class="admin-badge admin-badge-neutral">
                                        <i class="bi bi-pause-circle"></i>
                                        غير نشط
                                    </span>
                                }

                                @if (Model.Category != null)
                                {
                                    <span class="admin-badge admin-badge-neutral">
                                        <i class="bi bi-folder2"></i>
                                        @Model.Category.Name
                                    </span>
                                }

                                @if (!string.IsNullOrWhiteSpace(Model.SKU))
                                {
                                    <span class="admin-badge admin-badge-neutral">
                                        <i class="bi bi-upc"></i>
                                        @Model.SKU
                                    </span>
                                }

                            </div>

                            <h2 class="admin-card-title admin-details-product-title">
                                @Model.Name
                            </h2>

                            <div class="admin-form-help">
                                معرّف المنتج: #@Model.Id
                            </div>

                        </div>


                        <div class="col-lg-4">

                            <div class="admin-details-summary">

                                <div class="admin-details-icon admin-details-icon-primary">

                                    <i class="bi bi-folder2-open"></i>

                                </div>

                                <div class="admin-form-help mb-1">
                                    الفئة
                                </div>

                                <div class="fw-semibold">
                                    @(Model.Category?.Name ?? "لا توجد فئة")
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Product Image -->
        <div class="col-lg-5">

            <div class="admin-card h-100">

                <div class="admin-card-header">

                    <div class="admin-card-header-row">

                        <div class="admin-card-header-content">

                            <div class="admin-card-icon">

                                <i class="bi bi-image"></i>

                            </div>

                            <div>

                                <h2 class="admin-card-title">
                                    الصورة الرئيسية
                                </h2>

                                <p class="admin-card-description">
                                    الصورة المعروضة للمنتج.
                                </p>

                            </div>

                        </div>

                        @if (primaryImage != null && primaryImage.IsPrimary)
                        {
                            <span class="admin-badge admin-badge-primary">

                                <i class="bi bi-star-fill"></i>
                                رئيسية

                            </span>
                        }

                    </div>

                </div>


                <div class="admin-card-body">

                    @if (primaryImage != null)
                    {
                        <div class="admin-details-main-image mb-3">

                            <img src="@primaryImage.ImagePath"
                                 alt="@primaryImage.AltText"
                                 class="admin-details-main-image-img" />

                        </div>
                    }
                    else
                    {
                        <div class="admin-details-no-image mb-3">

                            <div class="admin-details-no-image-icon">

                                <i class="bi bi-image"></i>

                            </div>

                            <div class="fw-semibold">
                                لا توجد صورة
                            </div>

                            <div class="admin-form-help mt-1">
                                أضف صورة لعرض المنتج بشكل أفضل.
                            </div>

                        </div>
                    }


                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">

                        <span class="admin-form-help">

                            <i class="bi bi-images"></i>
                            تم رفع @orderedImages.Count صورة

                        </span>

                        <a asp-area="Admin"
                           asp-controller="Products"
                           asp-action="Images"
                           asp-route-id="@Model.Id"
                           class="admin-btn admin-btn-secondary admin-btn-sm">

                            <i class="bi bi-images"></i>
                            <span>إدارة الصور</span>

                        </a>

                    </div>

                </div>

            </div>

        </div>


        <!-- Product Information -->
        <div class="col-lg-7">

            <div class="admin-card h-100">

                <div class="admin-card-header">

                    <div class="admin-card-header-content">

                        <div class="admin-card-icon">

                            <i class="bi bi-box-seam"></i>

                        </div>

                        <div>

                            <h2 class="admin-card-title">
                                معلومات المنتج
                            </h2>

                            <p class="admin-card-description">
                                وصف المنتج والمواصفات الفنية.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="admin-card-body">

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <div class="admin-details-description mb-4">

                            <div class="admin-form-help mb-2">
                                الوصف
                            </div>

                            <div class="admin-details-description-content">
                                @Model.Description
                            </div>

                        </div>
                    }


                    <div class="row g-4">

                        <div class="col-sm-6">

                            <div class="admin-form-help mb-1">
                                الفئة
                            </div>

                            <div class="fw-semibold">
                                @(Model.Category?.Name ?? "لا توجد فئة")
                            </div>

                        </div>


                        @if (!string.IsNullOrWhiteSpace(Model.SKU))
                        {
                            <div class="col-sm-6">

                                <div class="admin-form-help mb-1">
                                    الرقم التعريفي
                                </div>

                                <div class="fw-semibold">
                                    @Model.SKU
                                </div>

                            </div>
                        }


                        @if (!string.IsNullOrWhiteSpace(Model.Material))
                        {
                            <div class="col-sm-6">

                                <div class="admin-form-help mb-1">
                                    المادة
                                </div>

                                <div class="fw-semibold">
                                    @Model.Material
                                </div>

                            </div>
                        }


                        @if (!string.IsNullOrWhiteSpace(Model.LoadClass))
                        {
                            <div class="col-sm-6">

                                <div class="admin-form-help mb-1">
                                    فئة التحميل
                                </div>

                                <div class="fw-semibold">
                                    @Model.LoadClass
                                </div>

                            </div>
                        }


                        @if (!string.IsNullOrWhiteSpace(Model.Diameter))
                        {
                            <div class="col-sm-6">

                                <div class="admin-form-help mb-1">
                                    القطر
                                </div>

                                <div class="fw-semibold">
                                    @Model.Diameter
                                </div>

                            </div>
                        }


                        @if (!string.IsNullOrWhiteSpace(Model.Shape))
                        {
                            <div class="col-sm-6">

                                <div class="admin-form-help mb-1">
                                    الشكل
                                </div>

                                <div class="fw-semibold">
                                    @Model.Shape
                                </div>

                            </div>
                        }


                        <div class="col-sm-6">

                            <div class="admin-form-help mb-1">
                                السعر
                            </div>

                            @if (Model.Price.HasValue)
                            {
                                <div class="fw-bold fs-5 text-primary">
                                    @Model.Price.Value.ToString("N2") ر.س
                                </div>
                            }
                            else
                            {
                                <div class="text-muted">
                                    السعر عند الطلب
                                </div>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Product Images -->
        <div class="col-12">

            <div class="admin-card">

                <div class="admin-card-header">

                    <div class="admin-card-header-row">

                        <div class="admin-card-header-content">

                            <div class="admin-card-icon">

                                <i class="bi bi-images"></i>

                            </div>

                            <div>

                                <h2 class="admin-card-title">
                                    صور المنتج
                                </h2>

                                <p class="admin-card-description">
                                    تم رفع @orderedImages.Count صورة لهذا المنتج.
                                </p>

                            </div>

                        </div>


                        <a asp-area="Admin"
                           asp-controller="Products"
                           asp-action="Images"
                           asp-route-id="@Model.Id"
                           class="admin-btn admin-btn-secondary admin-btn-sm">

                            <i class="bi bi-images"></i>
                            <span>إدارة الصور</span>

                        </a>

                    </div>

                </div>


                <div class="admin-card-body">

                    @if (orderedImages.Any())
                    {
                        <div class="row g-3">

                            @for (var index = 0; index < orderedImages.Count; index++)
                            {
                                var image = orderedImages[index];

                                <div class="col-6 col-md-4 col-lg-3">

                                    <div class="admin-details-gallery-card h-100">

                                        <div class="admin-details-gallery-image">

                                            <img src="@image.ImagePath"
                                                 alt="@image.AltText"
                                                 class="admin-details-gallery-image-img" />

                                            @if (image.IsPrimary)
                                            {
                                                <span class="admin-badge admin-badge-primary admin-details-gallery-badge">

                                                    <i class="bi bi-star-fill"></i>
                                                    رئيسية

                                                </span>
                                            }

                                        </div>


                                        <div class="p-3">

                                            <div class="admin-form-help">
                                                ترتيب العرض: @(index + 1)
                                            </div>

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="admin-empty-state">

                            <div class="admin-empty-icon">
                                <i class="bi bi-images"></i>
                            </div>

                            <h3 class="admin-empty-title">
                                لا توجد صور
                            </h3>

                            <p class="admin-empty-description">
                                لا توجد صور مضافة لهذا المنتج حتى الآن.
                            </p>

                            <a asp-area="Admin"
                               asp-controller="Products"
                               asp-action="Images"
                               asp-route-id="@Model.Id"
                               class="admin-btn admin-btn-primary">

                                <i class="bi bi-upload"></i>
                                <span>رفع صورة</span>

                            </a>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- Product Metadata -->
        <div class="col-12">

            <div class="admin-card">

                <div class="admin-card-header">

                    <div class="admin-card-header-content">

                        <div class="admin-card-icon">

                            <i class="bi bi-clock-history"></i>

                        </div>

                        <div>

                            <h2 class="admin-card-title">
                                بيانات المنتج
                            </h2>

                            <p class="admin-card-description">
                                معلومات الإنشاء والتحديث.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="admin-card-body">

                    <div class="row g-4">

                        <div class="col-md-4">

                            <div class="admin-form-help mb-1">
                                معرّف المنتج
                            </div>

                            <div class="fw-semibold">
                                #@Model.Id
                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="admin-form-help mb-1">
                                تاريخ الإنشاء
                            </div>

                            <div class="fw-semibold">
                                @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy - hh:mm tt")
                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="admin-form-help mb-1">
                                آخر تحديث
                            </div>

                            @if (Model.UpdatedAt.HasValue)
                            {
                                <span class="fw-semibold">
                                    @Model.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy - hh:mm tt")
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    لم يتم التحديث
                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/product-details.css"
          asp-append-version="true" />
}