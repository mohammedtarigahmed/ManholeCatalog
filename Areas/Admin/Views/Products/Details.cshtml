@model ManholeCatalog.Models.Product

@{
    ViewData["Title"] = "تفاصيل المنتج";

    var orderedImages = Model.Images
        .OrderBy(i => i.DisplayOrder)
        .ThenBy(i => i.Id)
        .ToList();

    var primaryImage = orderedImages.FirstOrDefault(i => i.IsPrimary)
        ?? orderedImages.FirstOrDefault();
}

<!-- Page Header -->
<div class="product-details-header mb-4">

    <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3">

        <div>

            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">

                <span class="badge rounded-pill text-bg-primary px-3 py-2">
                    تفاصيل المنتج
                </span>

                <span class="badge rounded-pill text-bg-light border px-3 py-2">
                    #@Model.Id
                </span>

                @if (Model.IsActive)
                {
                    <span class="badge rounded-pill text-bg-success px-3 py-2">
                        <i class="bi bi-check-circle me-1"></i>
                        نشط
                    </span>
                }
                else
                {
                    <span class="badge rounded-pill text-bg-secondary px-3 py-2">
                        <i class="bi bi-pause-circle me-1"></i>
                        غير نشط
                    </span>
                }

            </div>

            <h1 class="h3 fw-bold mb-1">
                @Model.Name
            </h1>

            <p class="text-muted mb-0">
                عرض معلومات المنتج ومواصفاته وصوره.
            </p>

        </div>


        <!-- Header Actions -->
        <div class="d-flex flex-wrap gap-2">

            <a asp-area="Admin"
               asp-controller="Products"
               asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-right me-1"></i>

                العودة إلى المنتجات

            </a>

            <a asp-area="Admin"
               asp-controller="Products"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">

                <i class="bi bi-pencil me-1"></i>

                تعديل المنتج

            </a>

            @if (Model.IsActive)
            {
                <form asp-area="Admin"
                      asp-controller="Products"
                      asp-action="Deactivate"
                      asp-route-id="@Model.Id"
                      method="post"
                      onsubmit="return confirm('هل أنت متأكد من رغبتك في تعطيل هذا المنتج؟');">

                    <button type="submit"
                            class="btn btn-outline-danger">

                        <i class="bi bi-pause-circle me-1"></i>

                        تعطيل

                    </button>

                </form>
            }
            else
            {
                <form asp-area="Admin"
                      asp-controller="Products"
                      asp-action="Reactivate"
                      asp-route-id="@Model.Id"
                      method="post"
                      onsubmit="return confirm('هل أنت متأكد من رغبتك في إعادة تفعيل هذا المنتج؟');">

                    <button type="submit"
                            class="btn btn-outline-success">

                        <i class="bi bi-play-circle me-1"></i>

                        إعادة التفعيل

                    </button>

                </form>
            }

        </div>

    </div>

</div>


<div class="row g-4">


    <!-- Product Overview -->
    <div class="col-12">

        <div class="card border-0 shadow-sm product-details-card">

            <div class="card-body p-4">

                <div class="row g-4 align-items-center">

                    <div class="col-lg-8">

                        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">

                            @if (Model.IsActive)
                            {
                                <span class="badge rounded-pill text-bg-success px-3 py-2">
                                    نشط
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill text-bg-secondary px-3 py-2">
                                    غير نشط
                                </span>
                            }

                            @if (Model.Category != null)
                            {
                                <span class="badge rounded-pill text-bg-light border px-3 py-2">
                                    <i class="bi bi-folder2 me-1"></i>
                                    @Model.Category.Name
                                </span>
                            }

                            @if (!string.IsNullOrWhiteSpace(Model.SKU))
                            {
                                <span class="badge rounded-pill text-bg-light border px-3 py-2">
                                    <i class="bi bi-upc me-1"></i>
                                    @Model.SKU
                                </span>
                            }

                        </div>

                        <h2 class="h4 fw-bold mb-2">
                            @Model.Name
                        </h2>

                        <div class="text-muted small">
                            معرّف المنتج: #@Model.Id
                        </div>

                    </div>


                    <div class="col-lg-4">

                        <div class="product-category-summary">

                            <div class="product-detail-icon bg-primary-subtle text-primary mb-2">

                                <i class="bi bi-folder2-open"></i>

                            </div>

                            <div class="text-muted small mb-1">
                                الفئة
                            </div>

                            <div class="fw-semibold">
                                @(Model.Category?.Name ?? "لا توجد فئة")
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Product Image -->
    <div class="col-lg-5">

        <div class="card border-0 shadow-sm product-details-card h-100">

            <div class="card-header bg-white border-0 p-4">

                <div class="d-flex justify-content-between align-items-center gap-2">

                    <div>

                        <h2 class="h6 fw-bold mb-1">
                            الصورة الرئيسية
                        </h2>

                        <p class="text-muted small mb-0">
                            الصورة المعروضة للمنتج.
                        </p>

                    </div>

                    @if (primaryImage != null && primaryImage.IsPrimary)
                    {
                        <span class="badge rounded-pill text-bg-primary px-3 py-2">
                            <i class="bi bi-star-fill me-1"></i>
                            رئيسية
                        </span>
                    }

                </div>

            </div>


            <div class="card-body p-4">

                @if (primaryImage != null)
                {
                    <div class="product-main-image mb-3">

                        <img src="@primaryImage.ImagePath"
                             alt="@primaryImage.AltText"
                             class="product-main-image-img" />

                    </div>
                }
                else
                {
                    <div class="product-no-image mb-3">

                        <div class="product-no-image-icon">

                            <i class="bi bi-image"></i>

                        </div>

                        <div class="fw-semibold">
                            لا توجد صورة
                        </div>

                        <div class="small text-muted mt-1">
                            أضف صورة لعرض المنتج بشكل أفضل.
                        </div>

                    </div>
                }


                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">

                    <span class="text-muted small">

                        <i class="bi bi-images me-1"></i>

                        تم رفع @orderedImages.Count صورة

                    </span>

                    <a asp-area="Admin"
                       asp-controller="Products"
                       asp-action="Images"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-primary btn-sm">

                        <i class="bi bi-images me-1"></i>

                        إدارة الصور

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- Product Information -->
    <div class="col-lg-7">

        <div class="card border-0 shadow-sm product-details-card h-100">

            <div class="card-header bg-white border-0 p-4">

                <div class="d-flex align-items-start gap-3">

                    <div class="product-detail-icon bg-info-subtle text-info">

                        <i class="bi bi-box-seam"></i>

                    </div>

                    <div>

                        <h2 class="h6 fw-bold mb-1">
                            معلومات المنتج
                        </h2>

                        <p class="text-muted small mb-0">
                            وصف المنتج والمواصفات الفنية.
                        </p>

                    </div>

                </div>

            </div>


            <div class="card-body p-4">

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="product-description mb-4">

                        <div class="text-muted small mb-2">
                            الوصف
                        </div>

                        <div class="description-content">
                            @Model.Description
                        </div>

                    </div>
                }


                <div class="row g-4">

                    <div class="col-sm-6">

                        <div class="text-muted small mb-1">
                            الفئة
                        </div>

                        <div class="fw-semibold">
                            @(Model.Category?.Name ?? "لا توجد فئة")
                        </div>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(Model.SKU))
                    {
                        <div class="col-sm-6">

                            <div class="text-muted small mb-1">
                                الرقم التعريفي
                            </div>

                            <div class="fw-semibold">
                                @Model.SKU
                            </div>

                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(Model.Material))
                    {
                        <div class="col-sm-6">

                            <div class="text-muted small mb-1">
                                المادة
                            </div>

                            <div class="fw-semibold">
                                @Model.Material
                            </div>

                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(Model.LoadClass))
                    {
                        <div class="col-sm-6">

                            <div class="text-muted small mb-1">
                                فئة التحميل
                            </div>

                            <div class="fw-semibold">
                                @Model.LoadClass
                            </div>

                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(Model.Diameter))
                    {
                        <div class="col-sm-6">

                            <div class="text-muted small mb-1">
                                القطر
                            </div>

                            <div class="fw-semibold">
                                @Model.Diameter
                            </div>

                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(Model.Shape))
                    {
                        <div class="col-sm-6">

                            <div class="text-muted small mb-1">
                                الشكل
                            </div>

                            <div class="fw-semibold">
                                @Model.Shape
                            </div>

                        </div>
                    }


                    <div class="col-sm-6">

                        <div class="text-muted small mb-1">
                            السعر
                        </div>

                        @if (Model.Price.HasValue)
                        {
                            <div class="fw-bold fs-5 text-primary">
                                @Model.Price.Value.ToString("N2") ر.س
                            </div>
                        }
                        else
                        {
                            <div class="text-muted">
                                السعر عند الطلب
                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Product Images -->
    <div class="col-12">

        <div class="card border-0 shadow-sm product-details-card">

            <div class="card-header bg-white border-0 p-4">

                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">

                    <div>

                        <div class="d-flex align-items-center gap-2 mb-1">

                            <div class="product-detail-icon product-detail-icon-sm bg-primary-subtle text-primary">

                                <i class="bi bi-images"></i>

                            </div>

                            <h2 class="h6 fw-bold mb-0">
                                صور المنتج
                            </h2>

                        </div>

                        <div class="small text-muted">
                            تم رفع @orderedImages.Count صورة لهذا المنتج.
                        </div>

                    </div>


                    <a asp-area="Admin"
                       asp-controller="Products"
                       asp-action="Images"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-primary btn-sm">

                        <i class="bi bi-images me-1"></i>

                        إدارة الصور

                    </a>

                </div>

            </div>


            <div class="card-body p-4">

                @if (orderedImages.Any())
                {
                    <div class="row g-3">

                        @for (var index = 0; index < orderedImages.Count; index++)
                        {
                            var image = orderedImages[index];

                            <div class="col-6 col-md-4 col-lg-3">

                                <div class="product-gallery-card h-100">

                                    <div class="product-gallery-image">

                                        <img src="@image.ImagePath"
                                             alt="@image.AltText"
                                             class="product-gallery-image-img" />

                                        @if (image.IsPrimary)
                                        {
                                            <span class="badge rounded-pill text-bg-primary position-absolute top-0 start-0 m-2">

                                                <i class="bi bi-star-fill me-1"></i>

                                                رئيسية

                                            </span>
                                        }

                                    </div>


                                    <div class="p-3">

                                        <div class="small text-muted">
                                            ترتيب العرض: @(index + 1)
                                        </div>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="product-empty-state">

                        <div class="product-empty-icon">

                            <i class="bi bi-images"></i>

                        </div>

                        <h3 class="h6 fw-bold mb-2">
                            لا توجد صور
                        </h3>

                        <p class="text-muted mb-3">
                            لا توجد صور مضافة لهذا المنتج حتى الآن.
                        </p>

                        <a asp-area="Admin"
                           asp-controller="Products"
                           asp-action="Images"
                           asp-route-id="@Model.Id"
                           class="btn btn-primary">

                            <i class="bi bi-upload me-1"></i>

                            رفع صورة

                        </a>

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- Product Metadata -->
    <div class="col-12">

        <div class="card border-0 shadow-sm product-details-card">

            <div class="card-header bg-white border-0 p-4">

                <div class="d-flex align-items-center gap-3">

                    <div class="product-detail-icon bg-secondary-subtle text-secondary">

                        <i class="bi bi-clock-history"></i>

                    </div>

                    <div>

                        <h2 class="h6 fw-bold mb-1">
                            بيانات المنتج
                        </h2>

                        <p class="text-muted small mb-0">
                            معلومات الإنشاء والتحديث.
                        </p>

                    </div>

                </div>

            </div>


            <div class="card-body p-4">

                <div class="row g-4">

                    <div class="col-md-4">

                        <div class="text-muted small mb-1">
                            معرّف المنتج
                        </div>

                        <div class="fw-semibold">
                            #@Model.Id
                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="text-muted small mb-1">
                            تاريخ الإنشاء
                        </div>

                        <div class="fw-semibold">
                            @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy - hh:mm tt")
                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="text-muted small mb-1">
                            آخر تحديث
                        </div>

                        <div>

                            @if (Model.UpdatedAt.HasValue)
                            {
                                <span class="fw-semibold">
                                    @Model.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy - hh:mm tt")
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    لم يتم التحديث
                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    .product-details-card {
        border-radius: 16px;
        overflow: hidden;
    }

    .product-details-header .btn {
        border-radius: 10px;
    }

    .product-details-header form {
        margin: 0;
    }

    .product-detail-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 1.05rem;
    }

    .product-detail-icon-sm {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        font-size: 0.95rem;
    }

    .product-category-summary {
        padding: 18px;
        border-radius: 14px;
        background: #f8fafc;
        border: 1px solid #eef0f2;
    }

    .product-main-image {
        width: 100%;
        height: 350px;
        border-radius: 14px;
        background: #f8fafc;
        border: 1px solid #eef0f2;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .product-main-image-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .product-no-image {
        width: 100%;
        height: 350px;
        border-radius: 14px;
        background: #f8fafc;
        border: 1px dashed #d9dee5;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: #6b7280;
    }

    .product-no-image-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #eef0f2;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
        font-size: 1.4rem;
        color: #9ca3af;
    }

    .product-description {
        padding: 16px;
        border-radius: 12px;
        background: #f8fafc;
        border: 1px solid #eef0f2;
    }

    .description-content {
        white-space: pre-line;
        line-height: 1.8;
    }

    .product-gallery-card {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
        background: #fff;
        transition: transform 0.18s ease, box-shadow 0.18s ease;
    }

    .product-gallery-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(17, 24, 39, 0.08);
    }

    .product-gallery-image {
        position: relative;
        height: 180px;
        background: #f8fafc;
        border-bottom: 1px solid #eef0f2;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .product-gallery-image-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .product-empty-state {
        text-align: center;
        padding: 48px 20px;
    }

    .product-empty-icon {
        width: 68px;
        height: 68px;
        border-radius: 50%;
        background: #f3f4f6;
        color: #9ca3af;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
        font-size: 1.5rem;
    }

    .product-details-card .btn {
        border-radius: 9px;
    }

    @@media (max-width: 767.98px) {

        .product-details-header .btn,
        .product-details-header form,
        .product-details-header form .btn {
            width: 100%;
        }

        .product-main-image,
        .product-no-image {
            height: 280px;
        }

        .product-gallery-image {
            height: 150px;
        }

    }

</style>