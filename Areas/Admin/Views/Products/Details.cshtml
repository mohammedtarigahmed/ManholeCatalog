@model ManholeCatalog.Models.Product

@{
    ViewData["Title"] = "تفاصيل المنتج";

    var orderedImages = Model.Images
        .OrderBy(i => i.DisplayOrder)
        .ThenBy(i => i.Id)
        .ToList();

    var primaryImage = orderedImages.FirstOrDefault(i => i.IsPrimary);
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

    <div>

        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">

            <span class="badge text-bg-light border">
                المنتج #@Model.Id
            </span>

            @if (Model.IsActive)
            {
                <span class="badge text-bg-success">
                    نشط
                </span>
            }
            else
            {
                <span class="badge text-bg-secondary">
                    غير نشط
                </span>
            }

        </div>

        <h1 class="h3 fw-bold mb-1">
            @Model.Name
        </h1>

        <p class="text-muted mb-0">
            عرض معلومات المنتج ومواصفاته وصوره.
        </p>

    </div>

    <div class="d-flex flex-wrap gap-2">

        <a asp-area="Admin"
           asp-controller="Products"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← العودة إلى المنتجات
        </a>

        <a asp-area="Admin"
           asp-controller="Products"
           asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            تعديل المنتج
        </a>

        @if (Model.IsActive)
        {
            <form asp-area="Admin"
                  asp-controller="Products"
                  asp-action="Deactivate"
                  asp-route-id="@Model.Id"
                  method="post"
                  onsubmit="return confirm('هل أنت متأكد من رغبتك في تعطيل هذا المنتج؟');">

                <button type="submit"
                        class="btn btn-outline-danger">
                    تعطيل
                </button>

            </form>
        }
        else
        {
            <form asp-area="Admin"
                  asp-controller="Products"
                  asp-action="Reactivate"
                  asp-route-id="@Model.Id"
                  method="post"
                  onsubmit="return confirm('هل أنت متأكد من رغبتك في إعادة تفعيل هذا المنتج؟');">

                <button type="submit"
                        class="btn btn-outline-success">
                    إعادة التفعيل
                </button>

            </form>
        }

    </div>

</div>

<div class="row g-4">

    <!-- Product Overview -->
    <div class="col-12">

        <div class="card border-0 shadow-sm">

            <div class="card-body">

                <div class="row g-4 align-items-center">

                    <div class="col-md-8">

                        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">

                            @if (Model.IsActive)
                            {
                                <span class="badge text-bg-success">
                                    نشط
                                </span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">
                                    غير نشط
                                </span>
                            }

                            @if (Model.Category != null)
                            {
                                <span class="badge text-bg-light border">
                                    @Model.Category.Name
                                </span>
                            }

                            @if (!string.IsNullOrWhiteSpace(Model.SKU))
                            {
                                <span class="badge text-bg-light border">
                                    الرقم التعريفي: @Model.SKU
                                </span>
                            }

                        </div>

                        <h2 class="h4 fw-bold mb-2">
                            @Model.Name
                        </h2>

                        <div class="text-muted small">
                            معرّف المنتج: #@Model.Id
                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="text-md-end">

                            <div class="text-muted small mb-1">
                                الفئة
                            </div>

                            <div class="fw-semibold">
                                @(Model.Category?.Name ?? "لا توجد فئة")
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Product Image -->
    <div class="col-lg-5">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-header bg-white py-3">

                <div class="d-flex justify-content-between align-items-center gap-2">

                    <h2 class="h6 fw-bold mb-0">
                        الصورة الرئيسية
                    </h2>

                    @if (primaryImage != null)
                    {
                        <span class="badge text-bg-primary">
                            رئيسية
                        </span>
                    }

                </div>

            </div>

            <div class="card-body">

                @if (primaryImage != null)
                {
                    <div class="rounded overflow-hidden mb-3"
                         style="background-color: #f8f9fa;">

                        <img src="@primaryImage.ImagePath"
                             alt="@primaryImage.AltText"
                             class="img-fluid w-100"
                             style="height: 350px; object-fit: contain;" />

                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center text-muted rounded mb-3"
                         style="height: 350px; background-color: #f8f9fa;">

                        <div class="text-center">

                            <div class="display-6 mb-2">
                                —
                            </div>

                            <div class="fw-semibold">
                                لا توجد صورة
                            </div>

                            <div class="small mt-1">
                                أضف صورة لعرض المنتج بشكل أفضل.
                            </div>

                        </div>

                    </div>
                }

                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">

                    <span class="text-muted small">
                        تم رفع @orderedImages.Count صورة
                    </span>

                    <a asp-area="Admin"
                       asp-controller="Products"
                       asp-action="Images"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-primary btn-sm">
                        إدارة الصور
                    </a>

                </div>

            </div>

        </div>

    </div>

    <!-- Product Information -->
    <div class="col-lg-7">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-header bg-white py-3">

                <h2 class="h6 fw-bold mb-1">
                    معلومات المنتج
                </h2>

                <p class="text-muted small mb-0">
                    وصف المنتج والمواصفات الفنية.
                </p>

            </div>

            <div class="card-body">

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="mb-4">

                        <div class="text-muted small mb-1">
                            الوصف
                        </div>

                        <div style="white-space: pre-line;">
                            @Model.Description
                        </div>

                    </div>
                }

                <div class="row g-4">

                    <div class="col-sm-6">

                        <div class="text-muted small mb-1">
                            الفئة
                        </div>

                        <div class="fw-semibold">
                            @(Model.Category?.Name ?? "لا توجد فئة")
                        </div>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.SKU))
                    {
                        <div class="col-sm-6">

                            <div class="text-muted small mb-1">
                                الرقم التعريفي
                            </div>

                            <div class="fw-semibold">
                                @Model.SKU
                            </div>

                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Material))
                    {
                        <div class="col-sm-6">

                            <div class="text-muted small mb-1">
                                المادة
                            </div>

                            <div class="fw-semibold">
                                @Model.Material
                            </div>

                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.LoadClass))
                    {
                        <div class="col-sm-6">

                            <div class="text-muted small mb-1">
                                فئة التحميل
                            </div>

                            <div class="fw-semibold">
                                @Model.LoadClass
                            </div>

                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Diameter))
                    {
                        <div class="col-sm-6">

                            <div class="text-muted small mb-1">
                                القطر
                            </div>

                            <div class="fw-semibold">
                                @Model.Diameter
                            </div>

                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Shape))
                    {
                        <div class="col-sm-6">

                            <div class="text-muted small mb-1">
                                الشكل
                            </div>

                            <div class="fw-semibold">
                                @Model.Shape
                            </div>

                        </div>
                    }

                    <div class="col-sm-6">

                        <div class="text-muted small mb-1">
                            السعر
                        </div>

                        @if (Model.Price.HasValue)
                        {
                            <div class="fw-bold fs-5">
                                @Model.Price.Value.ToString("N2") ر.س
                            </div>
                        }
                        else
                        {
                            <div class="text-muted">
                                السعر عند الطلب
                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Product Images -->
    <div class="col-12">

        <div class="card border-0 shadow-sm">

            <div class="card-header bg-white py-3">

                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">

                    <div>

                        <h2 class="h6 fw-bold mb-1">
                            صور المنتج
                        </h2>

                        <div class="small text-muted">
                            تم رفع @orderedImages.Count صورة لهذا المنتج.
                        </div>

                    </div>

                    <a asp-area="Admin"
                       asp-controller="Products"
                       asp-action="Images"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-primary btn-sm">
                        إدارة الصور
                    </a>

                </div>

            </div>

            <div class="card-body">

                @if (orderedImages.Any())
                {
                    <div class="row g-3">

                        @for (var index = 0; index < orderedImages.Count; index++)
                        {
                            var image = orderedImages[index];

                            <div class="col-6 col-md-4 col-lg-3">

                                <div class="card border h-100">

                                    <div class="position-relative">

                                        <img src="@image.ImagePath"
                                             alt="@image.AltText"
                                             class="card-img-top"
                                             style="height: 180px; object-fit: contain; background-color: #f8f9fa;" />

                                        @if (image.IsPrimary)
                                        {
                                            <span class="badge text-bg-primary position-absolute top-0 start-0 m-2">
                                                رئيسية
                                            </span>
                                        }

                                    </div>

                                    <div class="card-body p-3">

                                        <div class="small text-muted">
                                            ترتيب العرض: @(index + 1)
                                        </div>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="text-center py-5">

                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light border mb-3"
                             style="width: 64px; height: 64px;">

                            <span class="text-muted fw-bold fs-5">
                                IMG
                            </span>

                        </div>

                        <h3 class="h6 fw-bold mb-2">
                            لا توجد صور
                        </h3>

                        <p class="text-muted mb-3">
                            لا توجد صور مضافة لهذا المنتج حتى الآن.
                        </p>

                        <a asp-area="Admin"
                           asp-controller="Products"
                           asp-action="Images"
                           asp-route-id="@Model.Id"
                           class="btn btn-primary">
                            رفع صورة
                        </a>

                    </div>
                }

            </div>

        </div>

    </div>

    <!-- Product Metadata -->
    <div class="col-12">

        <div class="card border-0 shadow-sm">

            <div class="card-header bg-white py-3">

                <h2 class="h6 fw-bold mb-0">
                    بيانات المنتج
                </h2>

            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-md-4">

                        <div class="text-muted small mb-1">
                            معرّف المنتج
                        </div>

                        <div class="fw-semibold">
                            #@Model.Id
                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="text-muted small mb-1">
                            تاريخ الإنشاء
                        </div>

                        <div>
                            @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="text-muted small mb-1">
                            آخر تحديث
                        </div>

                        <div>

                            @if (Model.UpdatedAt.HasValue)
                            {
                                @Model.UpdatedAt.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                            }
                            else
                            {
                                <span class="text-muted">
                                    لم يتم التحديث
                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>