@model ManholeCatalog.Models.Product

@{
    ViewData["Title"] = "إضافة منتج";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

    <div>

        <h1 class="h3 fw-bold mb-1">
            إضافة منتج
        </h1>

        <p class="text-muted mb-0">
            إضافة منتج جديد إلى الكتالوج.
        </p>

    </div>

    <a asp-area="Admin"
       asp-controller="Products"
       asp-action="Index"
       class="btn btn-outline-secondary">
        ← العودة إلى المنتجات
    </a>

</div>

<form asp-area="Admin"
      asp-controller="Products"
      asp-action="Create"
      method="post">

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All"
             class="alert alert-danger"
             role="alert">
        </div>
    }

    <div class="row g-4">

        <!-- Basic Information -->
        <div class="col-12">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">

                    <h2 class="h6 fw-bold mb-1">
                        المعلومات الأساسية
                    </h2>

                    <p class="text-muted small mb-0">
                        أدخل المعلومات الرئيسية المستخدمة للتعرف على المنتج.
                    </p>

                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-8">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                                اسم المنتج
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="مثال: غطاء منهول من الحديد الزهر المرن" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-4">

                            <label asp-for="SKU"
                                   class="form-label fw-semibold">
                                الرقم التعريفي
                            </label>

                            <input asp-for="SKU"
                                   class="form-control"
                                   placeholder="مثال: MH-001" />

                            <span asp-validation-for="SKU"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="CategoryId"
                                   class="form-label fw-semibold">
                                الفئة
                            </label>

                            <select asp-for="CategoryId"
                                    asp-items="ViewBag.CategoryId"
                                    class="form-select">

                                <option value="">
                                    -- اختر الفئة --
                                </option>

                            </select>

                            <span asp-validation-for="CategoryId"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                اختر الفئة التي تناسب هذا المنتج.
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- Product Specifications -->
        <div class="col-12">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">

                    <h2 class="h6 fw-bold mb-1">
                        مواصفات المنتج
                    </h2>

                    <p class="text-muted small mb-0">
                        أضف المواصفات الفنية المتوفرة لهذا المنتج.
                    </p>

                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label asp-for="Material"
                                   class="form-label fw-semibold">
                                المادة
                            </label>

                            <input asp-for="Material"
                                   class="form-control"
                                   placeholder="مثال: حديد زهر مرن" />

                            <span asp-validation-for="Material"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="LoadClass"
                                   class="form-label fw-semibold">
                                فئة التحميل
                            </label>

                            <input asp-for="LoadClass"
                                   class="form-control"
                                   placeholder="مثال: D400" />

                            <span asp-validation-for="LoadClass"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="Diameter"
                                   class="form-label fw-semibold">
                                القطر
                            </label>

                            <input asp-for="Diameter"
                                   class="form-control"
                                   placeholder="مثال: 600 مم" />

                            <span asp-validation-for="Diameter"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="Shape"
                                   class="form-label fw-semibold">
                                الشكل
                            </label>

                            <input asp-for="Shape"
                                   class="form-control"
                                   placeholder="مثال: دائري" />

                            <span asp-validation-for="Shape"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- Pricing and Description -->
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white py-3">

                    <h2 class="h6 fw-bold mb-1">
                        السعر والوصف
                    </h2>

                    <p class="text-muted small mb-0">
                        أضف معلومات السعر ووصفًا يساعد العملاء على فهم المنتج.
                    </p>

                </div>

                <div class="card-body">

                    <div class="mb-4">

                        <label asp-for="Price"
                               class="form-label fw-semibold">
                            السعر
                        </label>

                        <div class="input-group">

                            <input asp-for="Price"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   placeholder="مثال: 450.00" />

                            <span class="input-group-text">
                                ر.س
                            </span>

                        </div>

                        <span asp-validation-for="Price"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            اتركه فارغًا إذا كان سعر المنتج يُحدد عند الطلب.
                        </div>

                    </div>

                    <div>

                        <label asp-for="Description"
                               class="form-label fw-semibold">
                            الوصف
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="6"
                                  placeholder="اكتب وصفًا للمنتج أو استخداماته أو مميزاته أو أي معلومات مفيدة أخرى."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                        <div class="form-text">
                            اختياري. أضف معلومات مفيدة تساعد العملاء على فهم المنتج.
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- Catalog Visibility -->
        <div class="col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white py-3">

                    <h2 class="h6 fw-bold mb-1">
                        ظهور المنتج في الكتالوج
                    </h2>

                    <p class="text-muted small mb-0">
                        تحكم في ظهور هذا المنتج في الكتالوج العام.
                    </p>

                </div>

                <div class="card-body">

                    <div class="form-check form-switch">

                        <input asp-for="IsActive"
                               class="form-check-input"
                               role="switch" />

                        <label asp-for="IsActive"
                               class="form-check-label fw-semibold">
                            المنتج نشط
                        </label>

                    </div>

                    <div class="form-text mt-2">
                        المنتجات النشطة تظهر في الكتالوج العام ويمكن للعملاء إرسال طلبات عروض أسعار بشأنها.
                    </div>

                    <div class="alert alert-light border mt-4 mb-0">

                        <div class="small">

                            <strong>نصيحة:</strong>
                            يمكنك تعطيل المنتج لاحقًا دون حذفه.

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- Actions -->
        <div class="col-12">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">

                        <a asp-area="Admin"
                           asp-controller="Products"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            إلغاء
                        </a>

                        <button type="submit"
                                class="btn btn-primary">
                            إنشاء المنتج
                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</form>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}