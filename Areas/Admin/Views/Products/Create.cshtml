@model ManholeCatalog.Models.Product

@{
    ViewData["Title"] = "إضافة منتج";
}

<div class="admin-page">

    <!-- Page Header -->
    <div class="admin-page-header">

        <div class="admin-page-header-row">

            <div class="admin-page-header-main">

                <div class="admin-page-header-eyebrow">
                    إدارة المنتجات
                </div>

                <h1 class="admin-page-header-title">
                    إضافة منتج
                </h1>

                <p class="admin-page-header-description">
                    إضافة منتج جديد إلى الكتالوج.
                </p>

            </div>

            <div class="admin-page-header-actions">

                <a asp-area="Admin"
                   asp-controller="Products"
                   asp-action="Index"
                   class="btn admin-btn admin-btn-secondary">

                    <i class="bi bi-arrow-right"></i>

                    <span>
                        العودة إلى المنتجات
                    </span>

                </a>

            </div>

        </div>

    </div>


    <form asp-area="Admin"
          asp-controller="Products"
          asp-action="Create"
          method="post">

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="admin-alert admin-alert-danger mb-4"
                 role="alert">

                <div class="admin-alert-icon">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>

                <div>
                    <div class="fw-semibold mb-1">
                        يرجى مراجعة البيانات.
                    </div>

                    <div class="small">
                        يرجى مراجعة الأخطاء التالية وإعادة المحاولة.
                    </div>
                </div>

            </div>
        }


        <div class="row g-4">


            <!-- Basic Information -->
            <div class="col-12">

                <div class="admin-card">

                    <div class="admin-card-header">

                        <div class="admin-card-header-content">

                            <div class="admin-card-icon">

                                <i class="bi bi-info-circle"></i>

                            </div>

                            <div>

                                <h2 class="admin-card-title">
                                    المعلومات الأساسية
                                </h2>

                                <p class="admin-card-description">
                                    أدخل المعلومات الرئيسية المستخدمة للتعرف على المنتج.
                                </p>

                            </div>

                        </div>

                    </div>


                    <div class="admin-card-body">

                        <div class="row g-4">

                            <div class="col-md-8">

                                <div class="admin-form-group">

                                    <label asp-for="Name"
                                           class="admin-form-label admin-form-label-required">
                                        اسم المنتج
                                    </label>

                                    <input asp-for="Name"
                                           class="form-control admin-form-control"
                                           placeholder="مثال: غطاء منهول من الحديد الزهر المرن" />

                                    <span asp-validation-for="Name"
                                          class="admin-form-validation">
                                    </span>

                                </div>

                            </div>


                            <div class="col-md-4">

                                <div class="admin-form-group">

                                    <label asp-for="SKU"
                                           class="admin-form-label">
                                        الرقم التعريفي
                                    </label>

                                    <input asp-for="SKU"
                                           class="form-control admin-form-control"
                                           placeholder="مثال: MH-001" />

                                    <span asp-validation-for="SKU"
                                          class="admin-form-validation">
                                    </span>

                                </div>

                            </div>


                            <div class="col-md-6">

                                <div class="admin-form-group">

                                    <label asp-for="CategoryId"
                                           class="admin-form-label admin-form-label-required">
                                        الفئة
                                    </label>

                                    <select asp-for="CategoryId"
                                            asp-items="ViewBag.CategoryId"
                                            class="form-select admin-form-select">

                                        <option value="">
                                            -- اختر الفئة --
                                        </option>

                                    </select>

                                    <span asp-validation-for="CategoryId"
                                          class="admin-form-validation">
                                    </span>

                                    <div class="admin-form-help">
                                        اختر الفئة التي تناسب هذا المنتج.
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Product Specifications -->
            <div class="col-12">

                <div class="admin-card">

                    <div class="admin-card-header">

                        <div class="admin-card-header-content">

                            <div class="admin-card-icon">

                                <i class="bi bi-sliders"></i>

                            </div>

                            <div>

                                <h2 class="admin-card-title">
                                    مواصفات المنتج
                                </h2>

                                <p class="admin-card-description">
                                    أضف المواصفات الفنية المتوفرة لهذا المنتج.
                                </p>

                            </div>

                        </div>

                    </div>


                    <div class="admin-card-body">

                        <div class="row g-4">

                            <div class="col-md-6">

                                <div class="admin-form-group">

                                    <label asp-for="Material"
                                           class="admin-form-label">
                                        المادة
                                    </label>

                                    <input asp-for="Material"
                                           class="form-control admin-form-control"
                                           placeholder="مثال: حديد زهر مرن" />

                                    <span asp-validation-for="Material"
                                          class="admin-form-validation">
                                    </span>

                                </div>

                            </div>


                            <div class="col-md-6">

                                <div class="admin-form-group">

                                    <label asp-for="LoadClass"
                                           class="admin-form-label">
                                        فئة التحميل
                                    </label>

                                    <input asp-for="LoadClass"
                                           class="form-control admin-form-control"
                                           placeholder="مثال: D400" />

                                    <span asp-validation-for="LoadClass"
                                          class="admin-form-validation">
                                    </span>

                                </div>

                            </div>


                            <div class="col-md-6">

                                <div class="admin-form-group">

                                    <label asp-for="Diameter"
                                           class="admin-form-label">
                                        القطر
                                    </label>

                                    <input asp-for="Diameter"
                                           class="form-control admin-form-control"
                                           placeholder="مثال: 600 مم" />

                                    <span asp-validation-for="Diameter"
                                          class="admin-form-validation">
                                    </span>

                                </div>

                            </div>


                            <div class="col-md-6">

                                <div class="admin-form-group">

                                    <label asp-for="Shape"
                                           class="admin-form-label">
                                        الشكل
                                    </label>

                                    <input asp-for="Shape"
                                           class="form-control admin-form-control"
                                           placeholder="مثال: دائري" />

                                    <span asp-validation-for="Shape"
                                          class="admin-form-validation">
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Pricing and Description -->
            <div class="col-lg-8">

                <div class="admin-card h-100">

                    <div class="admin-card-header">

                        <div class="admin-card-header-content">

                            <div class="admin-card-icon">

                                <i class="bi bi-tag"></i>

                            </div>

                            <div>

                                <h2 class="admin-card-title">
                                    السعر والوصف
                                </h2>

                                <p class="admin-card-description">
                                    أضف معلومات السعر ووصفًا يساعد العملاء على فهم المنتج.
                                </p>

                            </div>

                        </div>

                    </div>


                    <div class="admin-card-body">

                        <div class="admin-form-group mb-4">

                            <label asp-for="Price"
                                   class="admin-form-label">
                                السعر
                            </label>

                            <div class="input-group admin-input-group">

                                <input asp-for="Price"
                                       class="form-control admin-form-control"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       placeholder="مثال: 450.00" />

                                <span class="input-group-text">
                                    ر.س
                                </span>

                            </div>

                            <span asp-validation-for="Price"
                                  class="admin-form-validation">
                            </span>

                            <div class="admin-form-help">
                                اتركه فارغًا إذا كان سعر المنتج يُحدد عند الطلب.
                            </div>

                        </div>


                        <div class="admin-form-group">

                            <label asp-for="Description"
                                   class="admin-form-label">
                                الوصف
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control admin-form-control admin-form-textarea"
                                      rows="6"
                                      placeholder="اكتب وصفًا للمنتج أو استخداماته أو مميزاته أو أي معلومات مفيدة أخرى."></textarea>

                            <span asp-validation-for="Description"
                                  class="admin-form-validation">
                            </span>

                            <div class="admin-form-help">
                                اختياري. أضف معلومات مفيدة تساعد العملاء على فهم المنتج.
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Catalog Visibility -->
            <div class="col-lg-4">

                <div class="admin-card h-100">

                    <div class="admin-card-header">

                        <div class="admin-card-header-content">

                            <div class="admin-card-icon">

                                <i class="bi bi-eye"></i>

                            </div>

                            <div>

                                <h2 class="admin-card-title">
                                    ظهور المنتج في الكتالوج
                                </h2>

                                <p class="admin-card-description">
                                    تحكم في ظهور هذا المنتج في الكتالوج العام.
                                </p>

                            </div>

                        </div>

                    </div>


                    <div class="admin-card-body">

                        <div class="admin-form-switch">

                            <div class="form-check form-switch">

                                <input asp-for="IsActive"
                                       class="form-check-input"
                                       role="switch" />

                                <label asp-for="IsActive"
                                       class="form-check-label fw-semibold">
                                    المنتج نشط
                                </label>

                            </div>

                        </div>


                        <div class="admin-form-help mt-3">
                            المنتجات النشطة تظهر في الكتالوج العام ويمكن للعملاء إرسال طلبات عروض أسعار بشأنها.
                        </div>


                        <div class="admin-alert admin-alert-info mt-4 mb-0">

                            <div class="admin-alert-icon">
                                <i class="bi bi-lightbulb"></i>
                            </div>

                            <div class="small">

                                <strong>
                                    نصيحة:
                                </strong>

                                يمكنك تعطيل المنتج لاحقًا دون حذفه.

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Actions -->
            <div class="col-12">

                <div class="admin-card">

                    <div class="admin-card-footer">

                        <div class="admin-form-actions">

                            <a asp-area="Admin"
                               asp-controller="Products"
                               asp-action="Index"
                               class="btn admin-btn admin-btn-secondary">

                                <i class="bi bi-x-lg"></i>

                                <span>
                                    إلغاء
                                </span>

                            </a>

                            <button type="submit"
                                    class="btn admin-btn admin-btn-primary">

                                <i class="bi bi-check-lg"></i>

                                <span>
                                    إنشاء المنتج
                                </span>

                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin-products-form.css"
          asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}