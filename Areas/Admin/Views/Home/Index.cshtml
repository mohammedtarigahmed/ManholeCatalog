@{
    ViewData["Title"] = "لوحة التحكم";

    var recentQuotationRequests =
        ViewBag.RecentQuotationRequests
        as List<ManholeCatalog.Models.QuotationRequest>
        ?? new List<ManholeCatalog.Models.QuotationRequest>();
}

<div class="admin-page">

    <!-- Page Header -->
    <div class="admin-page-header">

        <div class="admin-page-header-row">

            <div class="admin-page-header-main">

                <div class="admin-page-header-eyebrow">
                    <i class="bi bi-speedometer2"></i>
                    لوحة الإدارة
                </div>

                <h1 class="admin-page-header-title">
                    لوحة التحكم
                </h1>

                <p class="admin-page-header-description">
                    نظرة سريعة على المنتجات والفئات وطلبات عروض الأسعار.
                </p>

            </div>

            <div class="admin-page-header-actions">

                <a asp-area=""
                   asp-controller="Catalog"
                   asp-action="Index"
                   class="btn admin-btn admin-btn-secondary">

                    <i class="bi bi-shop"></i>

                    <span>
                        عرض الكتالوج
                    </span>

                </a>

                <a asp-area="Admin"
                   asp-controller="Products"
                   asp-action="Create"
                   class="btn admin-btn admin-btn-primary">

                    <i class="bi bi-plus-lg"></i>

                    <span>
                        إضافة منتج
                    </span>

                </a>

            </div>

        </div>

    </div>


    <!-- Main Statistics -->
    <div class="admin-stats-grid">

        <!-- Total Products -->
        <a asp-area="Admin"
           asp-controller="Products"
           asp-action="Index"
           class="admin-stat-card text-decoration-none">

            <div class="admin-stat-card-content">

                <div class="admin-stat-card-top">

                    <div>

                        <div class="admin-stat-label">
                            إجمالي المنتجات
                        </div>

                        <div class="admin-stat-value">
                            @ViewBag.TotalProducts
                        </div>

                    </div>

                    <div class="admin-stat-icon admin-stat-icon-primary">
                        <i class="bi bi-box-seam"></i>
                    </div>

                </div>

                <div class="admin-stat-note">
                    <i class="bi bi-arrow-left"></i>
                    إدارة المنتجات
                </div>

            </div>

        </a>


        <!-- Active Products -->
        <a asp-area="Admin"
           asp-controller="Products"
           asp-action="Index"
           class="admin-stat-card text-decoration-none">

            <div class="admin-stat-card-content">

                <div class="admin-stat-card-top">

                    <div>

                        <div class="admin-stat-label">
                            المنتجات النشطة
                        </div>

                        <div class="admin-stat-value admin-stat-value-success">
                            @ViewBag.ActiveProducts
                        </div>

                    </div>

                    <div class="admin-stat-icon admin-stat-icon-success">
                        <i class="bi bi-check-circle"></i>
                    </div>

                </div>

                <div class="admin-stat-note">
                    <i class="bi bi-eye"></i>
                    الظاهرة في الكتالوج
                </div>

            </div>

        </a>


        <!-- Categories -->
        <a asp-area="Admin"
           asp-controller="Categories"
           asp-action="Index"
           class="admin-stat-card text-decoration-none">

            <div class="admin-stat-card-content">

                <div class="admin-stat-card-top">

                    <div>

                        <div class="admin-stat-label">
                            إجمالي الفئات
                        </div>

                        <div class="admin-stat-value">
                            @ViewBag.TotalCategories
                        </div>

                    </div>

                    <div class="admin-stat-icon admin-stat-icon-neutral">
                        <i class="bi bi-tags"></i>
                    </div>

                </div>

                <div class="admin-stat-note">
                    <i class="bi bi-folder2"></i>
                    تنظيم المنتجات
                </div>

            </div>

        </a>


        <!-- Pending Quotations -->
        <a asp-area="Admin"
           asp-controller="Quotations"
           asp-action="Index"
           class="admin-stat-card text-decoration-none">

            <div class="admin-stat-card-content">

                <div class="admin-stat-card-top">

                    <div>

                        <div class="admin-stat-label">
                            طلبات قيد المراجعة
                        </div>

                        <div class="admin-stat-value admin-stat-value-warning">
                            @ViewBag.PendingQuotationRequests
                        </div>

                    </div>

                    <div class="admin-stat-icon admin-stat-icon-warning">
                        <i class="bi bi-hourglass-split"></i>
                    </div>

                </div>

                <div class="admin-stat-note">
                    <i class="bi bi-arrow-left"></i>
                    تحتاج إلى متابعة
                </div>

            </div>

        </a>

        <!-- Total Quotations -->
        <a asp-area="Admin"
           asp-controller="Quotations"
           asp-action="Index"
           class="admin-stat-card text-decoration-none">

            <div class="admin-stat-card-content">

                <div class="admin-stat-card-top">

                    <div>

                        <div class="admin-stat-label">
                            إجمالي طلبات عروض الأسعار
                        </div>

                        <div class="admin-stat-value">
                            @ViewBag.TotalQuotationRequests
                        </div>

                    </div>

                    <div class="admin-stat-icon admin-stat-icon-primary">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>

                </div>

                <div class="admin-stat-note">
                     جميع طلبات العملاء المسجلة في النظام.
                </div>

            </div>

        </a>

        <!-- Products Without Images -->
        <a asp-area="Admin"
           asp-controller="Products"
           asp-action="Index"
           class="admin-stat-card text-decoration-none">

            <div class="admin-stat-card-content">

                <div class="admin-stat-card-top">

                    <div>

                        <div class="admin-stat-label">
                            منتجات بدون صور
                        </div>

                        <div class="admin-stat-value admin-stat-value-warning">
                                @ViewBag.ProductsWithoutImages
                        </div>

                    </div>

                    <div class="admin-stat-icon admin-stat-icon-warning">
                        <i class="bi bi-images"></i>
                    </div>

                </div>

                <div class="admin-stat-note">
                    منتجات تحتاج إلى مراجعة صورها.
                </div>

            </div>

        </a>

    </div>

    <!-- Recent Quotations -->
    <div class="admin-card mb-4">

        <div class="admin-card-header">

            <div class="admin-card-header-row">

                <div class="admin-card-header-content">

                    <div class="admin-card-icon">
                        <i class="bi bi-clock-history"></i>
                    </div>

                    <div>

                        <h2 class="admin-card-title">
                            أحدث طلبات عروض الأسعار
                        </h2>

                        <p class="admin-card-description">
                            آخر الطلبات التي أرسلها العملاء.
                        </p>

                    </div>

                </div>

                <a asp-area="Admin"
                   asp-controller="Quotations"
                   asp-action="Index"
                   class="btn admin-btn admin-btn-secondary admin-btn-sm">

                    <span>
                        عرض جميع الطلبات
                    </span>

                    <i class="bi bi-arrow-left"></i>

                </a>

            </div>

        </div>


        <div class="admin-card-body p-0">

            @if (recentQuotationRequests.Count == 0)
            {
                <div class="admin-empty-state">

                    <div class="admin-empty-icon">
                        <i class="bi bi-inbox"></i>
                    </div>

                    <h3 class="admin-empty-title">
                        لا توجد طلبات عروض أسعار
                    </h3>

                    <p class="admin-empty-description">
                        ستظهر طلبات العملاء هنا عند إرسالها.
                    </p>

                </div>
            }
            else
            {
                <div class="admin-table-wrapper">

                    <table class="table admin-table align-middle mb-0">

                        <thead>

                            <tr>

                                <th>
                                    الطلب
                                </th>

                                <th>
                                    العميل
                                </th>

                                <th>
                                    المنتج
                                </th>

                                <th>
                                    الكمية
                                </th>

                                <th>
                                    الحالة
                                </th>

                                <th>
                                    تاريخ الإرسال
                                </th>

                                <th>
                                    الإجراء
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var request in recentQuotationRequests)
                            {
                                <tr>

                                    <!-- Request -->
                                    <td>

                                        <div class="d-flex align-items-center gap-2">

                                            <div class="admin-icon-btn">
                                                <i class="bi bi-file-earmark-text"></i>
                                            </div>

                                            <div>

                                                <div class="admin-table-primary">
                                                    #@request.Id
                                                </div>

                                                <div class="admin-table-secondary">
                                                    طلب عرض سعر
                                                </div>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- Customer -->
                                    <td>

                                        <div class="admin-table-primary">
                                            @request.FullName
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(request.CompanyName))
                                        {
                                            <div class="admin-table-secondary">
                                                @request.CompanyName
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="admin-table-secondary">
                                                @request.Email
                                            </div>
                                        }

                                    </td>


                                    <!-- Product -->
                                    <td>

                                        @if (request.Product != null)
                                        {
                                            <div class="admin-table-primary">
                                                @request.Product.Name
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(request.Product.SKU))
                                            {
                                                <div class="admin-table-secondary">
                                                    @request.Product.SKU
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                منتج غير معروف
                                            </span>
                                        }

                                    </td>


                                    <!-- Quantity -->
                                    <td>

                                        <span class="admin-badge admin-badge-neutral">
                                            @request.Quantity
                                        </span>

                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @switch (request.Status)
                                        {
                                            case ManholeCatalog.Models.QuotationStatus.Pending:

                                                <span class="admin-badge admin-badge-warning">
                                                    قيد الانتظار
                                                </span>

                                                break;

                                            case ManholeCatalog.Models.QuotationStatus.Contacted:

                                                <span class="admin-badge admin-badge-info">
                                                    تم التواصل
                                                </span>

                                                break;

                                            case ManholeCatalog.Models.QuotationStatus.Quoted:

                                                <span class="admin-badge admin-badge-primary">
                                                    تم تقديم العرض
                                                </span>

                                                break;

                                            case ManholeCatalog.Models.QuotationStatus.Closed:

                                                <span class="admin-badge admin-badge-neutral">
                                                    مغلق
                                                </span>

                                                break;

                                            default:

                                                <span class="admin-badge admin-badge-neutral">
                                                    غير معروف
                                                </span>

                                                break;
                                        }

                                    </td>


                                    <!-- Submitted -->
                                    <td>

                                        <div class="text-nowrap">
                                            @request.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                        </div>

                                        <div class="admin-table-secondary text-nowrap">
                                            @request.CreatedAt.ToLocalTime().ToString("hh:mm tt")
                                        </div>

                                    </td>


                                    <!-- Action -->
                                    <td>

                                        <div class="admin-table-actions">

                                            <a asp-area="Admin"
                                               asp-controller="Quotations"
                                               asp-action="Details"
                                               asp-route-id="@request.Id"
                                               class="btn admin-btn admin-btn-secondary admin-btn-sm">

                                                <i class="bi bi-eye"></i>
                                                <span>عرض</span>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>


    <!-- Quick Actions -->
    <div class="admin-card">

        <div class="admin-card-header">

            <div class="admin-card-header-content">

                <div class="admin-card-icon">
                    <i class="bi bi-lightning-charge"></i>
                </div>

                <div>

                    <h2 class="admin-card-title">
                        إجراءات سريعة
                    </h2>

                    <p class="admin-card-description">
                        الوصول المباشر إلى المهام الأكثر استخدامًا.
                    </p>

                </div>

            </div>

        </div>


        <div class="admin-card-body">

            <div class="row g-3">

                <!-- Products -->
                <div class="col-md-6 col-xl-3">

                    <div class="admin-card admin-card-nested h-100">

                        <div class="admin-card-body d-flex flex-column">

                            <div class="admin-card-icon mb-3">
                                <i class="bi bi-box-seam"></i>
                            </div>

                            <h3 class="admin-card-title mb-2">
                                المنتجات
                            </h3>

                            <p class="admin-card-description flex-grow-1">
                                إضافة المنتجات وتعديلها وإدارة صورها.
                            </p>

                            <a asp-area="Admin"
                               asp-controller="Products"
                               asp-action="Index"
                               class="btn admin-btn admin-btn-secondary">

                                <span>
                                    إدارة المنتجات
                                </span>

                                <i class="bi bi-arrow-left"></i>

                            </a>

                        </div>

                    </div>

                </div>


                <!-- Categories -->
                <div class="col-md-6 col-xl-3">

                    <div class="admin-card admin-card-nested h-100">

                        <div class="admin-card-body d-flex flex-column">

                            <div class="admin-card-icon mb-3">
                                <i class="bi bi-tags"></i>
                            </div>

                            <h3 class="admin-card-title mb-2">
                                الفئات
                            </h3>

                            <p class="admin-card-description flex-grow-1">
                                تنظيم المنتجات ضمن فئات الكتالوج.
                            </p>

                            <a asp-area="Admin"
                               asp-controller="Categories"
                               asp-action="Index"
                               class="btn admin-btn admin-btn-secondary">

                                <span>
                                    إدارة الفئات
                                </span>

                                <i class="bi bi-arrow-left"></i>

                            </a>

                        </div>

                    </div>

                </div>


                <!-- Quotations -->
                <div class="col-md-6 col-xl-3">

                    <div class="admin-card admin-card-nested h-100">

                        <div class="admin-card-body d-flex flex-column">

                            <div class="admin-card-icon mb-3">
                                <i class="bi bi-file-earmark-text"></i>
                            </div>

                            <h3 class="admin-card-title mb-2">
                                عروض الأسعار
                            </h3>

                            <p class="admin-card-description flex-grow-1">
                                مراجعة طلبات العملاء وتحديث حالتها.
                            </p>

                            <a asp-area="Admin"
                               asp-controller="Quotations"
                               asp-action="Index"
                               class="btn admin-btn admin-btn-secondary">

                                <span>
                                    إدارة الطلبات
                                </span>

                                <i class="bi bi-arrow-left"></i>

                            </a>

                        </div>

                    </div>

                </div>


                <!-- Catalog -->
                <div class="col-md-6 col-xl-3">

                    <div class="admin-card admin-card-nested h-100">

                        <div class="admin-card-body d-flex flex-column">

                            <div class="admin-card-icon mb-3">
                                <i class="bi bi-shop"></i>
                            </div>

                            <h3 class="admin-card-title mb-2">
                                الكتالوج
                            </h3>

                            <p class="admin-card-description flex-grow-1">
                                مراجعة الكتالوج كما يظهر للعملاء.
                            </p>

                            <a asp-area=""
                               asp-controller="Catalog"
                               asp-action="Index"
                               class="btn admin-btn admin-btn-secondary">

                                <span>
                                    عرض الكتالوج
                                </span>

                                <i class="bi bi-arrow-left"></i>

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>