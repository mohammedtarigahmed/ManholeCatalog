@{
    ViewData["Title"] = "لوحة التحكم";

    var recentQuotationRequests =
        ViewBag.RecentQuotationRequests
        as List<ManholeCatalog.Models.QuotationRequest>
        ?? new List<ManholeCatalog.Models.QuotationRequest>();
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

    <div>

        <h1 class="h3 fw-bold mb-1">
            لوحة التحكم
        </h1>

        <p class="text-muted mb-0">
            نظرة عامة على الكتالوج وطلبات عروض الأسعار.
        </p>

    </div>

    <div class="d-flex flex-wrap gap-2">

        <a asp-area=""
           asp-controller="Catalog"
           asp-action="Index"
           class="btn btn-outline-secondary">
            عرض الكتالوج
        </a>

        <a asp-area="Admin"
           asp-controller="Products"
           asp-action="Create"
           class="btn btn-primary">
            + إضافة منتج
        </a>

    </div>

</div>

<!-- Main Statistics -->
<div class="row g-4 mb-4">

    <!-- Total Products -->
    <div class="col-md-6 col-xl-3">

        <a asp-area="Admin"
           asp-controller="Products"
           asp-action="Index"
           class="text-decoration-none">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <div class="small text-muted mb-1">
                                إجمالي المنتجات
                            </div>

                            <div class="h2 fw-bold text-dark mb-0">
                                @ViewBag.TotalProducts
                            </div>

                        </div>

                        <span class="badge text-bg-light border">
                            المنتجات
                        </span>

                    </div>

                    <div class="small text-muted mt-3">
                        عرض وإدارة المنتجات.
                    </div>

                </div>

            </div>

        </a>

    </div>

    <!-- Active Products -->
    <div class="col-md-6 col-xl-3">

        <a asp-area="Admin"
           asp-controller="Products"
           asp-action="Index"
           class="text-decoration-none">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <div class="small text-muted mb-1">
                                المنتجات النشطة
                            </div>

                            <div class="h2 fw-bold text-success mb-0">
                                @ViewBag.ActiveProducts
                            </div>

                        </div>

                        <span class="badge text-bg-success">
                            نشطة
                        </span>

                    </div>

                    <div class="small text-muted mt-3">
                        المنتجات الظاهرة حاليًا في الكتالوج.
                    </div>

                </div>

            </div>

        </a>

    </div>

    <!-- Categories -->
    <div class="col-md-6 col-xl-3">

        <a asp-area="Admin"
           asp-controller="Categories"
           asp-action="Index"
           class="text-decoration-none">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <div class="small text-muted mb-1">
                                إجمالي الفئات
                            </div>

                            <div class="h2 fw-bold text-dark mb-0">
                                @ViewBag.TotalCategories
                            </div>

                        </div>

                        <span class="badge text-bg-light border">
                            الفئات
                        </span>

                    </div>

                    <div class="small text-muted mt-3">
                        تنظيم المنتجات داخل الكتالوج.
                    </div>

                </div>

            </div>

        </a>

    </div>

    <!-- Pending Quotations -->
    <div class="col-md-6 col-xl-3">

        <a asp-area="Admin"
           asp-controller="Quotations"
           asp-action="Index"
           class="text-decoration-none">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <div class="small text-muted mb-1">
                                عروض الأسعار قيد المراجعة
                            </div>

                            <div class="h2 fw-bold text-warning mb-0">
                                @ViewBag.PendingQuotationRequests
                            </div>

                        </div>

                        <span class="badge text-bg-warning">
                            قيد المراجعة
                        </span>

                    </div>

                    <div class="small text-muted mt-3">
                        الطلبات التي تنتظر اتخاذ إجراء.
                    </div>

                </div>

            </div>

        </a>

    </div>

</div>

<!-- Secondary Statistics -->
<div class="row g-4 mb-4">

    <!-- Total Quotations -->
    <div class="col-md-6">

        <a asp-area="Admin"
           asp-controller="Quotations"
           asp-action="Index"
           class="text-decoration-none">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="small text-muted mb-1">
                                إجمالي طلبات عروض الأسعار
                            </div>

                            <div class="h2 fw-bold text-dark mb-0">
                                @ViewBag.TotalQuotationRequests
                            </div>

                        </div>

                        <span class="badge text-bg-light border">
                            الطلبات
                        </span>

                    </div>

                    <div class="small text-muted mt-3">
                        عرض جميع طلبات عروض الأسعار من العملاء.
                    </div>

                </div>

            </div>

        </a>

    </div>

    <!-- Products Without Images -->
    <div class="col-md-6">

        <a asp-area="Admin"
           asp-controller="Products"
           asp-action="Index"
           class="text-decoration-none">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="small text-muted mb-1">
                                منتجات بدون صور
                            </div>

                            <div class="h2 fw-bold text-warning mb-0">
                                @ViewBag.ProductsWithoutImages
                            </div>

                        </div>

                        <span class="badge text-bg-warning">
                            الصور
                        </span>

                    </div>

                    <div class="small text-muted mt-3">
                        منتجات قد تحتاج إلى إضافة صور.
                    </div>

                </div>

            </div>

        </a>

    </div>

</div>

<!-- Recent Quotations -->
<div class="card border-0 shadow-sm mb-4">

    <div class="card-header bg-white py-3">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">

            <div>

                <h2 class="h6 fw-bold mb-1">
                    أحدث طلبات عروض الأسعار
                </h2>

                <p class="text-muted small mb-0">
                    أحدث طلبات عروض الأسعار التي أرسلها العملاء.
                </p>

            </div>

            <a asp-area="Admin"
               asp-controller="Quotations"
               asp-action="Index"
               class="btn btn-sm btn-outline-primary">
                عرض جميع الطلبات
            </a>

        </div>

    </div>

    <div class="card-body p-0">

        @if (recentQuotationRequests.Count == 0)
        {
            <div class="text-center py-5 px-4">

                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light border mb-3"
                     style="width: 64px; height: 64px;">

                    <span class="text-muted fw-bold fs-5">
                        Q
                    </span>

                </div>

                <h3 class="h6 fw-bold mb-2">
                    لا توجد طلبات عروض أسعار بعد
                </h3>

                <p class="text-muted mb-0">
                    ستظهر طلبات عروض الأسعار هنا عند إرسالها من العملاء.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-4">
                                الطلب
                            </th>

                            <th>
                                العميل
                            </th>

                            <th>
                                المنتج
                            </th>

                            <th>
                                الكمية
                            </th>

                            <th>
                                الحالة
                            </th>

                            <th>
                                تاريخ الإرسال
                            </th>

                            <th class="text-end pe-4">
                                الإجراء
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var request in recentQuotationRequests)
                        {
                            <tr>

                                <!-- Request -->
                                <td class="ps-4">

                                    <div class="fw-semibold">
                                        #@request.Id
                                    </div>

                                    <div class="small text-muted">
                                        عرض سعر
                                    </div>

                                </td>

                                <!-- Customer -->
                                <td>

                                    <div class="fw-semibold">
                                        @request.FullName
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(request.CompanyName))
                                    {
                                        <div class="small text-muted">
                                            @request.CompanyName
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="small text-muted">
                                            @request.Email
                                        </div>
                                    }

                                </td>

                                <!-- Product -->
                                <td>

                                    @if (request.Product != null)
                                    {
                                        <div class="fw-semibold">
                                            @request.Product.Name
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(request.Product.SKU))
                                        {
                                            <div class="small text-muted">
                                                الرقم التعريفي: @request.Product.SKU
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            منتج غير معروف
                                        </span>
                                    }

                                </td>

                                <!-- Quantity -->
                                <td>

                                    <span class="badge text-bg-light border">
                                        @request.Quantity
                                    </span>

                                </td>

                                <!-- Status -->
                                <td>

                                    @switch (request.Status)
                                    {
                                        case ManholeCatalog.Models.QuotationStatus.Pending:
                                            <span class="badge text-bg-warning">
                                                قيد المراجعة
                                            </span>
                                            break;

                                        case ManholeCatalog.Models.QuotationStatus.Contacted:
                                            <span class="badge text-bg-info">
                                                تم التواصل
                                            </span>
                                            break;

                                        case ManholeCatalog.Models.QuotationStatus.Quoted:
                                            <span class="badge text-bg-primary">
                                                تم تقديم العرض
                                            </span>
                                            break;

                                        case ManholeCatalog.Models.QuotationStatus.Closed:
                                            <span class="badge text-bg-secondary">
                                                مغلق
                                            </span>
                                            break;

                                        default:
                                            <span class="badge text-bg-light border">
                                                غير معروف
                                            </span>
                                            break;
                                    }

                                </td>

                                <!-- Submitted -->
                                <td>

                                    <div class="text-nowrap">
                                        @request.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </div>

                                    <div class="small text-muted text-nowrap">
                                        @request.CreatedAt.ToLocalTime().ToString("hh:mm tt")
                                    </div>

                                </td>

                                <!-- Action -->
                                <td class="text-end pe-4">

                                    <a asp-area="Admin"
                                       asp-controller="Quotations"
                                       asp-action="Details"
                                       asp-route-id="@request.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        عرض
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>

<!-- Quick Actions -->
<div class="mb-3">

    <h2 class="h5 fw-bold mb-1">
        إجراءات سريعة
    </h2>

    <p class="text-muted mb-0">
        مهام الإدارة الشائعة.
    </p>

</div>

<div class="row g-4">

    <!-- Products -->
    <div class="col-md-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body d-flex flex-column">

                <div class="small text-primary fw-semibold mb-2">
                    المنتجات
                </div>

                <h3 class="h6 fw-bold">
                    إدارة المنتجات
                </h3>

                <p class="text-muted small flex-grow-1">
                    إضافة وتعديل وتفعيل وتعطيل المنتجات وإدارة صورها.
                </p>

                <a asp-area="Admin"
                   asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    إدارة المنتجات
                </a>

            </div>

        </div>

    </div>

    <!-- Categories -->
    <div class="col-md-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body d-flex flex-column">

                <div class="small text-primary fw-semibold mb-2">
                    الفئات
                </div>

                <h3 class="h6 fw-bold">
                    إدارة الفئات
                </h3>

                <p class="text-muted small flex-grow-1">
                    تنظيم المنتجات ضمن فئات الكتالوج النشطة.
                </p>

                <a asp-area="Admin"
                   asp-controller="Categories"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    إدارة الفئات
                </a>

            </div>

        </div>

    </div>

    <!-- Quotations -->
    <div class="col-md-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body d-flex flex-column">

                <div class="small text-primary fw-semibold mb-2">
                    عروض الأسعار
                </div>

                <h3 class="h6 fw-bold">
                    إدارة عروض الأسعار
                </h3>

                <p class="text-muted small flex-grow-1">
                    مراجعة طلبات العملاء وتحديث حالتها.
                </p>

                <a asp-area="Admin"
                   asp-controller="Quotations"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    إدارة عروض الأسعار
                </a>

            </div>

        </div>

    </div>

    <!-- Catalog -->
    <div class="col-md-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body d-flex flex-column">

                <div class="small text-primary fw-semibold mb-2">
                    الكتالوج
                </div>

                <h3 class="h6 fw-bold">
                    عرض الكتالوج العام
                </h3>

                <p class="text-muted small flex-grow-1">
                    فتح كتالوج العملاء ومراجعة تجربة المستخدم العامة.
                </p>

                <a asp-area=""
                   asp-controller="Catalog"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    عرض الكتالوج
                </a>

            </div>

        </div>

    </div>

</div>