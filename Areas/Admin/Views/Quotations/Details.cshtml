@model ManholeCatalog.Models.QuotationRequest

@{
    ViewData["Title"] = "تفاصيل طلب عرض السعر";
}

<div class="admin-page">

    <div class="admin-page-header">
        <div class="admin-page-header-row">

            <div class="admin-page-header-main">

                <div class="admin-page-header-eyebrow">
                    <i class="bi bi-receipt"></i>
                    إدارة الطلبات

                    <span class="admin-badge admin-badge-neutral">
                        الطلب #@Model.Id
                    </span>

                    @switch (Model.Status)
                    {
                        case ManholeCatalog.Models.QuotationStatus.Pending:
                            <span class="admin-badge admin-badge-warning">
                                <i class="bi bi-clock"></i>
                                قيد الانتظار
                            </span>
                            break;

                        case ManholeCatalog.Models.QuotationStatus.Contacted:
                            <span class="admin-badge admin-badge-info">
                                <i class="bi bi-chat-dots"></i>
                                تم التواصل
                            </span>
                            break;

                        case ManholeCatalog.Models.QuotationStatus.Quoted:
                            <span class="admin-badge admin-badge-primary">
                                <i class="bi bi-file-earmark-check"></i>
                                تم تقديم العرض
                            </span>
                            break;

                        case ManholeCatalog.Models.QuotationStatus.Closed:
                            <span class="admin-badge admin-badge-neutral">
                                <i class="bi bi-check-circle"></i>
                                مغلقة
                            </span>
                            break;
                    }
                </div>

                <h1 class="admin-page-header-title">
                    طلب عرض السعر #@Model.Id
                </h1>

                <p class="admin-page-header-description">
                    مراجعة بيانات العميل ومتطلبات المنتج وحالة الطلب.
                </p>

            </div>

            <div class="admin-page-header-actions">

                <a asp-area="Admin"
                   asp-controller="Quotations"
                   asp-action="Index"
                   class="admin-btn admin-btn-secondary">

                    <i class="bi bi-arrow-right"></i>
                    <span>العودة إلى الطلبات</span>

                </a>

            </div>

        </div>
    </div>


    <div class="row g-4">

        <!-- Customer Information -->

        <div class="col-lg-6">

            <div class="admin-card h-100">

                <div class="admin-card-header">

                    <div class="admin-card-header-content">

                        <div class="admin-card-icon">
                            <i class="bi bi-person"></i>
                        </div>

                        <div>
                            <h2 class="admin-card-title">
                                بيانات العميل
                            </h2>

                            <p class="admin-card-description">
                                معلومات العميل ووسائل التواصل.
                            </p>
                        </div>

                    </div>

                </div>


                <div class="admin-card-body">

                    <div class="quotation-info-item">

                        <div class="admin-form-help quotation-info-label">
                            الاسم الكامل
                        </div>

                        <div class="quotation-info-value quotation-info-value-lg">
                            @Model.FullName
                        </div>

                    </div>


                    <div class="quotation-info-item">

                        <div class="admin-form-help quotation-info-label">
                            اسم الشركة
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.CompanyName))
                        {
                            <div class="quotation-info-value">
                                @Model.CompanyName
                            </div>
                        }
                        else
                        {
                            <span class="quotation-info-empty">
                                لم يتم إدخاله
                            </span>
                        }

                    </div>


                    <div class="quotation-info-item">

                        <div class="admin-form-help quotation-info-label">
                            البريد الإلكتروني
                        </div>

                        <div class="quotation-contact-row">

                            <a href="mailto:@Model.Email"
                               class="quotation-contact-value">

                                <i class="bi bi-envelope"></i>
                                <span>@Model.Email</span>

                            </a>

                            <a href="mailto:@Model.Email"
                               class="admin-btn admin-btn-secondary admin-btn-sm">

                                <i class="bi bi-send"></i>
                                <span>إرسال بريد</span>

                            </a>

                        </div>

                    </div>


                    <div class="quotation-info-item quotation-info-item-last">

                        <div class="admin-form-help quotation-info-label">
                            رقم الهاتف
                        </div>

                        <div class="quotation-contact-row">

                            <a href="tel:@Model.PhoneNumber"
                               class="quotation-contact-value">

                                <i class="bi bi-telephone"></i>
                                <span>@Model.PhoneNumber</span>

                            </a>

                            <a href="tel:@Model.PhoneNumber"
                               class="admin-btn admin-btn-secondary admin-btn-sm">

                                <i class="bi bi-telephone-outbound"></i>
                                <span>اتصال</span>

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Request Information -->

        <div class="col-lg-6">

            <div class="admin-card h-100">

                <div class="admin-card-header">

                    <div class="admin-card-header-content">

                        <div class="admin-card-icon">
                            <i class="bi bi-file-earmark-text"></i>
                        </div>

                        <div>
                            <h2 class="admin-card-title">
                                بيانات الطلب
                            </h2>

                            <p class="admin-card-description">
                                تفاصيل المنتج والطلب والتواريخ.
                            </p>
                        </div>

                    </div>

                </div>


                <div class="admin-card-body">

                    <div class="quotation-info-item">

                        <div class="admin-form-help quotation-info-label">
                            المنتج
                        </div>

                        @if (Model.Product != null)
                        {
                            <div class="quotation-product-row">

                                <a asp-area="Admin"
                                   asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@Model.Product.Id"
                                   class="quotation-product-link">

                                    <i class="bi bi-box-seam"></i>
                                    <span>@Model.Product.Name</span>

                                </a>

                                @if (!string.IsNullOrWhiteSpace(Model.Product.SKU))
                                {
                                    <span class="admin-badge admin-badge-neutral">
                                        SKU: @Model.Product.SKU
                                    </span>
                                }

                            </div>
                        }
                        else
                        {
                            <span class="quotation-info-empty">
                                منتج غير معروف
                            </span>
                        }

                    </div>


                    <div class="quotation-info-item">

                        <div class="admin-form-help quotation-info-label">
                            الكمية
                        </div>

                        <div class="quotation-quantity">

                            <span class="quotation-quantity-icon">
                                <i class="bi bi-box-seam"></i>
                            </span>

                            <span class="quotation-info-value quotation-info-value-lg">
                                @Model.Quantity
                            </span>

                        </div>

                    </div>


                    <div class="quotation-info-item">

                        <div class="admin-form-help quotation-info-label">
                            الحالة الحالية
                        </div>

                        @switch (Model.Status)
                        {
                            case ManholeCatalog.Models.QuotationStatus.Pending:
                                <span class="admin-badge admin-badge-warning">
                                    <i class="bi bi-clock"></i>
                                    قيد الانتظار
                                </span>
                                break;

                            case ManholeCatalog.Models.QuotationStatus.Contacted:
                                <span class="admin-badge admin-badge-info">
                                    <i class="bi bi-chat-dots"></i>
                                    تم التواصل
                                </span>
                                break;

                            case ManholeCatalog.Models.QuotationStatus.Quoted:
                                <span class="admin-badge admin-badge-primary">
                                    <i class="bi bi-file-earmark-check"></i>
                                    تم تقديم العرض
                                </span>
                                break;

                            case ManholeCatalog.Models.QuotationStatus.Closed:
                                <span class="admin-badge admin-badge-neutral">
                                    <i class="bi bi-check-circle"></i>
                                    مغلقة
                                </span>
                                break;

                            default:
                                <span class="admin-badge admin-badge-neutral">
                                    غير معروفة
                                </span>
                                break;
                        }

                    </div>


                    <div class="quotation-info-item">

                        <div class="admin-form-help quotation-info-label">
                            تاريخ تقديم الطلب
                        </div>

                        <div class="quotation-date-value">

                            <i class="bi bi-calendar3"></i>

                            <span>
                                @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy - hh:mm tt")
                            </span>

                        </div>

                    </div>


                    @if (Model.UpdatedAt.HasValue)
                    {
                        <div class="quotation-info-item quotation-info-item-last">

                            <div class="admin-form-help quotation-info-label">
                                آخر تحديث
                            </div>

                            <div class="quotation-date-value">

                                <i class="bi bi-arrow-repeat"></i>

                                <span>
                                    @Model.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy - hh:mm tt")
                                </span>

                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- Customer Message -->

        <div class="col-12">

            <div class="admin-card">

                <div class="admin-card-header">

                    <div class="admin-card-header-content">

                        <div class="admin-card-icon">
                            <i class="bi bi-chat-left-text"></i>
                        </div>

                        <div>
                            <h2 class="admin-card-title">
                                رسالة العميل
                            </h2>

                            <p class="admin-card-description">
                                الرسالة المرفقة مع طلب عرض السعر.
                            </p>
                        </div>

                    </div>

                </div>


                <div class="admin-card-body">

                    @if (!string.IsNullOrWhiteSpace(Model.Message))
                    {
                        <div class="quotation-message-box">
                            @Model.Message
                        </div>
                    }
                    else
                    {
                        <div class="admin-empty-state quotation-empty-message">

                            <div class="admin-empty-icon">
                                <i class="bi bi-chat-square-text"></i>
                            </div>

                            <div class="admin-empty-title">
                                لا توجد رسالة
                            </div>

                            <div class="admin-empty-description">
                                لم يرسل العميل أي رسالة مع طلب عرض السعر.
                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- Update Status -->

        <div class="col-12">

            <div class="admin-card">

                <div class="admin-card-header">

                    <div class="admin-card-header-content">

                        <div class="admin-card-icon">
                            <i class="bi bi-arrow-repeat"></i>
                        </div>

                        <div>
                            <h2 class="admin-card-title">
                                تحديث حالة الطلب
                            </h2>

                            <p class="admin-card-description">
                                تغيير الحالة الحالية لطلب عرض السعر.
                            </p>
                        </div>

                    </div>

                </div>


                <div class="admin-card-body">

                    <form asp-area="Admin"
                          asp-controller="Quotations"
                          asp-action="UpdateStatus"
                          method="post">

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <div class="row g-3">

                            <div class="col-md-8">

                                <label for="status"
                                       class="admin-form-label">
                                    الحالة
                                </label>

                                <select id="status"
                                        name="status"
                                        class="form-select admin-form-control">

                                    @if (Model.Status == ManholeCatalog.Models.QuotationStatus.Pending)
                                    {
                                        <option value="1" selected>
                                            قيد الانتظار
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="1">
                                            قيد الانتظار
                                        </option>
                                    }

                                    @if (Model.Status == ManholeCatalog.Models.QuotationStatus.Contacted)
                                    {
                                        <option value="2" selected>
                                            تم التواصل
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="2">
                                            تم التواصل
                                        </option>
                                    }

                                    @if (Model.Status == ManholeCatalog.Models.QuotationStatus.Quoted)
                                    {
                                        <option value="3" selected>
                                            تم تقديم العرض
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="3">
                                            تم تقديم العرض
                                        </option>
                                    }

                                    @if (Model.Status == ManholeCatalog.Models.QuotationStatus.Closed)
                                    {
                                        <option value="4" selected>
                                            مغلقة
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="4">
                                            مغلقة
                                        </option>
                                    }

                                </select>

                            </div>


                            <div class="col-md-4">

                                <label class="admin-form-label">
                                    الإجراءات
                                </label>

                                <button type="submit"
                                        class="admin-btn admin-btn-primary admin-btn-lg quotation-update-button">

                                    <i class="bi bi-check2-circle"></i>
                                    <span>تحديث الحالة</span>

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/quotations-details.css"
          asp-append-version="true" />
}