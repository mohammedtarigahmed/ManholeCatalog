@model IEnumerable<ManholeCatalog.Models.QuotationRequest>

@{
    ViewData["Title"] = "طلبات عروض الأسعار";

    var requests = Model.ToList();

    var totalRequests = requests.Count;
    var pendingRequests = requests.Count(r => r.Status == ManholeCatalog.Models.QuotationStatus.Pending);
    var contactedRequests = requests.Count(r => r.Status == ManholeCatalog.Models.QuotationStatus.Contacted);
    var quotedRequests = requests.Count(r => r.Status == ManholeCatalog.Models.QuotationStatus.Quoted);
    var closedRequests = requests.Count(r => r.Status == ManholeCatalog.Models.QuotationStatus.Closed);
}

<div class="admin-page">

    <!-- Page Header -->
    <div class="admin-page-header">

        <div class="admin-page-header-row">

            <div class="admin-page-header-main">

                <div class="admin-page-header-eyebrow">

                    <i class="bi bi-receipt"></i>
                    إدارة الطلبات

                    <span class="admin-badge admin-badge-neutral">
                        @totalRequests طلب
                    </span>

                </div>

                <h1 class="admin-page-header-title">
                    طلبات عروض الأسعار
                </h1>

                <p class="admin-page-header-description">
                    إدارة ومتابعة طلبات عروض الأسعار الواردة من العملاء.
                </p>

            </div>

        </div>

    </div>


    <!-- Statistics -->
    <div class="admin-stats-grid quotation-stats-grid mb-4">

        <!-- Total -->
        <div class="admin-stat-card">

            <div class="admin-stat-card-content">

                <div class="admin-stat-card-top">

                    <div>

                        <div class="admin-stat-label">
                            إجمالي الطلبات
                        </div>

                        <div class="admin-stat-value">
                            @totalRequests
                        </div>

                    </div>

                    <div class="admin-stat-icon admin-stat-icon-primary">
                        <i class="bi bi-receipt"></i>
                    </div>

                </div>

                <div class="admin-stat-description">

                    <i class="bi bi-collection"></i>
                    جميع طلبات عروض الأسعار

                </div>

            </div>

        </div>


        <!-- Pending -->
        <div class="admin-stat-card">

            <div class="admin-stat-card-content">

                <div class="admin-stat-card-top">

                    <div>

                        <div class="admin-stat-label">
                            قيد الانتظار
                        </div>

                        <div class="admin-stat-value quotation-stat-value-warning">
                            @pendingRequests
                        </div>

                    </div>

                    <div class="admin-stat-icon admin-stat-icon-warning">
                        <i class="bi bi-clock"></i>
                    </div>

                </div>

                <div class="admin-stat-description">

                    <i class="bi bi-hourglass-split"></i>
                    بانتظار المتابعة

                </div>

            </div>

        </div>


        <!-- Contacted -->
        <div class="admin-stat-card">

            <div class="admin-stat-card-content">

                <div class="admin-stat-card-top">

                    <div>

                        <div class="admin-stat-label">
                            تم التواصل
                        </div>

                        <div class="admin-stat-value quotation-stat-value-info">
                            @contactedRequests
                        </div>

                    </div>

                    <div class="admin-stat-icon admin-stat-icon-neutral">
                        <i class="bi bi-chat-dots"></i>
                    </div>

                </div>

                <div class="admin-stat-description">

                    <i class="bi bi-telephone"></i>
                    تم التواصل مع العميل

                </div>

            </div>

        </div>


        <!-- Quoted -->
        <div class="admin-stat-card">

            <div class="admin-stat-card-content">

                <div class="admin-stat-card-top">

                    <div>

                        <div class="admin-stat-label">
                            تم تقديم العرض
                        </div>

                        <div class="admin-stat-value">
                            @quotedRequests
                        </div>

                    </div>

                    <div class="admin-stat-icon admin-stat-icon-primary">
                        <i class="bi bi-file-earmark-check"></i>
                    </div>

                </div>

                <div class="admin-stat-description">

                    <i class="bi bi-check2-circle"></i>
                    تم تقديم عرض سعر

                </div>

            </div>

        </div>


        <!-- Closed -->
        <div class="admin-stat-card">

            <div class="admin-stat-card-content">

                <div class="admin-stat-card-top">

                    <div>

                        <div class="admin-stat-label">
                            مغلقة
                        </div>

                        <div class="admin-stat-value quotation-stat-value-secondary">
                            @closedRequests
                        </div>

                    </div>

                    <div class="admin-stat-icon admin-stat-icon-neutral">
                        <i class="bi bi-check-circle"></i>
                    </div>

                </div>

                <div class="admin-stat-description">

                    <i class="bi bi-archive"></i>
                    الطلبات المكتملة

                </div>

            </div>

        </div>

    </div>


    <!-- Search & Filter -->
    <div class="admin-card quotation-filter-card mb-4">

        <div class="admin-card-header">

            <div class="admin-card-header-content">

                <div class="admin-card-icon">
                    <i class="bi bi-funnel"></i>
                </div>

                <div>

                    <h2 class="admin-card-title">
                        البحث والتصفية
                    </h2>

                    <p class="admin-card-description">
                        ابحث في الطلبات أو قم بتصفية النتائج حسب الحالة.
                    </p>

                </div>

            </div>

        </div>


        <div class="admin-card-body">

            <form asp-area="Admin"
                  asp-controller="Quotations"
                  asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <!-- Search -->
                    <div class="col-lg-7">

                        <label for="search"
                               class="admin-form-label">
                            البحث في الطلبات
                        </label>

                        <div class="quotation-input-group">

                            <i class="bi bi-search"></i>

                            <input type="text"
                                   id="search"
                                   name="search"
                                   value="@ViewBag.Search"
                                   class="form-control admin-form-control"
                                   placeholder="الاسم، الشركة، البريد الإلكتروني، الهاتف، أو المنتج..."
                                   autocomplete="off" />

                        </div>

                        <div class="admin-form-help">
                            <i class="bi bi-info-circle"></i>
                            البحث في بيانات العميل والمنتج.
                        </div>

                    </div>


                    <!-- Status -->
                    <div class="col-lg-3">

                        <label for="status"
                               class="admin-form-label">
                            الحالة
                        </label>

                        <select id="status"
                                name="status"
                                class="form-select admin-form-control">

                            <option value="">
                                جميع الحالات
                            </option>

                            @if (ViewBag.Status == ManholeCatalog.Models.QuotationStatus.Pending)
                            {
                                <option value="Pending" selected>
                                    قيد الانتظار
                                </option>
                            }
                            else
                            {
                                <option value="Pending">
                                    قيد الانتظار
                                </option>
                            }

                            @if (ViewBag.Status == ManholeCatalog.Models.QuotationStatus.Contacted)
                            {
                                <option value="Contacted" selected>
                                    تم التواصل
                                </option>
                            }
                            else
                            {
                                <option value="Contacted">
                                    تم التواصل
                                </option>
                            }

                            @if (ViewBag.Status == ManholeCatalog.Models.QuotationStatus.Quoted)
                            {
                                <option value="Quoted" selected>
                                    تم تقديم العرض
                                </option>
                            }
                            else
                            {
                                <option value="Quoted">
                                    تم تقديم العرض
                                </option>
                            }

                            @if (ViewBag.Status == ManholeCatalog.Models.QuotationStatus.Closed)
                            {
                                <option value="Closed" selected>
                                    مغلقة
                                </option>
                            }
                            else
                            {
                                <option value="Closed">
                                    مغلقة
                                </option>
                            }

                        </select>

                        <div class="admin-form-help">
                            <i class="bi bi-funnel"></i>
                            تصفية الطلبات حسب الحالة.
                        </div>

                    </div>


                    <!-- Actions -->
                    <div class="col-lg-2">

                        <label class="admin-form-label">
                            الإجراءات
                        </label>

                        <div class="quotation-filter-actions">

                            <button type="submit"
                                    class="admin-btn admin-btn-primary quotation-search-button">

                                <i class="bi bi-search"></i>
                                <span>بحث</span>

                            </button>

                            <a asp-area="Admin"
                               asp-controller="Quotations"
                               asp-action="Index"
                               class="admin-btn admin-btn-secondary quotation-reset-button"
                               title="إعادة ضبط">

                                <i class="bi bi-arrow-counterclockwise"></i>

                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    @if (!requests.Any())
    {
        <!-- Empty State -->

        <div class="admin-card quotation-section-card">

            <div class="admin-card-body">

                <div class="admin-empty-state">

                    <div class="admin-empty-icon">
                        <i class="bi bi-inbox"></i>
                    </div>

                    <div class="admin-empty-title">
                        لا توجد طلبات عروض أسعار
                    </div>

                    <div class="admin-empty-description">
                        لا توجد طلبات تطابق البحث أو التصفية الحالية.
                    </div>

                </div>

            </div>

        </div>
    }
    else
    {
        <!-- Requests List -->

        <div class="admin-card quotation-section-card">

            <div class="admin-card-header">

                <div class="admin-card-header-row">

                    <div class="admin-card-header-content">

                        <div class="admin-card-icon">
                            <i class="bi bi-list-ul"></i>
                        </div>

                        <div>

                            <h2 class="admin-card-title">
                                قائمة الطلبات
                            </h2>

                            <p class="admin-card-description">
                                عرض @totalRequests طلب
                            </p>

                        </div>

                    </div>

                    @if (pendingRequests > 0)
                    {
                        <span class="admin-badge admin-badge-warning">

                            <i class="bi bi-clock"></i>

                            @pendingRequests طلب قيد الانتظار

                        </span>
                    }

                </div>

            </div>


            <div class="admin-card-body p-0">

                <div class="table-responsive">

                    <table class="table admin-table quotation-table align-middle mb-0">

                        <thead>

                            <tr>

                                <th class="ps-4">
                                    الطلب
                                </th>

                                <th>
                                    المنتج
                                </th>

                                <th>
                                    العميل
                                </th>

                                <th>
                                    الكمية
                                </th>

                                <th>
                                    الحالة
                                </th>

                                <th>
                                    تاريخ الطلب
                                </th>

                                <th class="text-end pe-4">
                                    الإجراء
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var request in requests)
                            {
                                <tr>

                                    <!-- Request -->
                                    <td class="ps-4">

                                        <div class="d-flex align-items-center gap-3">

                                            <div class="quotation-request-icon">
                                                <i class="bi bi-receipt"></i>
                                            </div>

                                            <div>

                                                <div class="fw-semibold">
                                                    #@request.Id
                                                </div>

                                                <div class="small text-muted">
                                                    طلب عرض سعر
                                                </div>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- Product -->
                                    <td>

                                        @if (request.Product != null)
                                        {
                                            <div class="fw-semibold">
                                                @request.Product.Name
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(request.Product.SKU))
                                            {
                                                <div class="small text-muted">
                                                    SKU: @request.Product.SKU
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                منتج غير معروف
                                            </span>
                                        }

                                    </td>


                                    <!-- Customer -->
                                    <td>

                                        <div class="fw-semibold">
                                            @request.FullName
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(request.CompanyName))
                                        {
                                            <div class="small text-muted">
                                                @request.CompanyName
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="small text-muted">
                                                @request.Email
                                            </div>
                                        }

                                    </td>


                                    <!-- Quantity -->
                                    <td>

                                        <span class="admin-badge admin-badge-neutral quotation-quantity-badge">

                                            <i class="bi bi-box-seam"></i>

                                            @request.Quantity

                                        </span>

                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @switch (request.Status)
                                        {
                                            case ManholeCatalog.Models.QuotationStatus.Pending:

                                                <span class="admin-badge admin-badge-warning">

                                                    <i class="bi bi-clock"></i>

                                                    قيد الانتظار

                                                </span>

                                                break;

                                            case ManholeCatalog.Models.QuotationStatus.Contacted:

                                                <span class="admin-badge admin-badge-info">

                                                    <i class="bi bi-chat-dots"></i>

                                                    تم التواصل

                                                </span>

                                                break;

                                            case ManholeCatalog.Models.QuotationStatus.Quoted:

                                                <span class="admin-badge admin-badge-primary">

                                                    <i class="bi bi-file-earmark-check"></i>

                                                    تم تقديم العرض

                                                </span>

                                                break;

                                            case ManholeCatalog.Models.QuotationStatus.Closed:

                                                <span class="admin-badge admin-badge-neutral">

                                                    <i class="bi bi-check-circle"></i>

                                                    مغلقة

                                                </span>

                                                break;

                                            default:

                                                <span class="admin-badge admin-badge-neutral">
                                                    غير معروفة
                                                </span>

                                                break;
                                        }

                                    </td>


                                    <!-- Created -->
                                    <td>

                                        <div class="quotation-date">

                                            <div class="text-nowrap">
                                                @request.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                            </div>

                                            <div class="small text-muted text-nowrap">
                                                @request.CreatedAt.ToLocalTime().ToString("hh:mm tt")
                                            </div>

                                        </div>

                                    </td>


                                    <!-- Action -->
                                    <td class="text-end pe-4">

                                        <a asp-area="Admin"
                                           asp-controller="Quotations"
                                           asp-action="Details"
                                           asp-route-id="@request.Id"
                                           class="admin-btn admin-btn-secondary admin-btn-sm quotation-view-button">

                                            <i class="bi bi-eye"></i>
                                            <span>عرض</span>

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/quotations-index.css"
          asp-append-version="true" />
}