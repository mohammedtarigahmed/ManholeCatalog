@model IEnumerable<ManholeCatalog.Models.QuotationRequest>

@{
    ViewData["Title"] = "Quotation Requests";

    var requests = Model.ToList();

    var totalRequests = requests.Count;
    var pendingRequests = requests.Count(r => r.Status == ManholeCatalog.Models.QuotationStatus.Pending);
    var contactedRequests = requests.Count(r => r.Status == ManholeCatalog.Models.QuotationStatus.Contacted);
    var quotedRequests = requests.Count(r => r.Status == ManholeCatalog.Models.QuotationStatus.Quoted);
    var closedRequests = requests.Count(r => r.Status == ManholeCatalog.Models.QuotationStatus.Closed);
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">
            Quotation Requests
        </h1>

        <p class="text-muted mb-0">
            Manage and track customer quotation requests.
        </p>
    </div>
</div>

<!-- Statistics -->
<div class="row g-3 mb-4">

    <div class="col-md-6 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small mb-2">
                    Total Requests
                </div>

                <div class="fs-3 fw-bold">
                    @totalRequests
                </div>

                <div class="small text-muted mt-2">
                    All quotation requests
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small mb-2">
                    Pending
                </div>

                <div class="fs-3 fw-bold text-warning">
                    @pendingRequests
                </div>

                <div class="small text-muted mt-2">
                    Awaiting follow-up
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small mb-2">
                    Contacted
                </div>

                <div class="fs-3 fw-bold text-info">
                    @contactedRequests
                </div>

                <div class="small text-muted mt-2">
                    Customer contacted
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small mb-2">
                    Quoted
                </div>

                <div class="fs-3 fw-bold text-primary">
                    @quotedRequests
                </div>

                <div class="small text-muted mt-2">
                    Quotation provided
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small mb-2">
                    Closed
                </div>

                <div class="fs-3 fw-bold text-secondary">
                    @closedRequests
                </div>

                <div class="small text-muted mt-2">
                    Completed requests
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Search & Filters -->
<div class="card border-0 shadow-sm mb-4">

    <div class="card-header bg-white py-3">
        <h2 class="h6 fw-bold mb-0">
            Search &amp; Filter
        </h2>
    </div>

    <div class="card-body">

        <form asp-area="Admin"
              asp-controller="Quotations"
              asp-action="Index"
              method="get">

            <div class="row g-3">

                <div class="col-lg-7">
                    <label for="search"
                           class="form-label fw-semibold">
                        Search Requests
                    </label>

                    <input type="text"
                           id="search"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Name, company, email, phone, or product..." />

                    <div class="form-text">
                        Search across customer and product information.
                    </div>
                </div>

                <div class="col-lg-3">
                    <label for="status"
                           class="form-label fw-semibold">
                        Status
                    </label>

                    <select id="status"
                            name="status"
                            class="form-select">

                        <option value="">
                            All Statuses
                        </option>

                        @if (ViewBag.Status == ManholeCatalog.Models.QuotationStatus.Pending)
                        {
                            <option value="Pending" selected>Pending</option>
                        }
                        else
                        {
                            <option value="Pending">Pending</option>
                        }

                        @if (ViewBag.Status == ManholeCatalog.Models.QuotationStatus.Contacted)
                        {
                            <option value="Contacted" selected>Contacted</option>
                        }
                        else
                        {
                            <option value="Contacted">Contacted</option>
                        }

                        @if (ViewBag.Status == ManholeCatalog.Models.QuotationStatus.Quoted)
                        {
                            <option value="Quoted" selected>Quoted</option>
                        }
                        else
                        {
                            <option value="Quoted">Quoted</option>
                        }

                        @if (ViewBag.Status == ManholeCatalog.Models.QuotationStatus.Closed)
                        {
                            <option value="Closed" selected>Closed</option>
                        }
                        else
                        {
                            <option value="Closed">Closed</option>
                        }

                    </select>

                    <div class="form-text">
                        Filter by request status.
                    </div>
                </div>

                <div class="col-lg-2">
                    <div class="form-label fw-semibold invisible">
                        Actions
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit"
                                class="btn btn-primary flex-grow-1">
                            Search
                        </button>

                        <a asp-area="Admin"
                           asp-controller="Quotations"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Reset
                        </a>
                    </div>
                </div>

            </div>

        </form>

    </div>

</div>

@if (!requests.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">

            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light border mb-3"
                 style="width: 64px; height: 64px;">
                <span class="text-muted fw-bold fs-5">
                    Q
                </span>
            </div>

            <h2 class="h5 fw-bold mb-2">
                No Quotation Requests Found
            </h2>

            <p class="text-muted mb-0">
                There are no quotation requests matching your current search or filter.
            </p>

        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">

                <div>
                    <h2 class="h5 fw-bold mb-1">
                        Request List
                    </h2>

                    <div class="small text-muted">
                        @totalRequests request(s) shown
                    </div>
                </div>

                @if (pendingRequests > 0)
                {
                    <span class="badge text-bg-warning">
                        @pendingRequests pending request(s)
                    </span>
                }

            </div>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">
                                Request
                            </th>

                            <th>
                                Product
                            </th>

                            <th>
                                Customer
                            </th>

                            <th>
                                Qty
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Submitted
                            </th>

                            <th class="text-end pe-4">
                                Action
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var request in requests)
                        {
                            <tr>

                                <!-- Request -->
                                <td class="ps-4">

                                    <div class="fw-semibold">
                                        #@request.Id
                                    </div>

                                    <div class="small text-muted">
                                        Quotation Request
                                    </div>

                                </td>

                                <!-- Product -->
                                <td>

                                    @if (request.Product != null)
                                    {
                                        <div class="fw-semibold">
                                            @request.Product.Name
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(request.Product.SKU))
                                        {
                                            <div class="small text-muted">
                                                SKU: @request.Product.SKU
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Unknown Product
                                        </span>
                                    }

                                </td>

                                <!-- Customer -->
                                <td>

                                    <div class="fw-semibold">
                                        @request.FullName
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(request.CompanyName))
                                    {
                                        <div class="small text-muted">
                                            @request.CompanyName
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="small text-muted">
                                            @request.Email
                                        </div>
                                    }

                                </td>

                                <!-- Quantity -->
                                <td>

                                    <span class="badge text-bg-light border">
                                        @request.Quantity
                                    </span>

                                </td>

                                <!-- Status -->
                                <td>

                                    @switch (request.Status)
                                    {
                                        case ManholeCatalog.Models.QuotationStatus.Pending:
                                            <span class="badge text-bg-warning">
                                                Pending
                                            </span>
                                            break;

                                        case ManholeCatalog.Models.QuotationStatus.Contacted:
                                            <span class="badge text-bg-info">
                                                Contacted
                                            </span>
                                            break;

                                        case ManholeCatalog.Models.QuotationStatus.Quoted:
                                            <span class="badge text-bg-primary">
                                                Quoted
                                            </span>
                                            break;

                                        case ManholeCatalog.Models.QuotationStatus.Closed:
                                            <span class="badge text-bg-secondary">
                                                Closed
                                            </span>
                                            break;

                                        default:
                                            <span class="badge text-bg-light border">
                                                Unknown
                                            </span>
                                            break;
                                    }

                                </td>

                                <!-- Submitted -->
                                <td>

                                    <div class="text-nowrap">
                                        @request.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </div>

                                    <div class="small text-muted text-nowrap">
                                        @request.CreatedAt.ToLocalTime().ToString("hh:mm tt")
                                    </div>

                                </td>

                                <!-- Action -->
                                <td class="text-end pe-4">

                                    <a asp-area="Admin"
                                       asp-controller="Quotations"
                                       asp-action="Details"
                                       asp-route-id="@request.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
}