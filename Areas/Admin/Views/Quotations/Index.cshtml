@model IEnumerable<ManholeCatalog.Models.QuotationRequest>

@{
    ViewData["Title"] = "طلبات عروض الأسعار";

    var requests = Model.ToList();

    var totalRequests = requests.Count;
    var pendingRequests = requests.Count(r => r.Status == ManholeCatalog.Models.QuotationStatus.Pending);
    var contactedRequests = requests.Count(r => r.Status == ManholeCatalog.Models.QuotationStatus.Contacted);
    var quotedRequests = requests.Count(r => r.Status == ManholeCatalog.Models.QuotationStatus.Quoted);
    var closedRequests = requests.Count(r => r.Status == ManholeCatalog.Models.QuotationStatus.Closed);
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

    <div>

        <h1 class="h3 fw-bold mb-1">
            طلبات عروض الأسعار
        </h1>

        <p class="text-muted mb-0">
            إدارة ومتابعة طلبات عروض الأسعار من العملاء.
        </p>

    </div>

</div>

<!-- الإحصائيات -->
<div class="row g-3 mb-4">

    <div class="col-md-6 col-xl">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <div class="text-muted small mb-2">
                    إجمالي الطلبات
                </div>

                <div class="fs-3 fw-bold">
                    @totalRequests
                </div>

                <div class="small text-muted mt-2">
                    جميع طلبات عروض الأسعار
                </div>

            </div>

        </div>

    </div>

    <div class="col-md-6 col-xl">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <div class="text-muted small mb-2">
                    قيد الانتظار
                </div>

                <div class="fs-3 fw-bold text-warning">
                    @pendingRequests
                </div>

                <div class="small text-muted mt-2">
                    بانتظار المتابعة
                </div>

            </div>

        </div>

    </div>

    <div class="col-md-6 col-xl">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <div class="text-muted small mb-2">
                    تم التواصل
                </div>

                <div class="fs-3 fw-bold text-info">
                    @contactedRequests
                </div>

                <div class="small text-muted mt-2">
                    تم التواصل مع العميل
                </div>

            </div>

        </div>

    </div>

    <div class="col-md-6 col-xl">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <div class="text-muted small mb-2">
                    تم تقديم العرض
                </div>

                <div class="fs-3 fw-bold text-primary">
                    @quotedRequests
                </div>

                <div class="small text-muted mt-2">
                    تم تقديم عرض سعر
                </div>

            </div>

        </div>

    </div>

    <div class="col-md-6 col-xl">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <div class="text-muted small mb-2">
                    مغلقة
                </div>

                <div class="fs-3 fw-bold text-secondary">
                    @closedRequests
                </div>

                <div class="small text-muted mt-2">
                    الطلبات المكتملة
                </div>

            </div>

        </div>

    </div>

</div>

<!-- البحث والتصفية -->
<div class="card border-0 shadow-sm mb-4">

    <div class="card-header bg-white py-3">

        <h2 class="h6 fw-bold mb-0">
            البحث والتصفية
        </h2>

    </div>

    <div class="card-body">

        <form asp-area="Admin"
              asp-controller="Quotations"
              asp-action="Index"
              method="get">

            <div class="row g-3">

                <div class="col-lg-7">

                    <label for="search"
                           class="form-label fw-semibold">
                        البحث في الطلبات
                    </label>

                    <input type="text"
                           id="search"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="الاسم، الشركة، البريد الإلكتروني، الهاتف، أو المنتج..." />

                    <div class="form-text">
                        البحث في بيانات العميل والمنتج.
                    </div>

                </div>

                <div class="col-lg-3">

                    <label for="status"
                           class="form-label fw-semibold">
                        الحالة
                    </label>

                    <select id="status"
                            name="status"
                            class="form-select">

                        <option value="">
                            جميع الحالات
                        </option>

                        @if (ViewBag.Status == ManholeCatalog.Models.QuotationStatus.Pending)
                        {
                            <option value="Pending" selected>قيد الانتظار</option>
                        }
                        else
                        {
                            <option value="Pending">قيد الانتظار</option>
                        }

                        @if (ViewBag.Status == ManholeCatalog.Models.QuotationStatus.Contacted)
                        {
                            <option value="Contacted" selected>تم التواصل</option>
                        }
                        else
                        {
                            <option value="Contacted">تم التواصل</option>
                        }

                        @if (ViewBag.Status == ManholeCatalog.Models.QuotationStatus.Quoted)
                        {
                            <option value="Quoted" selected>تم تقديم العرض</option>
                        }
                        else
                        {
                            <option value="Quoted">تم تقديم العرض</option>
                        }

                        @if (ViewBag.Status == ManholeCatalog.Models.QuotationStatus.Closed)
                        {
                            <option value="Closed" selected>مغلقة</option>
                        }
                        else
                        {
                            <option value="Closed">مغلقة</option>
                        }

                    </select>

                    <div class="form-text">
                        تصفية الطلبات حسب الحالة.
                    </div>

                </div>

                <div class="col-lg-2">

                    <div class="form-label fw-semibold invisible">
                        الإجراءات
                    </div>

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary flex-grow-1">
                            بحث
                        </button>

                        <a asp-area="Admin"
                           asp-controller="Quotations"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            إعادة ضبط
                        </a>

                    </div>

                </div>

            </div>

        </form>

    </div>

</div>

@if (!requests.Any())
{
    <div class="card border-0 shadow-sm">

        <div class="card-body text-center py-5">

            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light border mb-3"
                 style="width: 64px; height: 64px;">

                <span class="text-muted fw-bold fs-5">
                    Q
                </span>

            </div>

            <h2 class="h5 fw-bold mb-2">
                لا توجد طلبات عروض أسعار
            </h2>

            <p class="text-muted mb-0">
                لا توجد طلبات عروض أسعار تطابق البحث أو التصفية الحالية.
            </p>

        </div>

    </div>
}
else
{
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">

                <div>

                    <h2 class="h5 fw-bold mb-1">
                        قائمة الطلبات
                    </h2>

                    <div class="small text-muted">
                        عرض @totalRequests طلب
                    </div>

                </div>

                @if (pendingRequests > 0)
                {
                    <span class="badge text-bg-warning">
                        @pendingRequests طلب قيد الانتظار
                    </span>
                }

            </div>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-4">
                                الطلب
                            </th>

                            <th>
                                المنتج
                            </th>

                            <th>
                                العميل
                            </th>

                            <th>
                                الكمية
                            </th>

                            <th>
                                الحالة
                            </th>

                            <th>
                                تاريخ الطلب
                            </th>

                            <th class="text-end pe-4">
                                الإجراء
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var request in requests)
                        {
                            <tr>

                                <!-- الطلب -->
                                <td class="ps-4">

                                    <div class="fw-semibold">
                                        #@request.Id
                                    </div>

                                    <div class="small text-muted">
                                        طلب عرض سعر
                                    </div>

                                </td>

                                <!-- المنتج -->
                                <td>

                                    @if (request.Product != null)
                                    {
                                        <div class="fw-semibold">
                                            @request.Product.Name
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(request.Product.SKU))
                                        {
                                            <div class="small text-muted">
                                                SKU: @request.Product.SKU
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            منتج غير معروف
                                        </span>
                                    }

                                </td>

                                <!-- العميل -->
                                <td>

                                    <div class="fw-semibold">
                                        @request.FullName
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(request.CompanyName))
                                    {
                                        <div class="small text-muted">
                                            @request.CompanyName
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="small text-muted">
                                            @request.Email
                                        </div>
                                    }

                                </td>

                                <!-- الكمية -->
                                <td>

                                    <span class="badge text-bg-light border">
                                        @request.Quantity
                                    </span>

                                </td>

                                <!-- الحالة -->
                                <td>

                                    @switch (request.Status)
                                    {
                                        case ManholeCatalog.Models.QuotationStatus.Pending:
                                            <span class="badge text-bg-warning">
                                                قيد الانتظار
                                            </span>
                                            break;

                                        case ManholeCatalog.Models.QuotationStatus.Contacted:
                                            <span class="badge text-bg-info">
                                                تم التواصل
                                            </span>
                                            break;

                                        case ManholeCatalog.Models.QuotationStatus.Quoted:
                                            <span class="badge text-bg-primary">
                                                تم تقديم العرض
                                            </span>
                                            break;

                                        case ManholeCatalog.Models.QuotationStatus.Closed:
                                            <span class="badge text-bg-secondary">
                                                مغلقة
                                            </span>
                                            break;

                                        default:
                                            <span class="badge text-bg-light border">
                                                غير معروفة
                                            </span>
                                            break;
                                    }

                                </td>

                                <!-- تاريخ الطلب -->
                                <td>

                                    <div class="text-nowrap">
                                        @request.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </div>

                                    <div class="small text-muted text-nowrap">
                                        @request.CreatedAt.ToLocalTime().ToString("hh:mm tt")
                                    </div>

                                </td>

                                <!-- الإجراء -->
                                <td class="text-end pe-4">

                                    <a asp-area="Admin"
                                       asp-controller="Quotations"
                                       asp-action="Details"
                                       asp-route-id="@request.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        عرض
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
}