@model IEnumerable<ManholeCatalog.Models.ContactMessage>

@{
    ViewData["Title"] = "رسائل التواصل";

    var messages = Model.ToList();
    var totalMessages = messages.Count;
    var unreadMessages = messages.Count(m => !m.IsRead);
    var readMessages = messages.Count(m => m.IsRead);
}

<div class="admin-page">

    <div class="admin-page-header">

        <div class="admin-page-header-row">

            <div class="admin-page-header-main">

                <div class="admin-page-header-eyebrow">
                    <i class="bi bi-envelope"></i>
                    إدارة التواصل
                </div>

                <h1 class="admin-page-header-title">
                    رسائل التواصل
                </h1>

                <p class="admin-page-header-description">
                    إدارة الرسائل الواردة من نموذج التواصل.
                </p>

            </div>

            <div class="admin-page-header-actions">

                <span class="admin-badge admin-badge-primary">
                    <i class="bi bi-envelope"></i>
                    @totalMessages رسالة
                </span>

            </div>

        </div>

    </div>


    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="admin-alert admin-alert-success"
             role="alert">

            <i class="bi bi-check-circle"></i>

            <div>
                @successMessage
            </div>

        </div>
    }


    <div class="admin-stats-grid mb-4">

        <div class="admin-stat-card">

            <div class="admin-stat-card-top">

                <div class="admin-stat-label">
                    إجمالي الرسائل
                </div>

                <div class="admin-stat-icon admin-stat-icon-primary">
                    <i class="bi bi-envelope"></i>
                </div>

            </div>

            <div class="admin-stat-value">
                @totalMessages
            </div>

            <div class="admin-stat-note">
                جميع الرسائل الواردة
            </div>

        </div>


        <div class="admin-stat-card">

            <div class="admin-stat-card-top">

                <div class="admin-stat-label">
                    الرسائل الجديدة
                </div>

                <div class="admin-stat-icon admin-stat-icon-warning">
                    <i class="bi bi-envelope-fill"></i>
                </div>

            </div>

            <div class="admin-stat-value">
                @unreadMessages
            </div>

            <div class="admin-stat-note">
                تحتاج إلى المراجعة
            </div>

        </div>


        <div class="admin-stat-card">

            <div class="admin-stat-card-top">

                <div class="admin-stat-label">
                    الرسائل المقروءة
                </div>

                <div class="admin-stat-icon admin-stat-icon-secondary">
                    <i class="bi bi-envelope-open"></i>
                </div>

            </div>

            <div class="admin-stat-value">
                @readMessages
            </div>

            <div class="admin-stat-note">
                تمت مراجعتها
            </div>

        </div>

    </div>


    <div class="admin-card">

        <div class="admin-card-header">

            <div class="admin-card-header-row">

                <div class="admin-card-header-content">

                    <div class="admin-card-icon">
                        <i class="bi bi-inbox"></i>
                    </div>

                    <div>

                        <h2 class="admin-card-title">
                            قائمة الرسائل
                        </h2>

                        <p class="admin-card-description">
                            مرتبة من الأحدث إلى الأقدم.
                        </p>

                    </div>

                </div>

            </div>

        </div>


        <div class="admin-card-body p-0">

            @if (!messages.Any())
            {
                <div class="admin-empty-state contact-messages-empty-state">

                    <div class="admin-empty-icon">
                        <i class="bi bi-envelope-open"></i>
                    </div>

                    <div class="admin-empty-title">
                        لا توجد رسائل حتى الآن
                    </div>

                    <div class="admin-empty-description">
                        ستظهر رسائل العملاء هنا عند إرسال نموذج التواصل.
                    </div>

                </div>
            }
            else
            {
                <div class="admin-table-wrapper">

                    <table class="table admin-table contact-messages-table align-middle mb-0">

                        <thead>

                            <tr>

                                <th>
                                    الحالة
                                </th>

                                <th>
                                    الاسم
                                </th>

                                <th>
                                    الشركة
                                </th>

                                <th>
                                    الموضوع
                                </th>

                                <th>
                                    البريد الإلكتروني
                                </th>

                                <th>
                                    تاريخ الإرسال
                                </th>

                                <th>
                                    الإجراءات
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var message in messages)
                            {
                                <tr class="@(message.IsRead ? "" : "contact-message-unread")">

                                    <td>

                                        @if (message.IsRead)
                                        {
                                            <span class="admin-badge admin-badge-neutral">

                                                <i class="bi bi-envelope-open"></i>

                                                مقروءة

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="admin-badge admin-badge-primary">

                                                <i class="bi bi-envelope-fill"></i>

                                                جديدة

                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <div class="admin-table-primary">
                                            @message.Name
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(message.PhoneNumber))
                                        {
                                            <div class="admin-table-secondary">
                                                @message.PhoneNumber
                                            </div>
                                        }

                                    </td>


                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(message.CompanyName))
                                        {
                                            <span class="contact-message-company">
                                                @message.CompanyName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="contact-message-empty">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <div class="admin-table-primary">
                                            @message.Subject
                                        </div>

                                        <div class="contact-message-preview">
                                            @message.Message
                                        </div>

                                    </td>


                                    <td>

                                        <a href="mailto:@message.Email"
                                           class="contact-message-email">

                                            <i class="bi bi-envelope"></i>

                                            <span>
                                                @message.Email
                                            </span>

                                        </a>

                                    </td>


                                    <td>

                                        <div class="contact-message-date">

                                            <span>
                                                @message.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                            </span>

                                            <span class="contact-message-time">
                                                @message.CreatedAt.ToLocalTime().ToString("hh:mm tt")
                                            </span>

                                        </div>

                                    </td>


                                    <td>

                                        <div class="admin-table-actions">

                                            <a asp-action="Details"
                                               asp-route-id="@message.Id"
                                               class="admin-btn admin-btn-secondary admin-btn-sm contact-message-action-button"
                                               title="عرض الرسالة">

                                                <i class="bi bi-eye"></i>

                                                <span class="d-none d-lg-inline">
                                                    عرض
                                                </span>

                                            </a>


                                            <form asp-action="Delete"
                                                  asp-route-id="@message.Id"
                                                  method="post"
                                                  class="contact-message-delete-form"
                                                  onsubmit="return confirm('هل أنت متأكد من حذف هذه الرسالة؟');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="admin-btn admin-btn-outline-danger admin-btn-sm contact-message-action-button"
                                                        title="حذف الرسالة">

                                                    <i class="bi bi-trash"></i>

                                                    <span class="d-none d-lg-inline">
                                                        حذف
                                                    </span>

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/contact-messages.css"
          asp-append-version="true" />
}