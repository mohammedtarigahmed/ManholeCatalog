@model ManholeCatalog.Models.ContactMessage

@{
    ViewData["Title"] = "تفاصيل الرسالة";
}

<div class="admin-page">

    <div class="admin-page-header">

        <div class="admin-page-header-row">

            <div class="admin-page-header-main">

                <div class="admin-page-header-eyebrow">
                    <i class="bi bi-envelope-open"></i>
                    إدارة التواصل
                </div>

                <h1 class="admin-page-header-title">
                    تفاصيل الرسالة
                </h1>

                <p class="admin-page-header-description">
                    عرض تفاصيل الرسالة الواردة من العميل.
                </p>

            </div>

            <div class="admin-page-header-actions">

                <a asp-action="Index"
                   class="admin-btn admin-btn-secondary">

                    <i class="bi bi-arrow-right"></i>

                    <span>العودة للرسائل</span>

                </a>

            </div>

        </div>

    </div>


    <div class="row g-4">

        <!-- Message -->

        <div class="col-lg-8">

            <div class="admin-card">

                <div class="admin-card-header">

                    <div class="admin-card-header-row">

                        <div class="admin-card-header-content">

                            <div class="admin-card-icon">
                                <i class="bi bi-envelope-open"></i>
                            </div>

                            <div>

                                <h2 class="admin-card-title">
                                    @Model.Subject
                                </h2>

                                <p class="admin-card-description">
                                    تم الإرسال في @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy - hh:mm tt")
                                </p>

                            </div>

                        </div>


                        <div>

                            @if (Model.IsRead)
                            {
                                <span class="admin-badge admin-badge-neutral">

                                    <i class="bi bi-envelope-open"></i>

                                    مقروءة

                                </span>
                            }
                            else
                            {
                                <span class="admin-badge admin-badge-primary">

                                    <i class="bi bi-envelope-fill"></i>

                                    جديدة

                                </span>
                            }

                        </div>

                    </div>

                </div>


                <div class="admin-card-body">

                    <div class="contact-message-details-content">

                        <div class="contact-message-details-label">
                            نص الرسالة
                        </div>

                        <div class="contact-message-details-message">
                            @Model.Message
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Sender Information -->

        <div class="col-lg-4">

            <div class="admin-card mb-4">

                <div class="admin-card-header">

                    <div class="admin-card-header-content">

                        <div class="admin-card-icon">
                            <i class="bi bi-person"></i>
                        </div>

                        <div>

                            <h2 class="admin-card-title">
                                بيانات المرسل
                            </h2>

                            <p class="admin-card-description">
                                معلومات العميل المرسل للرسالة.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="admin-card-body">

                    <div class="contact-message-details-info-list">

                        <div class="contact-message-details-info-item">

                            <div class="contact-message-details-info-label">
                                الاسم
                            </div>

                            <div class="contact-message-details-info-value">
                                @Model.Name
                            </div>

                        </div>


                        <div class="contact-message-details-info-item">

                            <div class="contact-message-details-info-label">
                                الشركة
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.CompanyName))
                            {
                                <div class="contact-message-details-info-value">
                                    @Model.CompanyName
                                </div>
                            }
                            else
                            {
                                <div class="contact-message-details-info-empty">
                                    غير محدد
                                </div>
                            }

                        </div>


                        <div class="contact-message-details-info-item">

                            <div class="contact-message-details-info-label">
                                البريد الإلكتروني
                            </div>

                            <a href="mailto:@Model.Email"
                               class="contact-message-details-link">

                                <i class="bi bi-envelope"></i>

                                <span>@Model.Email</span>

                            </a>

                        </div>


                        <div class="contact-message-details-info-item">

                            <div class="contact-message-details-info-label">
                                رقم الهاتف
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
                            {
                                <a href="tel:@Model.PhoneNumber"
                                   class="contact-message-details-link">

                                    <i class="bi bi-telephone"></i>

                                    <span>@Model.PhoneNumber</span>

                                </a>
                            }
                            else
                            {
                                <div class="contact-message-details-info-empty">
                                    غير محدد
                                </div>
                            }

                        </div>

                    </div>

                </div>

            </div>


            <!-- Actions -->

            <div class="admin-card">

                <div class="admin-card-header">

                    <div class="admin-card-header-content">

                        <div class="admin-card-icon">
                            <i class="bi bi-gear"></i>
                        </div>

                        <div>

                            <h2 class="admin-card-title">
                                إجراءات الرسالة
                            </h2>

                            <p class="admin-card-description">
                                إدارة حالة الرسالة والتواصل مع المرسل.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="admin-card-body">

                    @if (Model.IsRead)
                    {
                        <form asp-action="MarkAsUnread"
                              asp-route-id="@Model.Id"
                              method="post"
                              class="contact-message-details-action-form">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="admin-btn admin-btn-secondary admin-btn-block">

                                <i class="bi bi-envelope"></i>

                                <span>تحديد كغير مقروءة</span>

                            </button>

                        </form>
                    }


                    <a href="mailto:@Model.Email?subject=رد: @Uri.EscapeDataString(Model.Subject)"
                       class="admin-btn admin-btn-secondary admin-btn-block contact-message-details-action-button">

                        <i class="bi bi-reply"></i>

                        <span>الرد عبر البريد</span>

                    </a>


                    <form asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="contact-message-details-action-form"
                          onsubmit="return confirm('هل أنت متأكد من حذف هذه الرسالة؟');">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="admin-btn admin-btn-outline-danger admin-btn-block">

                            <i class="bi bi-trash"></i>

                            <span>حذف الرسالة</span>

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/contact-message-details.css"
          asp-append-version="true" />
}