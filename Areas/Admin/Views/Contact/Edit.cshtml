@model ManholeCatalog.Models.ContactPage

@{
    ViewData["Title"] = "تواصل معنا";
}

<div class="admin-page">

    <div class="admin-page-header">

        <div class="admin-page-header-row">

            <div class="admin-page-header-main">

                <div class="admin-page-header-eyebrow">
                    <i class="bi bi-telephone"></i>
                    إدارة الموقع
                </div>

                <h1 class="admin-page-header-title">
                    تواصل معنا
                </h1>

                <p class="admin-page-header-description">
                    إدارة بيانات التواصل ووسائل التواصل الاجتماعي.
                </p>

            </div>

        </div>

    </div>


    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="admin-alert admin-alert-success"
             role="alert">

            <i class="bi bi-check-circle"></i>

            <div>
                @successMessage
            </div>

        </div>
    }


    <form asp-action="Edit"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="admin-alert admin-alert-danger"
             role="alert"></div>


        <div class="row g-4">

            <!-- Contact Information -->

            <div class="col-12">

                <div class="admin-card">

                    <div class="admin-card-header">

                        <div class="admin-card-header-content">

                            <div class="admin-card-icon">
                                <i class="bi bi-telephone"></i>
                            </div>

                            <div>
                                <h2 class="admin-card-title">
                                    بيانات التواصل
                                </h2>

                                <p class="admin-card-description">
                                    معلومات المنشأة ووسائل التواصل الأساسية.
                                </p>
                            </div>

                        </div>

                    </div>


                    <div class="admin-card-body">

                        <div class="row g-4">

                            <div class="col-md-6">

                                <label asp-for="CompanyName"
                                       class="admin-form-label"></label>

                                <input asp-for="CompanyName"
                                       class="form-control admin-form-control"
                                       placeholder="اسم المنشأة" />

                                <span asp-validation-for="CompanyName"
                                      class="admin-form-validation"></span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="Email"
                                       class="admin-form-label"></label>

                                <input asp-for="Email"
                                       type="email"
                                       class="form-control admin-form-control"
                                       placeholder="example@company.com" />

                                <span asp-validation-for="Email"
                                      class="admin-form-validation"></span>

                            </div>


                            <div class="col-md-4">

                                <label asp-for="PhoneNumber"
                                       class="admin-form-label"></label>

                                <input asp-for="PhoneNumber"
                                       type="tel"
                                       class="form-control admin-form-control"
                                       placeholder="+966..." />

                                <span asp-validation-for="PhoneNumber"
                                      class="admin-form-validation"></span>

                            </div>


                            <div class="col-md-4">

                                <label asp-for="MobileNumber"
                                       class="admin-form-label"></label>

                                <input asp-for="MobileNumber"
                                       type="tel"
                                       class="form-control admin-form-control"
                                       placeholder="+966..." />

                                <span asp-validation-for="MobileNumber"
                                      class="admin-form-validation"></span>

                            </div>


                            <div class="col-md-4">

                                <label asp-for="WhatsAppNumber"
                                       class="admin-form-label"></label>

                                <input asp-for="WhatsAppNumber"
                                       type="tel"
                                       class="form-control admin-form-control"
                                       placeholder="+966..." />

                                <span asp-validation-for="WhatsAppNumber"
                                      class="admin-form-validation"></span>

                            </div>


                            <div class="col-12">

                                <label asp-for="Address"
                                       class="admin-form-label"></label>

                                <textarea asp-for="Address"
                                          class="form-control admin-form-control"
                                          rows="3"
                                          placeholder="عنوان المنشأة"></textarea>

                                <span asp-validation-for="Address"
                                      class="admin-form-validation"></span>

                            </div>


                            <div class="col-md-8">

                                <label asp-for="GoogleMapsUrl"
                                       class="admin-form-label"></label>

                                <input asp-for="GoogleMapsUrl"
                                       type="url"
                                       class="form-control admin-form-control"
                                       placeholder="https://maps.google.com/..." />

                                <span asp-validation-for="GoogleMapsUrl"
                                      class="admin-form-validation"></span>

                            </div>


                            <div class="col-md-4">

                                <label asp-for="WorkingHours"
                                       class="admin-form-label"></label>

                                <input asp-for="WorkingHours"
                                       class="form-control admin-form-control"
                                       placeholder="الأحد - الخميس: 8 ص - 5 م" />

                                <span asp-validation-for="WorkingHours"
                                      class="admin-form-validation"></span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Social Media -->

            <div class="col-12">

                <div class="admin-card">

                    <div class="admin-card-header">

                        <div class="admin-card-header-content">

                            <div class="admin-card-icon">
                                <i class="bi bi-share"></i>
                            </div>

                            <div>
                                <h2 class="admin-card-title">
                                    وسائل التواصل الاجتماعي
                                </h2>

                                <p class="admin-card-description">
                                    روابط حسابات المنشأة على منصات التواصل الاجتماعي.
                                </p>
                            </div>

                        </div>

                    </div>


                    <div class="admin-card-body">

                        <div class="row g-4">

                            <div class="col-md-6">

                                <label asp-for="LinkedInUrl"
                                       class="admin-form-label"></label>

                                <input asp-for="LinkedInUrl"
                                       type="url"
                                       class="form-control admin-form-control"
                                       placeholder="https://www.linkedin.com/..." />

                                <span asp-validation-for="LinkedInUrl"
                                      class="admin-form-validation"></span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="FacebookUrl"
                                       class="admin-form-label"></label>

                                <input asp-for="FacebookUrl"
                                       type="url"
                                       class="form-control admin-form-control"
                                       placeholder="https://www.facebook.com/..." />

                                <span asp-validation-for="FacebookUrl"
                                      class="admin-form-validation"></span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="InstagramUrl"
                                       class="admin-form-label"></label>

                                <input asp-for="InstagramUrl"
                                       type="url"
                                       class="form-control admin-form-control"
                                       placeholder="https://www.instagram.com/..." />

                                <span asp-validation-for="InstagramUrl"
                                      class="admin-form-validation"></span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="XUrl"
                                       class="admin-form-label"></label>

                                <input asp-for="XUrl"
                                       type="url"
                                       class="form-control admin-form-control"
                                       placeholder="https://x.com/..." />

                                <span asp-validation-for="XUrl"
                                      class="admin-form-validation"></span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="YouTubeUrl"
                                       class="admin-form-label"></label>

                                <input asp-for="YouTubeUrl"
                                       type="url"
                                       class="form-control admin-form-control"
                                       placeholder="https://www.youtube.com/..." />

                                <span asp-validation-for="YouTubeUrl"
                                      class="admin-form-validation"></span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Save -->

            <div class="col-12">

                <div class="admin-form-actions">

                    <button type="submit"
                            class="admin-btn admin-btn-primary admin-btn-lg">

                        <i class="bi bi-check-lg"></i>

                        <span>حفظ التغييرات</span>

                    </button>

                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}