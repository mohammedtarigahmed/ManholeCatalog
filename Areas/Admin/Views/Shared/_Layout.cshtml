@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - الإدارة - سما كتالوج
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/ManholeCatalog.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    @await RenderSectionAsync("Styles", required: false)

</head>

<body>

    <div class="admin-shell">

        <!-- Mobile Header -->
        <header class="admin-mobile-header">

            <div class="admin-mobile-brand">

                <span class="admin-mobile-brand-icon">
                    <i class="bi bi-grid-1x2-fill"></i>
                </span>

                <span>
                    سما كتالوج
                </span>

            </div>

            <button type="button"
                    class="admin-mobile-toggle"
                    id="adminSidebarToggle"
                    aria-label="فتح القائمة"
                    aria-controls="adminSidebar"
                    aria-expanded="false">

                <i class="bi bi-list"></i>

            </button>

        </header>


        <!-- Sidebar Overlay -->
        <div class="admin-sidebar-overlay"
             id="adminSidebarOverlay">
        </div>


        <!-- Sidebar -->
        <aside class="admin-sidebar"
               id="adminSidebar">

            <!-- Brand -->
            <div class="admin-brand">

                <a asp-area="Admin"
                   asp-controller="Home"
                   asp-action="Index"
                   class="admin-brand-link">

                    <span class="admin-brand-icon">
                        <i class="bi bi-grid-1x2-fill"></i>
                    </span>

                    <span class="admin-brand-content">

                        <span class="admin-brand-title">
                            سما كتالوج
                        </span>

                        <span class="admin-brand-subtitle">
                            لوحة الإدارة
                        </span>

                    </span>

                </a>

            </div>


            <!-- Navigation -->
            <div class="admin-sidebar-content">


                <!-- الإدارة -->
                <div class="admin-nav-group">

                    <div class="admin-section-title">
                        الإدارة
                    </div>

                    <ul class="admin-nav">

                        <li class="admin-nav-item">

                            <a asp-area="Admin"
                               asp-controller="Home"
                               asp-action="Index"
                               class="admin-nav-link @(currentController == "Home" ? "active" : "")">

                                <span class="admin-nav-icon">
                                    <i class="bi bi-speedometer2"></i>
                                </span>

                                <span class="admin-nav-text">
                                    لوحة التحكم
                                </span>

                            </a>

                        </li>


                        <li class="admin-nav-item">

                            <a asp-area="Admin"
                               asp-controller="Products"
                               asp-action="Index"
                               class="admin-nav-link @(currentController == "Products" ? "active" : "")">

                                <span class="admin-nav-icon">
                                    <i class="bi bi-box-seam"></i>
                                </span>

                                <span class="admin-nav-text">
                                    المنتجات
                                </span>

                            </a>

                        </li>


                        <li class="admin-nav-item">

                            <a asp-area="Admin"
                               asp-controller="Categories"
                               asp-action="Index"
                               class="admin-nav-link @(currentController == "Categories" ? "active" : "")">

                                <span class="admin-nav-icon">
                                    <i class="bi bi-tags"></i>
                                </span>

                                <span class="admin-nav-text">
                                    الفئات
                                </span>

                            </a>

                        </li>

                    </ul>

                </div>


                <!-- الطلبات -->
                <div class="admin-nav-group">

                    <div class="admin-section-title">
                        الطلبات
                    </div>

                    <ul class="admin-nav">

                        <li class="admin-nav-item">

                            <a asp-area="Admin"
                               asp-controller="Quotations"
                               asp-action="Index"
                               class="admin-nav-link @(currentController == "Quotations" ? "active" : "")">

                                <span class="admin-nav-icon">
                                    <i class="bi bi-file-earmark-text"></i>
                                </span>

                                <span class="admin-nav-text">
                                    عروض الأسعار
                                </span>

                            </a>

                        </li>


                        <li class="admin-nav-item">

                            <a asp-area="Admin"
                               asp-controller="ContactMessages"
                               asp-action="Index"
                               class="admin-nav-link @(currentController == "ContactMessages" ? "active" : "")">

                                <span class="admin-nav-icon">
                                    <i class="bi bi-envelope"></i>
                                </span>

                                <span class="admin-nav-text">
                                    رسائل التواصل
                                </span>

                            </a>

                        </li>

                    </ul>

                </div>


                <!-- الإعدادات -->
                <div class="admin-nav-group">

                    <div class="admin-section-title">
                        الإعدادات
                    </div>

                    <ul class="admin-nav">

                        <li class="admin-nav-item">

                            <a asp-area="Admin"
                               asp-controller="Contact"
                               asp-action="Edit"
                               class="admin-nav-link @(currentController == "Contact" ? "active" : "")">

                                <span class="admin-nav-icon">
                                    <i class="bi bi-telephone"></i>
                                </span>

                                <span class="admin-nav-text">
                                    تواصل معنا
                                </span>

                            </a>

                        </li>

                    </ul>

                </div>

            </div>


            <!-- Sidebar Footer -->
            <div class="admin-sidebar-footer">

                <div class="admin-user-card">

                    <span class="admin-user-avatar">
                        <i class="bi bi-person"></i>
                    </span>

                    <span class="admin-user-info">

                        <span class="admin-user-label">
                            تسجيل الدخول باسم
                        </span>

                        <span class="admin-user-name">
                            @User.Identity?.Name
                        </span>

                    </span>

                </div>


                <div class="admin-sidebar-actions">

                    <a asp-area=""
                       asp-controller="Catalog"
                       asp-action="Index"
                       class="admin-sidebar-action">

                        <i class="bi bi-shop"></i>

                        <span>
                            عرض الكتالوج
                        </span>

                    </a>


                    <form asp-area=""
                          asp-controller="Account"
                          asp-action="Logout"
                          method="post">

                        <button type="submit"
                                class="admin-sidebar-action admin-sidebar-action-danger">

                            <i class="bi bi-box-arrow-right"></i>

                            <span>
                                تسجيل الخروج
                            </span>

                        </button>

                    </form>

                </div>

            </div>

        </aside>


        <!-- Main -->
        <div class="admin-main">

            <!-- Topbar -->
            <header class="admin-topbar">

                <div class="admin-topbar-inner">

                    <div class="admin-page-heading">

                        <span class="admin-page-heading-label">
                            لوحة الإدارة
                        </span>

                        <h1 class="admin-page-title">
                            @ViewData["Title"]
                        </h1>

                    </div>


                    <div class="admin-topbar-user">

                        <span class="admin-topbar-user-icon">
                            <i class="bi bi-person"></i>
                        </span>

                        <span class="admin-topbar-user-name">
                            @User.Identity?.Name
                        </span>

                    </div>

                </div>

            </header>


            <!-- Content -->
            <main class="admin-content">

                <div class="admin-content-container">

                    @RenderBody()

                </div>

            </main>


            <!-- Footer -->
            <footer class="admin-footer">

                <div class="admin-footer-inner">

                    <div>
                        &copy; @DateTime.Now.Year - سما كتالوج
                    </div>

                    <div>
                        لوحة الإدارة
                    </div>

                </div>

            </footer>

        </div>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>


    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const sidebar = document.getElementById("adminSidebar");
            const toggle = document.getElementById("adminSidebarToggle");
            const overlay = document.getElementById("adminSidebarOverlay");

            if (!sidebar || !toggle || !overlay) {
                return;
            }

            function openSidebar() {

                sidebar.classList.add("show");
                overlay.classList.add("show");
                document.body.classList.add("admin-sidebar-open");

                toggle.setAttribute("aria-expanded", "true");

            }

            function closeSidebar() {

                sidebar.classList.remove("show");
                overlay.classList.remove("show");
                document.body.classList.remove("admin-sidebar-open");

                toggle.setAttribute("aria-expanded", "false");

            }

            toggle.addEventListener("click", function () {

                if (sidebar.classList.contains("show")) {

                    closeSidebar();

                } else {

                    openSidebar();

                }

            });


            overlay.addEventListener("click", function () {

                closeSidebar();

            });


            document.querySelectorAll(".admin-nav-link").forEach(function (link) {

                link.addEventListener("click", function () {

                    if (window.innerWidth <= 991) {

                        closeSidebar();

                    }

                });

            });


            window.addEventListener("resize", function () {

                if (window.innerWidth > 991) {

                    closeSidebar();

                }

            });

        });

    </script>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>